//@version=5
strategy("Stratégie V48 S1 — copie fidèle de la V48 CLEAN", shorttitle="Stratégie V48 S1", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=300, initial_capital=10000, commission_type=strategy.commission.cash_per_contract, commission_value=0.15, slippage=0, process_orders_on_close=true, pyramiding=0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PARAMÈTRES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupMain = "1. Réglages principaux"
pivotLen = input.int(30, "Force pivot M5", minval=3, group=groupMain)
rr = input.float(3.2, "Risk Reward", step=0.1, group=groupMain)
atrLen = input.int(14, "ATR", group=groupMain)
atrBuffer = input.float(0.65, "Buffer SL ATR", step=0.05, group=groupMain)
minStopAtr = input.float(1.10, "Stop min ATR", step=0.05, group=groupMain)
cooldownBars = input.int(8, "Cooldown", minval=1, group=groupMain)
conservativeMode = input.bool(true, "TP et SL même bougie = SL", group=groupMain)
groupH1Filter = "9. Filtre H1 pour M5"
h1M5FilterMode = input.string("Strict", "Filtre H1 pour signaux M5", options=["OFF", "Souple", "Strict"], group=groupH1Filter)
m5AlignMemoryBars = input.int(12, "Mémoire M5 ALIGN", minval=1, maxval=50, group=groupH1Filter)
zoneRiskMemoryBars = input.int(10, "Mémoire ZONE RISK", minval=1, maxval=50, group=groupH1Filter)
fireMemoryBars = input.int(12, "Mémoire FEU ICT Pullback", minval=1, maxval=50, group=groupH1Filter)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// H1 NARRATIVE FILTER V4.12B-18
// Contexte H1 intelligent pour guider le M5
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupH1Narrative = "11. H1 Narrative Filter"

useH1Narrative = input.bool(true, "Activer H1 Narrative Filter", group=groupH1Narrative)
h1NarrativeMode = input.string("Lecture seule", "Mode H1 Narrative", options=["Lecture seule", "Filtre souple", "Filtre strict"], group=groupH1Narrative)
showH1NarrativeDashboard = input.bool(true, "Afficher H1 Narrative dans dashboard", group=groupH1Narrative)
groupSession = "2. Session"
useSession = input.bool(true, "Filtrer session", group=groupSession)
sessionInput = input.session("0830-2030", "Session Paris", group=groupSession)

groupPA = "3. Bougies de retournement"
useEngulf = input.bool(true, "Englobantes", group=groupPA)
usePin = input.bool(false, "Pinbar / Hammer / Shooting", group=groupPA)
useStars = input.bool(true, "Morning / Evening Star", group=groupPA)

groupZones = "4. OB / FVG"
showFVG = input.bool(true, "Afficher FVG", group=groupZones)
showOB = input.bool(true, "Afficher OB", group=groupZones)
requireZone = input.bool(true, "Exiger OB/FVG pour signal", group=groupZones)
showOteStar = input.bool(true, "Afficher étoile OTE sur OB/FVG", group=groupZones)
oteLowRatio = input.float(0.63, "OTE bas", step=0.01, group=groupZones)
oteHighRatio = input.float(0.79, "OTE haut", step=0.01, group=groupZones)
fvgAtr = input.float(0.80, "Force FVG ATR", step=0.05, group=groupZones)
obAtr = input.float(0.80, "Force OB ATR", step=0.05, group=groupZones)
maxZones = input.int(15, "Max zones gardées", minval=5, group=groupZones)
deleteMitigated = input.bool(true, "Supprimer zones mitigées", group=groupZones)
deleteMitigatedOB = input.bool(true, "Supprimer OB mitigées", group=groupZones)
useCloseMitigation = input.bool(true, "Mitigation sur clôture uniquement", group=groupZones)
fvgMitigationMode = input.string("Cloture", "Mitigation FVG dynamique", options=["Meche", "Corps", "Cloture"], group=groupZones)
shrinkPartialFVG = input.bool(true, "Réduire FVG partiellement comblée", group=groupZones)

groupMTF = "5. Contexte H4 / H1"
h4Tf = input.timeframe("240", "Timeframe H4", group=groupMTF)
h1Tf = input.timeframe("60", "Timeframe H1", group=groupMTF)
emaFastLen = input.int(50, "EMA rapide HTF", group=groupMTF)
emaSlowLen = input.int(200, "EMA lente HTF", group=groupMTF)
pdLookbackHTF = input.int(100, "Lookback P/D H4-H1", group=groupMTF)
pdLookbackLocal = input.int(120, "Lookback P/D TF actuelle", minval=20, group=groupMTF)

groupVisual = "6. Visuel"
showStructure = input.bool(true, "Afficher HH/HL/LH/LL", group=groupVisual)
showBos = input.bool(true, "Afficher BOS/CHoCH", group=groupVisual)
showLiqLite = input.bool(true, "Afficher BSL/SSL Lite", group=groupVisual)
showLiqTakenMarks = input.bool(true, "Marquer liquidité prise", group=groupVisual)
showEqhEqlLite = input.bool(true, "Afficher EQH/EQL Lite", group=groupVisual)
liqEqToleranceAtr = input.float(0.25, "Tolérance EQH/EQL ATR", step=0.05, group=groupVisual)
liqVisualMode = input.string("Majeur + EQH/EQL", "Mode liquidité visuelle", options=["Swing + EQH/EQL", "Majeur + EQH/EQL", "EQH/EQL seulement"], group=groupVisual)
liqMajorAtr = input.float(1.50, "Swing majeur min ATR", step=0.10, group=groupVisual)
liqMajorLookback = input.int(40, "Lookback swing majeur", minval=10, maxval=200, group=groupVisual)
showHtfLiqMarks = input.bool(true, "Afficher marqueurs liquidité HTF", group=groupVisual)
htfLiqMarkSize = input.string("Small", "Taille marqueurs HTF", options=["Tiny", "Small", "Normal"], group=groupVisual)
showPostChochBos = input.bool(true, "Afficher BOS post-CHoCH", group=groupVisual)
showFastMss = input.bool(true, "Afficher MSS rapide", group=groupVisual)
fastMssLen = input.int(8, "Force MSS rapide", minval=2, maxval=20, group=groupVisual)
fastMssUseClose = input.bool(false, "MSS rapide sur clôture", group=groupVisual)
showSignals = input.bool(true, "Afficher labels BUY/SELL", group=groupVisual)
labelFilterMode = input.string("Tous", "Filtre visuel labels", options=["Tous", "ICT SYNC OK", "Masquer"], group=groupVisual)
showSLTP = input.bool(true, "Afficher SL/TP", group=groupVisual)
showResults = input.bool(false, "Afficher WIN/LOSS", group=groupVisual)
showDashboard = input.bool(true, "Dashboard principal", group=groupVisual)
dashboardMode = input.string("SIMPLE", "Mode Dashboard", options=["SIMPLE", "COMPLET"], group=groupVisual)
dashPosition = input.string("Top Right", "Position dashboard principal", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupVisual)
groupTradeFilter = "7. Trade Autorisé / No Trade"
showTradePermission = input.bool(true, "Afficher Trade Autorisé / No Trade", group=groupTradeFilter)
blockMixedContext = input.bool(true, "No Trade si contexte mixte", group=groupTradeFilter)
blockDangerZone = input.bool(true, "No Trade si zone danger", group=groupTradeFilter)
blockWaitExecution = input.bool(true, "No Trade si exécution WAIT", group=groupTradeFilter)
blockCounterHtf = input.bool(true, "No Trade si contre HTF", group=groupTradeFilter)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GRADE ICT ★ / ★★ / ★★★
// Affichage seulement au départ - ne bloque aucun signal
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupIctGrade = "8. Grade ICT ★"

showIctGrade = input.bool(true, "Afficher Grade ICT", group=groupIctGrade)
ictGradeMode = input.string("Affichage seulement", "Mode Grade ICT", options=["Affichage seulement", "Influence Prudence", "Influence GO"], group=groupIctGrade)
showStarsOnLabels = input.bool(true, "Afficher étoiles sur labels", group=groupIctGrade)
showGradeInDashboard = input.bool(true, "Afficher Grade dans dashboard", group=groupIctGrade)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LABEL ↔ ENTRY BRIDGE V4.12B-12
// Synchronise les labels / Sync / Joker avec les entrées simulées
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupBridge = "10. Label ↔ Entry Bridge"

useEntryBridge = input.bool(true, "Activer Label ↔ Entry Bridge", group=groupBridge)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SMART RECOVERY SETUPS V4.12B-20
// Récupère les setups ICT propres manqués par le moteur principal
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupRecovery = "12. Smart Recovery Setups"

useSmartRecovery = input.bool(true, "Activer Smart Recovery", group=groupRecovery)

recoveryMode = input.string(
     "Normal",
     "Mode Recovery",
     options=["Prudent", "Normal", "Agressif"],
     group=groupRecovery)

showRecoveryLabels = input.bool(false, "Afficher labels Recovery", group=groupRecovery)

recoveryMemoryBars = input.int(18, "Mémoire Recovery", minval=5, maxval=80, group=groupRecovery)

recoveryNeedSweep = input.bool(true, "Recovery exige sweep récent", group=groupRecovery)

recoveryNeedZone = input.bool(true, "Recovery exige OB/FVG", group=groupRecovery)

recoveryNeedReaction = input.bool(true, "Recovery exige réaction bougie", group=groupRecovery)

recoveryAllowH1Counter = input.bool(true, "Autoriser Recovery contre H1 en zone extrême", group=groupRecovery)

recoveryMinScore = input.int(4, "Score minimum Recovery", minval=2, maxval=7, group=groupRecovery)

recoveryCooldownBars = input.int(8, "Cooldown Recovery", minval=1, maxval=50, group=groupRecovery)

entryBridgeMode = input.string(
     "ICT Simple",
     "Mode Bridge",
     options=["Signal strict", "Signal + Sync OK", "Signal + Sync/Joker", "Signal + Sync/Pullback", "ICT Simple", "ICT Simple Brut"],
     group=groupBridge)

minBridgeIctScore = input.int(3, "Score ICT minimum Bridge", minval=1, maxval=6, group=groupBridge)

bridgeUseH1Guard = input.bool(true, "Bridge respecte H1 sauf reversal", group=groupBridge)
useAntiBadSellFilter = input.bool(true, "Anti SELL bas de range / proche zone BUY", group=groupBridge)
badSellZoneAtr = input.float(1.20, "Distance max zone BUY pour bloquer SELL ATR", step=0.10, group=groupBridge)
blockSellInDiscount = input.bool(true, "Bloquer SELL en Discount proche zone BUY", group=groupBridge)
ictSimpleZoneProximityAtr = input.float(0.30, "ICT Simple proximité zone ATR", step=0.05, group=groupBridge)
ictSimpleStructureMode = input.string("CHoCH + BOS", "ICT Simple structure", options=["BOS/MSS strict", "CHoCH + BOS"], group=groupBridge)
// Debug ICT Simple
showIctSimpleDebug = input.bool(false, "Afficher Debug ICT Simple", group=groupBridge)
debugOnlyNearZones = input.bool(true, "Debug seulement proche OB/FVG", group=groupBridge)
debugEveryBars = input.int(8, "Espacement Debug labels", minval=1, maxval=50, group=groupBridge)
debugMaxLabels = input.int(60, "Nombre max labels Debug", minval=10, maxval=200, group=groupBridge)
useIctRangeEdge = input.bool(false, "Activer ICT Range Edge", group=groupBridge)
rangeEdgeLimit = input.float(0.30, "ICT Range Edge extrême range", step=0.05, minval=0.10, maxval=0.50, group=groupBridge)
rangeEdgeNeedTarget = input.bool(true, "Range Edge exige zone opposée cible", group=groupBridge)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SELL TREND+ V4.12B-21 — PARAMÈTRES NEUTRALISÉS
// Inputs retirés du panneau TradingView.
// Variables conservées pour éviter les dépendances cassées.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupSellTrendPlus = "13. SELL TREND+"

useSellTrendPlus = false
showSellTrendPlusLabels = false

sellTrendPlusCooldown = 10
sellTrendPlusNeedBsl = false
sellTrendPlusBlockNearBuyZone = true
sellTrendPlusMinSpaceAtr = 0.80
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY EXP+ V4.12B-22
// Observation des BUY d'expansion : MSS/BOS + displacement + FVG/OB
// Ne modifie pas le backtest
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupBuyExpPlus = "14. BUY EXP+"

useBuyExpPlus = input.bool(true, "Activer BUY EXP+", group=groupBuyExpPlus)
showBuyExpPlusLabels = input.bool(false, "Afficher labels BUY EXP+", group=groupBuyExpPlus)

buyExpPlusCooldown = input.int(10, "Cooldown BUY EXP+", minval=1, maxval=50, group=groupBuyExpPlus)

buyExpLookback = input.int(20, "Mémoire BUY EXP+", minval=5, maxval=80, group=groupBuyExpPlus)
buyExpStructMemoryBars = input.int(8, "Mémoire structure BUY EXP+", minval=2, maxval=30, group=groupBuyExpPlus)

buyExpNeedFvg = input.bool(true, "Exiger FVG BUY récent", group=groupBuyExpPlus)

buyExpAllowH1Counter = input.bool(true, "Autoriser contre H1 si expansion M5 forte", group=groupBuyExpPlus)

buyExpBlockNearSellZone = input.bool(false, "Bloquer si zone SELL trop proche au-dessus", group=groupBuyExpPlus)

buyExpMinSpaceToSellAtr = input.float(0.80, "Espace min vers zone SELL ATR", step=0.10, group=groupBuyExpPlus)
showBuyPrepLabels = input.bool(false, "Afficher labels BUY PREP", group=groupBuyExpPlus)

buyPrepMemoryBars = input.int(24, "Mémoire BUY PREP", minval=5, maxval=100, group=groupBuyExpPlus)

buyPrepCooldownBars = input.int(12, "Cooldown BUY PREP", minval=1, maxval=50, group=groupBuyExpPlus)
showBuyExpDiag = input.bool(false, "Afficher diagnostic BUY EXP", group=groupBuyExpPlus)

buyExpDiagEveryBars = input.int(5, "Espacement diagnostic BUY EXP", minval=1, maxval=30, group=groupBuyExpPlus)

buyExpDiagMaxLabels = input.int(50, "Nombre max diagnostics BUY EXP", minval=10, maxval=150, group=groupBuyExpPlus)

// V45 — Guards BUY EXP+
buyExpBlockRange = input.bool(true, "BUY EXP+ bloque range", group=groupBuyExpPlus)
buyExpWaitAfterTrigger = input.bool(true, "BUY EXP+ attend confirmation après trigger", group=groupBuyExpPlus)
buyExpConfirmMemoryBars = input.int(4, "Mémoire confirmation BUY EXP+", minval=1, maxval=20, group=groupBuyExpPlus)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
