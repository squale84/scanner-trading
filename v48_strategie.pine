// Inputs retirés du panneau TradingView.
// Variables conservées pour éviter les dépendances cassées.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupOteWatch = "20. OTE WATCH"

useOteWatch = false
showOteWatchLabels = false

oteWatchNeedH1 = true
oteWatchNeedLiq = true
oteWatchLiqProximityAtr = 1.00

oteWatchCooldownBars = 12
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WATCH V1 — PARAMÈTRES NEUTRALISÉS
// Inputs retirés du panneau TradingView.
// Variables conservées pour éviter les dépendances cassées.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupWatchV1 = "21. WATCH V1"

useWatchV1 = false
showWatchV1Labels = false

watchV1NeedH1 = false
watchV1CooldownBars = 10
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY MIRROR+ V4.12B-26 — PARAMÈTRES NEUTRALISÉS
// Inputs retirés du panneau TradingView.
// Variables conservées pour éviter les dépendances cassées.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupBuyMirror = "15. BUY MIRROR+"

useBuyMirrorPlus = false
showBuyMirrorPlusLabels = false

buyMirrorCooldownBars = 12
buyMirrorStructMemoryBars = 40
buyMirrorRetestMemoryBars = 12

buyMirrorOnePerStruct = true
buyMirrorRequireRealTouch = true
buyMirrorNeedStrongReaction = true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY PB+ PRO V4.12B-31
// Pullback propre après structure BUY : BOS/CHoCH/MSS → expansion → retour OB/FVG → réaction
// Observation uniquement - ne modifie pas le backtest
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupBuyPbPro = "16. BUY PB+ PRO"

useBuyPbPro = input.bool(true, "Activer BUY PB+ PRO", group=groupBuyPbPro)
showBuyPbProLabels = input.bool(false, "Afficher labels BUY PB+ PRO", group=groupBuyPbPro)

buyPbStructMemoryBars = input.int(35, "Mémoire structure BUY PB+", minval=5, maxval=100, group=groupBuyPbPro)
buyPbRetestMemoryBars = input.int(8, "Mémoire retest BUY PB+", minval=2, maxval=30, group=groupBuyPbPro)
buyPbCooldownBars = input.int(14, "Cooldown BUY PB+", minval=1, maxval=60, group=groupBuyPbPro)

buyPbMinExpansionAtr = input.float(1.00, "Expansion min avant pullback ATR", step=0.10, group=groupBuyPbPro)

buyPbRequireRealTouch = input.bool(true, "Exiger contact réel OB/FVG BUY", group=groupBuyPbPro)
buyPbNeedStrongReaction = input.bool(true, "Exiger réaction forte BUY", group=groupBuyPbPro)
buyPbRequirePostRetestConfirm = input.bool(true, "Exiger confirmation après retest", group=groupBuyPbPro)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY PB+ PRO V4.12B-36 — Deep Pullback Retest
// Attend un vrai retour profond dans OB/FVG avant confirmation
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
buyPbUseDeepRetest = input.bool(true, "Exiger pullback profond BUY PB+", group=groupBuyPbPro)

buyPbMinPullbackDepth = input.float(0.35, "Profondeur min pullback BUY PB+", minval=0.10, maxval=0.90, step=0.05, group=groupBuyPbPro)
buyPbOnePerStruct = input.bool(true, "Un seul BUY PB+ par structure", group=groupBuyPbPro)

buyPbNeedSsl = input.bool(false, "Exiger SSL / sweep bas récent", group=groupBuyPbPro)
buyPbAllowH1Counter = input.bool(true, "Autoriser contre H1 si structure M5 propre", group=groupBuyPbPro)

buyPbBlockNearSellZone = input.bool(true, "Bloquer si zone SELL trop proche", group=groupBuyPbPro)
buyPbMinSpaceToSellAtr = input.float(0.80, "Espace min vers zone SELL ATR", step=0.10, group=groupBuyPbPro)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY PB+ PRO V4.12B-33 — Countertrend Guard
// Durcit les BUY PB+ quand H1 n'est pas clairement acheteur
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
buyPbUseCounterGuard = input.bool(true, "Guard contre-tendance BUY PB+", group=groupBuyPbPro)

buyPbTreatH1NeutralAsCounter = input.bool(true, "H1 neutre = contre-tendance", group=groupBuyPbPro)

buyPbCounterMinExpansionAtr = input.float(1.40, "Expansion min contre-tendance ATR", step=0.10, group=groupBuyPbPro)

buyPbCounterNeedChochBos = input.bool(true, "Contre-tendance exige CHoCH + BOS", group=groupBuyPbPro)

buyPbCounterBlockSellZone = input.bool(true, "Contre-tendance bloque proche zone SELL", group=groupBuyPbPro)

buyPbCounterMinSpaceSellAtr = input.float(1.30, "Espace SELL min contre-tendance ATR", step=0.10, group=groupBuyPbPro)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY PB+ PRO V4.12B-35 — Major Break Guard
// Exige une vraie cassure d'un swing high majeur quand H1 n'est pas clairement BUY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
buyPbUseMajorBreakGuard = input.bool(true, "Guard cassure swing majeur BUY PB+", group=groupBuyPbPro)

buyPbMajorGuardWhenH1NotBull = input.bool(true, "Cassure majeure si H1 non BUY", group=groupBuyPbPro)

buyPbMajorSwingLen = input.int(8, "Pivot swing high majeur BUY PB+", minval=3, maxval=30, group=groupBuyPbPro)

buyPbMajorBreakMemoryBars = input.int(60, "Mémoire cassure majeure BUY PB+", minval=10, maxval=150, group=groupBuyPbPro)

buyPbMajorBreakBufferAtr = input.float(0.10, "Buffer cassure majeure ATR", step=0.05, group=groupBuyPbPro)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
