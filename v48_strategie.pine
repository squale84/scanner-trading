showBuyContDiagLabel = input.bool(false, "Afficher diagnostic BUY CONT dans label", group=groupBuyContEarly)

buyContCooldownBars = input.int(12, "Cooldown BUY CONT", minval=1, maxval=60, group=groupBuyContEarly)

buyContStructMemoryBars = input.int(18, "Mémoire structure BUY CONT", minval=5, maxval=100, group=groupBuyContEarly)
buyContPullbackMemoryBars = input.int(10, "Mémoire pullback BUY CONT", minval=2, maxval=40, group=groupBuyContEarly)

buyContMinImpulseAtr = input.float(2, "Impulsion min BUY CONT ATR", step=0.10, group=groupBuyContEarly)

buyContRequireFvg = input.bool(true, "BUY CONT exige FVG récent", group=groupBuyContEarly)
buyContRequireReclaim = input.bool(false, "BUY CONT exige reclaim après pullback", group=groupBuyContEarly)

buyContRespectSession = input.bool(false, "BUY CONT respecte session", group=groupBuyContEarly)

