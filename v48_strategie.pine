buyContMinPullbackDepth = input.float(0.45, "Profondeur min pullback BUY CONT", minval=0.10, maxval=0.90, step=0.05, group=groupBuyContEarly)
buyContMaxPullbackDepth = input.float(0.65, "Profondeur max pullback BUY CONT", minval=0.30, maxval=1.50, step=0.05, group=groupBuyContEarly)
buyContPullbackDepthMode = input.string("Corps", "Mode profondeur BUY CONT", options=["Meche", "Corps"], group=groupBuyContEarly)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BACKTEST MODULES DEV V39
// Intégration contrôlée des modules observation
// OFF par défaut pour protéger la base PF actuelle
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
