groupBuyRevEarly = "17. BUY REV EARLY"

useBuyRevEarly = false
showBuyRevEarlyLabels = false

buyRevCooldownBars = 12

buyRevStructMemoryBars = 10
buyRevFvgMemoryBars = 8
buyRevSweepLookback = 18

