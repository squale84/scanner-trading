//@version=5
indicator("ICT 2022 Scanner Engine — Radar Terminal Institutional Pro [MTF H1-M5 Refined]", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200, max_bars_back=1000)

// ==========================================
// 1. CONFIGURATION GÉNÉRALE & PARAMÈTRES
// ==========================================
grp_radar     = "Configuration Terminal Radar"
asset_name_in = input.string("", title="Symbole Terminal (vide = auto)", group=grp_radar)
asset_name    = asset_name_in != "" ? asset_name_in : (syminfo.ticker == "XAUUSD" ? "GOLD" : syminfo.ticker)
rr_ratio      = input.float(2.0, title="Ratio Risque / Récompense (TP)", minval=1.0, step=0.5, group=grp_radar)
is_crypto_247 = input.bool(true, title="Mode Métaux / Continu (Ignore Killzones)", group=grp_radar)
min_grade_in  = input.string("A", title="Grade Minimum pour Alerte", options=["B", "A", "A+"], group=grp_radar)
ema_flat_thr  = input.float(0.08, title="Seuil Pente EMA H1 (x ATR)", step=0.01, group=grp_radar)
atr_cap_mult  = input.float(2.5, title="Plafond Stop-Loss (x ATR M5)", minval=0.5, step=0.1, group=grp_radar)
atr_floor_mult = input.float(0.5, title="Plancher Stop-Loss (x ATR M5)", minval=0.1, step=0.1, group=grp_radar)
zone_window_in   = input.int(20, title="Fenêtre de validité contexte H1 (barres M5)", minval=5, maxval=50, group=grp_radar)
cooldown_bars_in = input.int(10, title="Cooldown entre signaux (barres M5)", minval=1, maxval=50, group=grp_radar)

grp_ui        = "Affichage Graphique ICT"
show_fvg      = input.bool(true, title="Afficher FVG H1", group=grp_ui)
show_fvg_m5   = input.bool(false, title="Afficher FVG M5", group=grp_ui)
show_mss      = input.bool(true, title="Afficher CHoCH / BOS", group=grp_ui)
show_ob       = input.bool(true, title="Afficher Order Blocks (M5)", group=grp_ui)
show_eqh_eql  = input.bool(true, title="Afficher EQH / EQL (Liquidité)", group=grp_ui)
show_levels   = input.bool(true, title="Afficher PDH / PDL / NY Midnight", group=grp_ui)
show_risk_zone = input.bool(true, title="Afficher zone SL/TP du trade actif", group=grp_ui)
ob_filter_dp  = input.bool(false, title="N'afficher que les OB en discount/premium", group=grp_ui)
show_ote      = input.bool(false, title="Afficher zone OTE (Fibo 61.8%-79%)", group=grp_ui)
range_lookback = input.int(100, title="Range Discount/Premium (barres M5)", minval=20, maxval=500, group=grp_ui)
fvg_mitigation_mode = input.string("Mèche", title="Mode de mitigation FVG/OB", options=["Mèche", "Corps", "Clôture"], group=grp_ui)
max_zones_in  = input.int(10, title="Nombre max de zones OB/FVG affichées", minval=3, maxval=30, group=grp_ui)

grp_dash      = "Tableau de Bord"
show_dashboard = input.bool(true, title="Afficher le tableau de bord", group=grp_dash)

grp_sessions  = "Sessions ICT (Heure New York UTC-4)"
sess_london   = input.session("0200-0500:23456", title="London Open", group=grp_sessions)
sess_ny       = input.session("0800-1130:23456", title="NY AM", group=grp_sessions)

in_london    = not na(time(timeframe.period, sess_london, "America/New_York"))
in_ny        = not na(time(timeframe.period, sess_ny, "America/New_York"))
trade_window = is_crypto_247 or in_london or in_ny

bgcolor(in_london ? color.new(#00bcd4, 96) : na, title="Bg Londres")
bgcolor(in_ny ? color.new(#ff9800, 96) : na, title="Bg New York")

// ==========================================
// THÈME VISUEL — aligné sur la palette du dashboard HTML (index.html)
// ==========================================
color_lux_bull  = color.new(#00E08A, 0)  // Vert — identique --accent-green
color_lux_bear  = color.new(#FF4569, 0)  // Rouge — identique --accent-red
color_lux_liq   = color.new(#2F6BFF, 0)  // Bleu — identique --accent-blue (EQH/EQL)
color_lux_gold  = color.new(#FFC73C, 0)  // Or — identique --accent-gold (NY Open, FVG H1, grade A+)
color_lux_level = color.new(#8B96A5, 30) // Gris — identique --text-muted (PDH/PDL)
color_panel_bg  = color.new(#0D1117, 8)  // Fond panneau — identique --bg-elevated
color_panel_bd  = color.new(#1C2430, 0)  // Bordure panneau — identique --border-color
color_ob_bull   = color.new(#2F6BFF, 0)  // Bleu — Order Block acheteur
color_ob_bear   = color.new(#FF6EC7, 0)  // Rose — Order Block vendeur

// ==========================================
// 2. EXTRACTION HTF H1 : FVG, BIAIS & BOS
// ==========================================
// Regroupement propre des requêtes de sécurité H1
f_get_h1_data() =>
    h1_atr      = ta.atr(14)
    h1_ema      = ta.ema(close, 50)
    h1_ph       = ta.pivothigh(high, 3, 3)
    h1_pl       = ta.pivotlow(low, 3, 3)
    [high[1], low[1], high[3], low[3], close[1], h1_ema[1], h1_ema[2], h1_atr[1], h1_ph[1], h1_pl[1]]

[h1_high, h1_low, h1_high2, h1_low2, h1_close, h1_ema, h1_ema_prev, h1_atr, h1_ph, h1_pl] = request.security(syminfo.tickerid, "60", f_get_h1_data(), barmerge.gaps_off, barmerge.lookahead_off)

// --- Filtre Anti-Range / Anti-Chop (EMA 50 H1) ---
h1_ema_flat  = math.abs(h1_ema - h1_ema_prev) < (h1_atr * ema_flat_thr)
h1_bias_bull = (h1_close > h1_ema) and not h1_ema_flat
h1_bias_bear = (h1_close < h1_ema) and not h1_ema_flat

// --- Détection BOS H1 ---
var float h1_last_ph = na
var float h1_last_pl = na

if ta.change(time("60"))
    if not na(h1_ph)
        h1_last_ph := h1_ph
    if not na(h1_pl)
        h1_last_pl := h1_pl

h1_bos_bull = ta.change(time("60")) and not na(h1_last_ph) and h1_close > h1_last_ph
h1_bos_bear = ta.change(time("60")) and not na(h1_last_pl) and h1_close < h1_last_pl

if h1_bos_bull
    h1_last_ph := na
if h1_bos_bear
    h1_last_pl := na

// --- Détection FVG H1 (Filtre anti micro-FVG > 0.5 ATR) ---
h1_fvg_bull = (h1_low > h1_high2) and ((h1_low - h1_high2) > (0.5 * h1_atr))
h1_fvg_bear = (h1_high < h1_low2) and ((h1_low2 - h1_high) > (0.5 * h1_atr))

// --- Machine à états HTF (Consommation de zone) ---
var float h1_bull_zone_top = na
var float h1_bull_zone_bot = na
var bool  h1_bull_consumed = false
var box   h1_bull_box      = na

var float h1_bear_zone_top = na
var float h1_bear_zone_bot = na
var bool  h1_bear_consumed = false
var box   h1_bear_box      = na

color_fvg_hl = color.new(#FFFF00, 55) // Jaune fluo, bien visible et distinct de l'OTE
color_ote    = color.new(#A78BFA, 88) // Violet clair — distinct de la FVG pour ne pas se confondre

if ta.change(time("60"))
    // Bull Zone
    if h1_fvg_bull
        // Réarmer dès qu'une NOUVELLE FVG H1 valide (bornes différentes) se produit
        is_new_fvg = na(h1_bull_zone_bot) or (h1_low != h1_bull_zone_top) or (h1_high2 != h1_bull_zone_bot)
        if is_new_fvg
            // Supprime l'ancienne boîte (au lieu de la geler) pour ne pas saturer l'écran de zones obsolètes
            if not na(h1_bull_box)
                box.delete(h1_bull_box)
                h1_bull_box := na

            h1_bull_zone_top := h1_low
            h1_bull_zone_bot := h1_high2
            h1_bull_consumed := false
            if show_fvg
                h1_bull_box := box.new(bar_index, h1_bull_zone_top, bar_index + 1, h1_bull_zone_bot, border_color=na, bgcolor=color_fvg_hl, extend=extend.right)

    // Bear Zone
    if h1_fvg_bear
        // Réarmer dès qu'une NOUVELLE FVG H1 valide (bornes différentes) se produit
        is_new_fvg = na(h1_bear_zone_top) or (h1_low2 != h1_bear_zone_top) or (h1_high != h1_bear_zone_bot)
        if is_new_fvg
            // Supprime l'ancienne boîte (au lieu de la geler)
            if not na(h1_bear_box)
                box.delete(h1_bear_box)
                h1_bear_box := na

            h1_bear_zone_top := h1_low2
            h1_bear_zone_bot := h1_high
            h1_bear_consumed := false
            if show_fvg
                h1_bear_box := box.new(bar_index, h1_bear_zone_top, bar_index + 1, h1_bear_zone_bot, border_color=na, bgcolor=color_fvg_hl, extend=extend.right)

in_h1_bull_zone = not h1_bull_consumed and not na(h1_bull_zone_top) and (high >= h1_bull_zone_bot and low <= h1_bull_zone_top)
in_h1_bear_zone = not h1_bear_consumed and not na(h1_bear_zone_top) and (high >= h1_bear_zone_bot and low <= h1_bear_zone_top)

// Invalidation dès que le prix retourne dans la zone (mitigation), cohérent avec la logique OB/FVG M5
if in_h1_bull_zone
    h1_bull_consumed := true
if in_h1_bear_zone
    h1_bear_consumed := true

// ==========================================
// 2.5 NIVEAUX MAJEURS (PDH, PDL, NY MIDNIGHT)
// ==========================================
var float pdh = na
var float pdl = na
var int   pdh_bar = na
var int   pdl_bar = na
var float current_dh = na
var float current_dl = na
var int   current_dh_bar = na
var int   current_dl_bar = na

if ta.change(time("D", "America/New_York"))
    pdh := current_dh
    pdl := current_dl
    pdh_bar := current_dh_bar
    pdl_bar := current_dl_bar
    current_dh := high
    current_dl := low
    current_dh_bar := bar_index
    current_dl_bar := bar_index
else
    // On ne met à jour la bougie d'origine QUE si elle bat effectivement le record du jour
    if high > current_dh
        current_dh := high
        current_dh_bar := bar_index
    if low < current_dl
        current_dl := low
        current_dl_bar := bar_index

var float midnight_open = na
if ta.change(time("D", "America/New_York"))
    midnight_open := open

// --- Discount / Premium & zone OTE (sur un range glissant, toujours pertinent même en forte tendance) ---
range_high = ta.highest(high, range_lookback)
range_low  = ta.lowest(low, range_lookback)
eq_level = (range_high + range_low) / 2
ote_top  = range_low + (range_high - range_low) * 0.382
ote_bot  = range_low + (range_high - range_low) * 0.21

var box ote_box = na
if ta.change(time("D", "America/New_York")) and not na(ote_box)
    box.set_right(ote_box, bar_index)
    ote_box := na
if show_ote and not na(ote_top) and not na(ote_bot)
    if na(ote_box)
        ote_box := box.new(bar_index, ote_top, bar_index + 1, ote_bot, border_color=na, bgcolor=color_ote, extend=extend.right)
    else
        box.set_top(ote_box, ote_top)
        box.set_bottom(ote_box, ote_bot)

// Rendu Graphique : la ligne démarre EXACTEMENT sur la bougie qui a fait le plus haut/bas de la veille
if ta.change(time("D", "America/New_York")) and show_levels
    if not na(pdh)
        line.new(pdh_bar, pdh, bar_index + 288, pdh, color=color_lux_level, width=1, style=line.style_dotted)
        label.new(bar_index + 5, pdh, "PDH", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.normal)
    if not na(pdl)
        line.new(pdl_bar, pdl, bar_index + 288, pdl, color=color_lux_level, width=1, style=line.style_dotted)
        label.new(bar_index + 5, pdl, "PDL", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.normal)

if ta.change(time("D", "America/New_York")) and show_levels
    line.new(bar_index, open, bar_index + 288, open, color=color.new(#FFC73C, 20), width=1, style=line.style_dashed) // Midnight Open en Or discret
    label.new(bar_index + 5, open, "NY Open", color=color.new(color.white, 100), textcolor=color_lux_gold, style=label.style_none, size=size.normal)

// ==========================================
// 3. STRUCTURE M5 & CONFIRMATION DE REJET
// ==========================================
atr_val       = ta.atr(14)
bar_confirmed = barstate.isconfirmed

// --- Sonde de mitigation (Mèche/Corps/Clôture) — porté du moteur V48 (Projet_ECC_Test) ---
mit_probe_bull = fvg_mitigation_mode == "Mèche" ? low : fvg_mitigation_mode == "Corps" ? math.min(open, close) : close
mit_probe_bear = fvg_mitigation_mode == "Mèche" ? high : fvg_mitigation_mode == "Corps" ? math.max(open, close) : close

// --- Gestion des zones "extra" en tableau plafonné (affichage multi-zones, sans effet sur les entrées) ---
f_push_zone(box_arr, top_arr, bot_arr, mit_arr, new_box, new_top, new_bot, maxN) =>
    array.push(box_arr, new_box)
    array.push(top_arr, new_top)
    array.push(bot_arr, new_bot)
    array.push(mit_arr, false)
    if array.size(box_arr) > maxN
        old_box = array.shift(box_arr)
        array.shift(top_arr)
        array.shift(bot_arr)
        array.shift(mit_arr)
        if not na(old_box)
            box.delete(old_box)

f_update_bull_zones(box_arr, top_arr, bot_arr, mit_arr, probe, grey_not_delete, grey_color) =>
    i = array.size(box_arr) - 1
    while i >= 0
        if not array.get(mit_arr, i)
            top = array.get(top_arr, i)
            if probe <= top
                array.set(mit_arr, i, true)
                bx = array.get(box_arr, i)
                if not na(bx)
                    if grey_not_delete
                        box.set_bgcolor(bx, grey_color)
                        box.set_extend(bx, extend.none)
                        box.set_right(bx, bar_index)
                    else
                        box.delete(bx)
                        array.set(box_arr, i, na)
        i -= 1

f_update_bear_zones(box_arr, top_arr, bot_arr, mit_arr, probe, grey_not_delete, grey_color) =>
    i = array.size(box_arr) - 1
    while i >= 0
        if not array.get(mit_arr, i)
            bot = array.get(bot_arr, i)
            if probe >= bot
                array.set(mit_arr, i, true)
                bx = array.get(box_arr, i)
                if not na(bx)
                    if grey_not_delete
                        box.set_bgcolor(bx, grey_color)
                        box.set_extend(bx, extend.none)
                        box.set_right(bx, bar_index)
                    else
                        box.delete(bx)
                        array.set(box_arr, i, na)
        i -= 1

// Pivots M5
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

var float last_ph     = na
var int   last_ph_bar = na
var float prev_ph     = na
var int   prev_ph_bar = na
var float lowest_since_ph = na
var float ob_bull_top = na
var float ob_bull_bot = na
var int   ob_bull_bar = na

if not na(ph)
    prev_ph := last_ph
    prev_ph_bar := last_ph_bar
    last_ph := ph
    last_ph_bar := bar_index - 5
    ob_bull_bot := low
    ob_bull_top := high
    ob_bull_bar := bar_index
    lowest_since_ph := low
    
    // Détection EQH
    if show_eqh_eql and not na(prev_ph) and math.abs(last_ph - prev_ph) <= (syminfo.mintick * 15)
        line.new(prev_ph_bar, prev_ph, bar_index, prev_ph, color=color_lux_liq, width=1)
        label.new(math.round((prev_ph_bar + bar_index)/2), prev_ph, "EQH 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bull_bot)
    if low <= ob_bull_bot
        ob_bull_bot := low
        ob_bull_top := high
        ob_bull_bar := bar_index
        lowest_since_ph := low

var float last_pl     = na
var int   last_pl_bar = na
var float prev_pl     = na
var int   prev_pl_bar = na
var float highest_since_pl = na
var float ob_bear_top = na
var float ob_bear_bot = na
var int   ob_bear_bar = na
var int   last_struct_dir = 0 // 1 = Bull, -1 = Bear

if not na(pl)
    prev_pl := last_pl
    prev_pl_bar := last_pl_bar
    last_pl := pl
    last_pl_bar := bar_index - 5
    ob_bear_top := high
    ob_bear_bot := low
    ob_bear_bar := bar_index
    highest_since_pl := high
    
    // Détection EQL
    if show_eqh_eql and not na(prev_pl) and math.abs(last_pl - prev_pl) <= (syminfo.mintick * 15)
        line.new(prev_pl_bar, prev_pl, bar_index, prev_pl, color=color_lux_liq, width=1)
        label.new(math.round((prev_pl_bar + bar_index)/2), prev_pl, "EQL 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bear_top)
    if high >= ob_bear_top
        ob_bear_top := high
        ob_bear_bot := low
        ob_bear_bar := bar_index
        highest_since_pl := high

c_range = high - low
c_body  = math.abs(close - open)
is_disp = c_range > 0 and ((c_body / c_range) >= 0.50)

// Balayage de liquidité (Sweeps de mèches M5)
wick_top = high - math.max(open, close)
wick_bot = math.min(open, close) - low
rej_buy  = c_range > 0 and (wick_bot / c_range) >= 0.35 and close > open
rej_sell = c_range > 0 and (wick_top / c_range) >= 0.35 and close < open

sweep_l = not na(last_pl) and low < last_pl and close > last_pl and rej_buy
sweep_h = not na(last_ph) and high > last_ph and close < last_ph and rej_sell

// Mémoire de zone H1 touchée récemment (15 barres M5)
bars_in_h1_bull = ta.barssince(in_h1_bull_zone)
bars_in_h1_bear = ta.barssince(in_h1_bear_zone)
tested_h1_bull  = not na(bars_in_h1_bull) and bars_in_h1_bull <= zone_window_in
tested_h1_bear  = not na(bars_in_h1_bear) and bars_in_h1_bear <= zone_window_in

// Contexte d'affichage filtré (Évite le bruit graphique)
valid_ctx_bull = tested_h1_bull or (h1_bias_bull and not na(ta.barssince(sweep_l)) and ta.barssince(sweep_l) <= zone_window_in)
valid_ctx_bear = tested_h1_bear or (h1_bias_bear and not na(ta.barssince(sweep_h)) and ta.barssince(sweep_h) <= zone_window_in)

// Variables pour suivre la mitigation (indépendamment de l'affichage)
var bool  is_ob_bull_active = false
var float current_ob_bull_top = na
var int   current_ob_bull_start = na
var box   current_ob_bull = na

var bool  is_ob_bear_active = false
var float current_ob_bear_bot = na
var int   current_ob_bear_start = na
var box   current_ob_bear = na

var bool  is_fvg_bull_active = false
var float current_fvg_bull_m5_top = na
var int   current_fvg_bull_m5_start = na
var box   current_fvg_bull_m5 = na

var bool  is_fvg_bear_active = false
var float current_fvg_bear_m5_bot = na
var int   current_fvg_bear_m5_start = na
var box   current_fvg_bear_m5 = na

// Zones "extra" en tableau plafonné (affichage multi-zones simultanées, sans influencer les entrées)
var box[]   ext_ob_bull_box = array.new_box()
var float[] ext_ob_bull_top = array.new_float()
var float[] ext_ob_bull_bot = array.new_float()
var bool[]  ext_ob_bull_mit = array.new_bool()

var box[]   ext_ob_bear_box = array.new_box()
var float[] ext_ob_bear_top = array.new_float()
var float[] ext_ob_bear_bot = array.new_float()
var bool[]  ext_ob_bear_mit = array.new_bool()

var box[]   ext_fvg_bull_box = array.new_box()
var float[] ext_fvg_bull_top = array.new_float()
var float[] ext_fvg_bull_bot = array.new_float()
var bool[]  ext_fvg_bull_mit = array.new_bool()

var box[]   ext_fvg_bear_box = array.new_box()
var float[] ext_fvg_bear_top = array.new_float()
var float[] ext_fvg_bear_bot = array.new_float()
var bool[]  ext_fvg_bear_mit = array.new_bool()

// MSS / CHoCH en M5
mss_bull = not na(last_ph) and bar_confirmed and ta.crossover(close, last_ph) and is_disp
if mss_bull
    // On ne trace QUE s'il sort d'une zone H1 testée
    if tested_h1_bull
        if show_mss
            is_choch = (last_struct_dir != 1)
            lbl_text = is_choch ? "⇄ CHoCH" : "➤ BOS"
            line.new(last_ph_bar, last_ph, bar_index, last_ph, color=color_lux_bull, width=3, style=line.style_dashed)
            label.new(math.round((last_ph_bar + bar_index)/2), last_ph, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bull, style=label.style_none, size=size.normal)
        
        if not na(ob_bull_bot)
            is_ob_bull_active := true
            current_ob_bull_top := ob_bull_top
            current_ob_bull_start := bar_index
            ob_bull_relevant = not ob_filter_dp or na(eq_level) or (ob_bull_top <= eq_level)
            if show_ob and ob_bull_relevant
                if not na(current_ob_bull)
                    box.delete(current_ob_bull)
                current_ob_bull := box.new(ob_bull_bar, ob_bull_top, bar_index, ob_bull_bot, border_color=na, bgcolor=color.new(color_ob_bull, 72), extend=extend.right)
    // Affichage élargi (même condition que les FVG M5) — purement visuel, n'alimente pas les entrées
    if not tested_h1_bull and valid_ctx_bull and not na(ob_bull_bot)
        ob_bull_relevant2 = not ob_filter_dp or na(eq_level) or (ob_bull_top <= eq_level)
        if show_ob and ob_bull_relevant2
            new_ob_bull_box = box.new(ob_bull_bar, ob_bull_top, bar_index, ob_bull_bot, border_color=na, bgcolor=color.new(color_ob_bull, 72), extend=extend.right)
            f_push_zone(ext_ob_bull_box, ext_ob_bull_top, ext_ob_bull_bot, ext_ob_bull_mit, new_ob_bull_box, ob_bull_top, ob_bull_bot, max_zones_in)
    last_ph := na
    last_struct_dir := 1

mss_bear = not na(last_pl) and bar_confirmed and ta.crossunder(close, last_pl) and is_disp
if mss_bear
    // On ne trace QUE s'il sort d'une zone H1 testée
    if tested_h1_bear
        if show_mss
            is_choch = (last_struct_dir != -1)
            lbl_text = is_choch ? "⇄ CHoCH" : "➤ BOS"
            line.new(last_pl_bar, last_pl, bar_index, last_pl, color=color_lux_bear, width=3, style=line.style_dashed)
            label.new(math.round((last_pl_bar + bar_index)/2), last_pl, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bear, style=label.style_none, size=size.normal)
        
        if not na(ob_bear_top)
            is_ob_bear_active := true
            current_ob_bear_bot := ob_bear_bot
            current_ob_bear_start := bar_index
            ob_bear_relevant = not ob_filter_dp or na(eq_level) or (ob_bear_bot >= eq_level)
            if show_ob and ob_bear_relevant
                if not na(current_ob_bear)
                    box.delete(current_ob_bear)
                current_ob_bear := box.new(ob_bear_bar, ob_bear_top, bar_index, ob_bear_bot, border_color=na, bgcolor=color.new(color_ob_bear, 72), extend=extend.right)
    // Affichage élargi (même condition que les FVG M5) — purement visuel, n'alimente pas les entrées
    if not tested_h1_bear and valid_ctx_bear and not na(ob_bear_top)
        ob_bear_relevant2 = not ob_filter_dp or na(eq_level) or (ob_bear_bot >= eq_level)
        if show_ob and ob_bear_relevant2
            new_ob_bear_box = box.new(ob_bear_bar, ob_bear_top, bar_index, ob_bear_bot, border_color=na, bgcolor=color.new(color_ob_bear, 72), extend=extend.right)
            f_push_zone(ext_ob_bear_box, ext_ob_bear_top, ext_ob_bear_bot, ext_ob_bear_mit, new_ob_bear_box, ob_bear_top, ob_bear_bot, max_zones_in)
    last_pl := na
    last_struct_dir := -1

// FVG en M5 (Rendu graphique conditionnel)
fvg_bull_m5 = (low > high[2]) and (low - high[2] >= atr_val * 0.15)
if fvg_bull_m5 and valid_ctx_bull
    if is_fvg_bull_active and show_fvg_m5
        // Slot officiel déjà occupé : cette nouvelle FVG part dans le tableau "extra" au lieu d'écraser l'ancienne
        new_fvg_bull_box = box.new(bar_index - 2, low, bar_index, high[2], border_color=na, bgcolor=color_fvg_hl, extend=extend.right)
        f_push_zone(ext_fvg_bull_box, ext_fvg_bull_top, ext_fvg_bull_bot, ext_fvg_bull_mit, new_fvg_bull_box, high[2], low, max_zones_in)
    else
        is_fvg_bull_active := true
        current_fvg_bull_m5_top := high[2]
        current_fvg_bull_m5_start := bar_index
        if show_fvg_m5
            if not na(current_fvg_bull_m5)
                box.delete(current_fvg_bull_m5)
            current_fvg_bull_m5 := box.new(bar_index - 2, low, bar_index, high[2], border_color=na, bgcolor=color_fvg_hl, extend=extend.right)

fvg_bear_m5 = (high < low[2]) and (low[2] - high >= atr_val * 0.15)
if fvg_bear_m5 and valid_ctx_bear
    if is_fvg_bear_active and show_fvg_m5
        new_fvg_bear_box = box.new(bar_index - 2, low[2], bar_index, high, border_color=na, bgcolor=color_fvg_hl, extend=extend.right)
        f_push_zone(ext_fvg_bear_box, ext_fvg_bear_top, ext_fvg_bear_bot, ext_fvg_bear_mit, new_fvg_bear_box, high, low[2], max_zones_in)
    else
        is_fvg_bear_active := true
        current_fvg_bear_m5_bot := low[2]
        current_fvg_bear_m5_start := bar_index
        if show_fvg_m5
            if not na(current_fvg_bear_m5)
                box.delete(current_fvg_bear_m5)
            current_fvg_bear_m5 := box.new(bar_index - 2, low[2], bar_index, high, border_color=na, bgcolor=color_fvg_hl, extend=extend.right)

// Logique de Mitigation (Coupure automatique et déclenchement d'entrée)
mitigated_ob_bull = false
mitigated_ob_bear = false
mitigated_fvg_bull = false
mitigated_fvg_bear = false

if is_ob_bull_active and bar_index > current_ob_bull_start and mit_probe_bull <= current_ob_bull_top
    is_ob_bull_active := false
    mitigated_ob_bull := true
    if not na(current_ob_bull)
        box.delete(current_ob_bull)
        current_ob_bull := na

if is_ob_bear_active and bar_index > current_ob_bear_start and mit_probe_bear >= current_ob_bear_bot
    is_ob_bear_active := false
    mitigated_ob_bear := true
    if not na(current_ob_bear)
        box.delete(current_ob_bear)
        current_ob_bear := na

if is_fvg_bull_active and bar_index > current_fvg_bull_m5_start and mit_probe_bull <= current_fvg_bull_m5_top
    is_fvg_bull_active := false
    mitigated_fvg_bull := true
    if not na(current_fvg_bull_m5)
        box.set_bgcolor(current_fvg_bull_m5, color.new(color_lux_level, 85))
        box.set_extend(current_fvg_bull_m5, extend.none)
        box.set_right(current_fvg_bull_m5, bar_index)
        current_fvg_bull_m5 := na

if is_fvg_bear_active and bar_index > current_fvg_bear_m5_start and mit_probe_bear >= current_fvg_bear_m5_bot
    is_fvg_bear_active := false
    mitigated_fvg_bear := true
    if not na(current_fvg_bear_m5)
        box.set_bgcolor(current_fvg_bear_m5, color.new(color_lux_level, 85))
        box.set_extend(current_fvg_bear_m5, extend.none)
        box.set_right(current_fvg_bear_m5, bar_index)
        current_fvg_bear_m5 := na

// Mise à jour des zones "extra" en tableau : OB disparaît (comme demandé), FVG passe en gris clair
f_update_bull_zones(ext_ob_bull_box, ext_ob_bull_top, ext_ob_bull_bot, ext_ob_bull_mit, mit_probe_bull, false, color(na))
f_update_bear_zones(ext_ob_bear_box, ext_ob_bear_top, ext_ob_bear_bot, ext_ob_bear_mit, mit_probe_bear, false, color(na))
f_update_bull_zones(ext_fvg_bull_box, ext_fvg_bull_top, ext_fvg_bull_bot, ext_fvg_bull_mit, mit_probe_bull, true, color.new(color_lux_level, 85))
f_update_bear_zones(ext_fvg_bear_box, ext_fvg_bear_top, ext_fvg_bear_bot, ext_fvg_bear_mit, mit_probe_bear, true, color.new(color_lux_level, 85))

// ==========================================
// 4. LOGIQUE CAUSALE ICT 2022 (MACHINE D'ETATS) & ENTREE
// ==========================================
// États de la séquence ICT 2022 :
// IDLE -> SWEEP_ARMED -> MSS_CONFIRMED -> CAUSAL_FVG_CONFIRMED -> WAIT_RETEST -> READY -> RESET
int STATE_IDLE                = 0
int STATE_SWEEP_ARMED         = 1
int STATE_MSS_CONFIRMED       = 2
int STATE_CAUSAL_FVG_CONFIRMED = 3
int STATE_WAIT_RETEST         = 4
int STATE_READY               = 5

// --- Machine d'état BUY (Long) ---
var int   buy_state            = STATE_IDLE
var int   buy_sweep_bar        = na
var float buy_sweep_low        = na
var float buy_mss_level        = na
var int   buy_displacement_bar = na
var float buy_fvg_top          = na
var float buy_fvg_bottom       = na
var int   buy_fvg_bar          = na

// --- Machine d'état SELL (Short) ---
var int   sell_state            = STATE_IDLE
var int   sell_sweep_bar        = na
var float sell_sweep_high       = na
var float sell_mss_level        = na
var int   sell_displacement_bar = na
var float sell_fvg_top          = na
var float sell_fvg_bottom       = na
var int   sell_fvg_bar          = na

// Définition quantitative du Displacement (M5)
// Référence ATR : atr_val[1]
disp_body_ratio = c_range > 0 ? (c_body / c_range) : 0.0
is_disp_quant   = (disp_body_ratio >= 0.65) and (c_body >= 1.25 * atr_val[1])

// Timeouts maximaux (en barres M5)
MAX_BARS_SWEEP_TO_MSS = 12
MAX_BARS_FVG_TO_RETEST = 20

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : BUY
// -------------------------------------------------------------
// 1. Resets / Invalidations BUY
if buy_state != STATE_IDLE
    // Invalidation par nouveau plus bas sous le low du sweep
    if not na(buy_sweep_low) and low < buy_sweep_low
        buy_state := STATE_IDLE
    // Invalidation si sweep opposé (BSL) plus récent
    else if sweep_h
        buy_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if buy_state == STATE_SWEEP_ARMED and (bar_index - buy_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        buy_state := STATE_IDLE
    // Violation FVG causale (clôture sous le bas de la FVG causale avant exécution)
    else if (buy_state == STATE_CAUSAL_FVG_CONFIRMED or buy_state == STATE_WAIT_RETEST) and close < buy_fvg_bottom
        buy_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if buy_state == STATE_WAIT_RETEST and (bar_index - buy_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        buy_state := STATE_IDLE

// 2. Transitions BUY
if buy_state == STATE_IDLE
    // Condition de départ : Sweep de Sell-Side Liquidity (SSL)
    if sweep_l
        buy_state            := STATE_SWEEP_ARMED
        buy_sweep_bar        := bar_index
        buy_sweep_low        := low
        buy_mss_level        := last_ph
        buy_displacement_bar := na
        buy_fvg_top          := na
        buy_fvg_bottom       := na
        buy_fvg_bar          := na
else if buy_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_l
        buy_sweep_bar := bar_index
        buy_sweep_low := low
        buy_mss_level := last_ph
    // Recherche du Displacement + MSS haussier cassant buy_mss_level
    else if bar_confirmed and not na(buy_mss_level) and close > buy_mss_level and close > open and is_disp_quant
        buy_state            := STATE_MSS_CONFIRMED
        buy_displacement_bar := bar_index
else if buy_state == STATE_MSS_CONFIRMED
    // La FVG causale 3 bougies a la bougie de displacement comme bougie centrale (bar_index - 1)
    // À bar_index (bougie 3 fermée), la condition FVG haussière 3 bougies est: low > high[2]
    if bar_index == buy_displacement_bar + 1 and bar_confirmed
        has_causal_fvg = (low > high[2]) and ((low - high[2]) >= atr_val[1] * 0.15)
        if has_causal_fvg
            buy_fvg_top    := low
            buy_fvg_bottom := high[2]
            buy_fvg_bar    := bar_index
            buy_state      := STATE_CAUSAL_FVG_CONFIRMED
        else
            buy_state := STATE_IDLE // Pas de FVG causale créée par le displacement -> Reset
    else if bar_index > buy_displacement_bar + 1
        buy_state := STATE_IDLE
else if buy_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    buy_state := STATE_WAIT_RETEST
else if buy_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer en dessous
    if mit_probe_bull <= buy_fvg_top and close >= buy_fvg_bottom
        buy_state := STATE_READY

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : SELL
// -------------------------------------------------------------
// 1. Resets / Invalidations SELL
if sell_state != STATE_IDLE
    // Invalidation par nouveau plus haut au-dessus du high du sweep
    if not na(sell_sweep_high) and high > sell_sweep_high
        sell_state := STATE_IDLE
    // Invalidation si sweep opposé (SSL) plus récent
    else if sweep_l
        sell_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if sell_state == STATE_SWEEP_ARMED and (bar_index - sell_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        sell_state := STATE_IDLE
    // Violation FVG causale (clôture au-dessus du haut de la FVG causale avant exécution)
    else if (sell_state == STATE_CAUSAL_FVG_CONFIRMED or sell_state == STATE_WAIT_RETEST) and close > sell_fvg_top
        sell_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if sell_state == STATE_WAIT_RETEST and (bar_index - sell_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        sell_state := STATE_IDLE

// 2. Transitions SELL
if sell_state == STATE_IDLE
    // Condition de départ : Sweep de Buy-Side Liquidity (BSL)
    if sweep_h
        sell_state            := STATE_SWEEP_ARMED
        sell_sweep_bar        := bar_index
        sell_sweep_high       := high
        sell_mss_level        := last_pl
        sell_displacement_bar := na
        sell_fvg_top          := na
        sell_fvg_bottom       := na
        sell_fvg_bar          := na
else if sell_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_h
        sell_sweep_bar := bar_index
        sell_sweep_high := high
        sell_mss_level := last_pl
    // Recherche du Displacement + MSS baissier cassant sell_mss_level
    else if bar_confirmed and not na(sell_mss_level) and close < sell_mss_level and close < open and is_disp_quant
        sell_state            := STATE_MSS_CONFIRMED
        sell_displacement_bar := bar_index
else if sell_state == STATE_MSS_CONFIRMED
    // La FVG causale 3 bougies a la bougie de displacement comme bougie centrale (bar_index - 1)
    // À bar_index (bougie 3 fermée), la condition FVG baissière 3 bougies est: high < low[2]
    if bar_index == sell_displacement_bar + 1 and bar_confirmed
        has_causal_fvg = (high < low[2]) and ((low[2] - high) >= atr_val[1] * 0.15)
        if has_causal_fvg
            sell_fvg_top    := low[2]
            sell_fvg_bottom := high
            sell_fvg_bar    := bar_index
            sell_state      := STATE_CAUSAL_FVG_CONFIRMED
        else
            sell_state := STATE_IDLE // Pas de FVG causale créée par le displacement -> Reset
    else if bar_index > sell_displacement_bar + 1
        sell_state := STATE_IDLE
else if sell_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    sell_state := STATE_WAIT_RETEST
else if sell_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer au-dessus
    if mit_probe_bear >= sell_fvg_bottom and close <= sell_fvg_top
        sell_state := STATE_READY

// Variables de position
var bool   in_pos       = false
var float  pos_entry    = 0.0
var float  pos_sl       = 0.0
var float  pos_tp       = 0.0
var string pos_dir      = "NONE"
var int    last_sig_bar = 0
var box    tp_zone_box  = na
var box    sl_zone_box  = na

// Timeout de 15 barres M5 entre deux signaux dans la même zone
cooldown_ok = na(last_sig_bar) or (bar_index - last_sig_bar > cooldown_bars_in)

// Déclencheurs de signal alimentés STRICTEMENT par la séquence causale ICT 2022
// BUY/SELL mutuellement exclusifs à l'exécution
cand_buy  = trade_window and not in_pos and cooldown_ok and bar_confirmed and (buy_state == STATE_READY)
cand_sell = trade_window and not in_pos and cooldown_ok and bar_confirmed and (sell_state == STATE_READY)

raw_buy  = cand_buy and not cand_sell
raw_sell = cand_sell and not cand_buy

// Qualification du setup
calc_score(is_mtf) =>
    score = is_mtf ? 3 : 2
    grade_str = score == 3 ? "A+" : "A"
    stars_str = score == 3 ? "★★★★★" : "★★★★☆"
    [score, grade_str, stars_str]

if raw_buy
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bull)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        setup_name   = tested_h1_bull ? "RETEST" : "SSL SWEEP"
        pos_entry    := close
        
        // SL Structurel ancré sur le bas du sweep d'origine, plafonné/planché par ATR M5
        raw_sl       = not na(buy_sweep_low) ? (buy_sweep_low - syminfo.mintick * 10) : (ta.lowest(low, 15) - syminfo.mintick * 10)
        raw_risk     = pos_entry - raw_sl
        risk         = math.max(math.min(raw_risk, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        pos_sl       := pos_entry - risk
        pos_tp       := pos_entry + (risk * rr_ratio)
        pos_dir      := "BUY"
        in_pos       := true
        last_sig_bar := bar_index

        // Reset de la machine d'état après entrée exécutée
        buy_state := STATE_IDLE

        // MARQUAGE CONSUMED : Bloque toute réutilisation de cette zone H1
        h1_bull_consumed := true

        // Label d'entrée en 2 niveaux, bien décalé du prix pour rester lisible au milieu des FVG/OB/CHoCH
        label.new(bar_index, low - (atr_val * 0.8), "🟢 " + grade_txt + " " + setup_name, color=color.new(color_lux_bull, 15), textcolor=color.black, style=label.style_label_up, size=size.small)

        // Zone visuelle Risque/Récompense (comme les indicateurs LuxAlgo) : vert vers le TP, rouge vers le SL
        if show_risk_zone
            if not na(tp_zone_box)
                box.delete(tp_zone_box)
            if not na(sl_zone_box)
                box.delete(sl_zone_box)
            tp_zone_box := box.new(bar_index, pos_tp, bar_index + 30, pos_entry, border_color=na, bgcolor=color.new(color_lux_bull, 88))
            sl_zone_box := box.new(bar_index, pos_entry, bar_index + 30, pos_sl, border_color=na, bgcolor=color.new(color_lux_bear, 88))

        payload_entry = '{"symbol":"' + asset_name + '","status":"' + setup_name + '","direction":"BUY","quality":"' + grade_txt + '","grade":"' + stars_txt + '","entry_price":"' + str.tostring(pos_entry, format.mintick) + '","sl_price":"' + str.tostring(pos_sl, format.mintick) + '","tp_price":"' + str.tostring(pos_tp, format.mintick) + '","current_price":"' + str.tostring(close, format.mintick) + '","rr":"' + str.tostring(rr_ratio, "#.#") + '"}'
        alert(payload_entry, alert.freq_once_per_bar_close)

if raw_sell
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bear)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        setup_name   = tested_h1_bear ? "RETEST" : "BSL SWEEP"
        pos_entry    := close
        
        // SL Structurel ancré sur le haut du sweep d'origine, plafonné/planché par ATR M5
        raw_sl       = not na(sell_sweep_high) ? (sell_sweep_high + syminfo.mintick * 10) : (ta.highest(high, 15) + syminfo.mintick * 10)
        raw_risk     = raw_sl - pos_entry
        risk         = math.max(math.min(raw_risk, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        pos_sl       := pos_entry + risk
        pos_tp       := pos_entry - (risk * rr_ratio)
        pos_dir      := "SELL"
        in_pos       := true
        last_sig_bar := bar_index

        // Reset de la machine d'état après entrée exécutée
        sell_state := STATE_IDLE

        // MARQUAGE CONSUMED : Bloque toute réutilisation de cette zone H1
        h1_bear_consumed := true

        // Label d'entrée en 2 niveaux, bien décalé du prix pour rester lisible au milieu des FVG/OB/CHoCH
        label.new(bar_index, high + (atr_val * 0.8), "🔴 " + grade_txt + " " + setup_name, color=color.new(color_lux_bear, 15), textcolor=color.white, style=label.style_label_down, size=size.small)

        // Zone visuelle Risque/Récompense (comme les indicateurs LuxAlgo) : vert vers le TP, rouge vers le SL
        if show_risk_zone
            if not na(tp_zone_box)
                box.delete(tp_zone_box)
            if not na(sl_zone_box)
                box.delete(sl_zone_box)
            tp_zone_box := box.new(bar_index, pos_entry, bar_index + 30, pos_tp, border_color=na, bgcolor=color.new(color_lux_bull, 88))
            sl_zone_box := box.new(bar_index, pos_sl, bar_index + 30, pos_entry, border_color=na, bgcolor=color.new(color_lux_bear, 88))

        payload_entry = '{"symbol":"' + asset_name + '","status":"' + setup_name + '","direction":"SELL","quality":"' + grade_txt + '","grade":"' + stars_txt + '","entry_price":"' + str.tostring(pos_entry, format.mintick) + '","sl_price":"' + str.tostring(pos_sl, format.mintick) + '","tp_price":"' + str.tostring(pos_tp, format.mintick) + '","current_price":"' + str.tostring(close, format.mintick) + '","rr":"' + str.tostring(rr_ratio, "#.#") + '"}'
        alert(payload_entry, alert.freq_once_per_bar_close)

// ==========================================
// 5. SORTIES TP / SL & GESTION DES DESSINS
// ==========================================
if in_pos
    hit_tp = (pos_dir == "BUY" and high >= pos_tp) or (pos_dir == "SELL" and low <= pos_tp)
    hit_sl = (pos_dir == "BUY" and low <= pos_sl)  or (pos_dir == "SELL" and high >= pos_sl)
    // Timeout automatique après 30 bougies M5 (2h30) pour débloquer le scanner
    pos_expired = (bar_index - last_sig_bar) >= 30

    if hit_sl or hit_tp or pos_expired
        exit_status = hit_sl ? "SL_HIT" : (hit_tp ? "TP_HIT" : "EXPIRED")
        payload_exit = '{"symbol":"' + asset_name + '","status":"' + exit_status + '","direction":"NONE","quality":"--","grade":"--","entry_price":"0.0","sl_price":"0.0","tp_price":"0.0","current_price":"' + str.tostring(close, format.mintick) + '","rr":"0.0"}'
        alert(payload_exit, alert.freq_once_per_bar_close)
        in_pos  := false
        pos_dir := "NONE"

        if not na(tp_zone_box)
            box.set_right(tp_zone_box, bar_index)
        if not na(sl_zone_box)
            box.set_right(sl_zone_box, bar_index)

// Passage en gris clair + arrêt d'extension des boîtes H1 lorsqu'elles sont mitigées (preuve visuelle explicite)
if h1_bull_consumed and not na(h1_bull_box)
    box.set_bgcolor(h1_bull_box, color.new(color_lux_level, 85))
    box.set_extend(h1_bull_box, extend.none)
    box.set_right(h1_bull_box, bar_index)
    h1_bull_box := na

if h1_bear_consumed and not na(h1_bear_box)
    box.set_bgcolor(h1_bear_box, color.new(color_lux_level, 85))
    box.set_extend(h1_bear_box, extend.none)
    box.set_right(h1_bear_box, bar_index)
    h1_bear_box := na

// ==========================================
// 6. TABLEAU DE BORD (overlay, style LuxAlgo)
// ==========================================
var table dash = table.new(position.top_right, 2, 6, border_color=color_panel_bd, border_width=2, frame_color=color_panel_bd, frame_width=2)

if show_dashboard and barstate.islast
    bias_txt = h1_bias_bull ? "🟢 HAUSSIER" : h1_bias_bear ? "🔴 BAISSIER" : "⚪ NEUTRE"
    bias_col = h1_bias_bull ? color_lux_bull : h1_bias_bear ? color_lux_bear : color_lux_level
    sess_txt = in_london ? "🟠 LONDRES" : in_ny ? "🟠 NEW YORK" : "HORS SESSION"
    sess_col = (in_london or in_ny) ? color_lux_gold : color_lux_level
    pos_txt  = in_pos ? ("🔥 " + pos_dir + " EN COURS") : "— AUCUNE"
    pos_col  = in_pos ? (pos_dir == "BUY" ? color_lux_bull : color_lux_bear) : color_lux_level

    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "  ◆ " + asset_name + "  ", text_color=color.white, text_size=size.large, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 0, 1, "  Timeframe  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 1, "  M5 · H1  ", text_color=color.white, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 2, "  Biais H1  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 2, "  " + bias_txt + "  ", text_color=bias_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 3, "  Session  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 3, "  " + sess_txt + "  ", text_color=sess_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 4, "  Position  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 4, "  " + pos_txt + "  ", text_color=pos_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 5, "  Grade min.  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 5, "  " + min_grade_in + "  ", text_color=color_lux_gold, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)