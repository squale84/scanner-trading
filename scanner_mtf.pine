//@version=5
// VERSION DU SCRIPT — à comparer avec ce que Claude annonce à chaque envoi de fichier.
// Visible en permanence dans le titre sur le graphique (légende en haut à gauche), sans avoir
// besoin d'ouvrir l'éditeur. Change ce numéro à CHAQUE modification envoyée par Claude.
SCRIPT_VERSION = "R6.1"

// Version EN TÊTE du nom : la liste « Mes scripts » de TradingView coupe les noms trop longs.
indicator("Radar ICT R6.1 — Terminal Pro MTF H1-M5", shorttitle="Radar ICT R6.1", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200, max_bars_back=1000)

// ==========================================
// 1. CONFIGURATION GÉNÉRALE & PARAMÈTRES
// ==========================================
grp_radar     = "Configuration Terminal Radar"
asset_name_in = input.string("", title="Symbole Terminal (vide = auto)", group=grp_radar)
asset_name    = asset_name_in != "" ? asset_name_in : (syminfo.ticker == "XAUUSD" ? "GOLD" : syminfo.ticker)
rr_ratio      = input.float(2.0, title="Ratio Risque / Récompense (TP)", minval=1.0, step=0.5, group=grp_radar)
is_crypto_247 = input.bool(true, title="Mode Métaux / Continu (Ignore Killzones)", group=grp_radar)
min_grade_in  = input.string("A", title="Grade Minimum pour Alerte", options=["B", "A", "A+"], group=grp_radar)
ema_flat_thr  = input.float(0.08, title="Seuil Pente EMA H1 (x ATR)", step=0.01, group=grp_radar)
atr_cap_mult  = input.float(2.5, title="Plafond Stop-Loss (x ATR M5)", minval=0.5, step=0.1, group=grp_radar)
atr_floor_mult = input.float(0.5, title="Plancher Stop-Loss (x ATR M5)", minval=0.1, step=0.1, group=grp_radar)
zone_window_in   = input.int(20, title="Fenêtre de validité contexte H1 (barres M5)", minval=5, maxval=50, group=grp_radar)
cooldown_bars_in = input.int(10, title="Cooldown entre signaux (barres M5)", minval=1, maxval=50, group=grp_radar)
causal_fvg_window_in = input.int(3, title="Fenêtre de formation FVG causale après displacement (barres M5)", minval=1, maxval=10, group=grp_radar)
disp_body_ratio_min_in = input.float(0.60, title="Displacement : ratio corps/range minimum", minval=0.3, maxval=0.9, step=0.05, group=grp_radar)
disp_atr_mult_min_in   = input.float(1.0, title="Displacement : corps minimum (x ATR M5)", minval=0.3, maxval=2.0, step=0.05, group=grp_radar)
sweep_to_mss_window_in  = input.int(18, title="Fenêtre sweep -> displacement (barres M5)", minval=6, maxval=40, group=grp_radar)
fvg_to_retest_window_in = input.int(20, title="Fenêtre FVG causale -> retest (barres M5)", minval=5, maxval=50, group=grp_radar)

grp_ui        = "Affichage Graphique ICT"
show_fvg      = input.bool(true, title="Afficher FVG H1", group=grp_ui)
show_fvg_m5   = input.bool(true, title="Afficher FVG M5", group=grp_ui)
show_mss      = input.bool(true, title="Afficher CHoCH / BOS", group=grp_ui)
show_ob       = input.bool(true, title="Afficher Order Blocks (M5)", group=grp_ui)
show_eqh_eql  = input.bool(true, title="Afficher EQH / EQL (Liquidité)", group=grp_ui)
show_levels   = input.bool(true, title="Afficher PDH / PDL / NY Midnight", group=grp_ui)
show_risk_zone = input.bool(true, title="Afficher zone SL/TP du trade actif", group=grp_ui)
ob_filter_dp  = input.bool(false, title="N'afficher que les OB en discount/premium", group=grp_ui)
show_ote      = input.bool(false, title="Afficher zone OTE (Fibo 61.8%-79%)", group=grp_ui)
range_lookback = input.int(100, title="Range Discount/Premium (barres M5)", minval=20, maxval=500, group=grp_ui)
fvg_mitigation_mode = input.string("Mèche", title="Mode de mitigation FVG/OB", options=["Mèche", "Corps", "Clôture"], group=grp_ui)
max_zones_in  = input.int(3, title="Nombre max de zones actives par catégorie (OB/FVG)", minval=1, maxval=30, group=grp_ui)

grp_dash      = "Tableau de Bord"
show_dashboard = input.bool(true, title="Afficher le tableau de bord", group=grp_dash)

grp_sessions  = "Sessions ICT (Heure New York UTC-4)"
sess_london   = input.session("0200-0500:23456", title="London Open", group=grp_sessions)
sess_ny       = input.session("0800-1130:23456", title="NY AM", group=grp_sessions)

in_london    = not na(time(timeframe.period, sess_london, "America/New_York"))
in_ny        = not na(time(timeframe.period, sess_ny, "America/New_York"))
trade_window = is_crypto_247 or in_london or in_ny

bgcolor(in_london ? color.new(#00bcd4, 96) : na, title="Bg Londres")
bgcolor(in_ny ? color.new(#ff9800, 96) : na, title="Bg New York")

// ==========================================
// THÈME VISUEL — aligné sur la palette du dashboard HTML (index.html)
// ==========================================
color_lux_bull  = color.new(#00E08A, 0)  // Vert — identique --accent-green
color_lux_bear  = color.new(#FF4569, 0)  // Rouge — identique --accent-red
color_lux_liq   = color.new(#2F6BFF, 0)  // Bleu — identique --accent-blue (EQH/EQL)
color_lux_gold  = color.new(#FFC73C, 0)  // Or — identique --accent-gold (NY Open, FVG H1, grade A+)
color_lux_level = color.new(#8B96A5, 30) // Gris — identique --text-muted (PDH/PDL)
color_panel_bg  = color.new(#0D1117, 8)  // Fond panneau — identique --bg-elevated
color_panel_bd  = color.new(#1C2430, 0)  // Bordure panneau — identique --border-color
color_ob_bull   = color.new(#2F6BFF, 0)  // Bleu — Order Block acheteur
color_ob_bear   = color.new(#FF6EC7, 0)  // Rose — Order Block vendeur

// ==========================================
// GESTIONNAIRE DE ZONES FVG/OB — PATCH 4 : couche graphique unifiée
// ==========================================
// Remplace les anciens slots uniques + tableaux "extra" (qui rendaient le principal OB
// remplaçant systématiquement le précédent) par un cycle de vie identique pour les 6
// catégories de zones : box/top/bottom/barre de naissance dans des tableaux parallèles
// plafonnés à max_zones_in. "top" est toujours le prix haut réel de la zone, "bottom" le
// prix bas réel (contrairement à l'ancien code où ces noms étaient inversés pour les FVG).
// Aucune de ces variables n'est lue par le moteur d'entrée (vérifié : la machine à états
// causale ne référence plus mitigated_ob_*/mitigated_fvg_*/is_ob_*_active depuis son
// remplacement de l'ancien système setup_mtf_*/setup_ict_*).
var box[]   zn_h1fvg_bull_box   = array.new_box()
var float[] zn_h1fvg_bull_top   = array.new_float()
var float[] zn_h1fvg_bull_bot   = array.new_float()
var int[]   zn_h1fvg_bull_birth = array.new_int()

var box[]   zn_h1fvg_bear_box   = array.new_box()
var float[] zn_h1fvg_bear_top   = array.new_float()
var float[] zn_h1fvg_bear_bot   = array.new_float()
var int[]   zn_h1fvg_bear_birth = array.new_int()

var box[]   zn_m5fvg_bull_box   = array.new_box()
var float[] zn_m5fvg_bull_top   = array.new_float()
var float[] zn_m5fvg_bull_bot   = array.new_float()
var int[]   zn_m5fvg_bull_birth = array.new_int()

var box[]   zn_m5fvg_bear_box   = array.new_box()
var float[] zn_m5fvg_bear_top   = array.new_float()
var float[] zn_m5fvg_bear_bot   = array.new_float()
var int[]   zn_m5fvg_bear_birth = array.new_int()

var box[]   zn_ob_bull_box   = array.new_box()
var float[] zn_ob_bull_top   = array.new_float()
var float[] zn_ob_bull_bot   = array.new_float()
var int[]   zn_ob_bull_birth = array.new_int()

var box[]   zn_ob_bear_box   = array.new_box()
var float[] zn_ob_bear_top   = array.new_float()
var float[] zn_ob_bear_bot   = array.new_float()
var int[]   zn_ob_bear_birth = array.new_int()

// FVG en jaune (demande explicite de longue date) — bordure plus marquée en H1, plus légère en M5.
// Bull/bear ne sont pas distingués par teinte ici : la direction se lit sur les OB (bleu/rose)
// et sur le sens du prix ; jaune reste la couleur d'identification unique de la FVG.
color_fvg_yellow      = #FFD400
color_fvg_bull_h1_bg = color.new(color_fvg_yellow, 55)
color_fvg_bull_h1_bd = color.new(color_fvg_yellow, 20)
color_fvg_bull_m5_bg = color.new(color_fvg_yellow, 78)
color_fvg_bull_m5_bd = color.new(color_fvg_yellow, 55)
color_fvg_bear_h1_bg = color.new(color_fvg_yellow, 55)
color_fvg_bear_h1_bd = color.new(color_fvg_yellow, 20)
color_fvg_bear_m5_bg = color.new(color_fvg_yellow, 78)
color_fvg_bear_m5_bd = color.new(color_fvg_yellow, 55)
color_ob_bull_bg = color.new(color_ob_bull, 72)
color_ob_bull_bd = color.new(color_ob_bull, 30)
color_ob_bear_bg = color.new(color_ob_bear, 72)
color_ob_bear_bd = color.new(color_ob_bear, 30)

// Ajoute une zone (jusqu'à max_zones_in ; au-delà, la plus ancienne est retirée et sa boîte supprimée)
f_zone_push(box_arr, top_arr, bot_arr, birth_arr, new_box, new_top, new_bot, maxN) =>
    array.push(box_arr, new_box)
    array.push(top_arr, new_top)
    array.push(bot_arr, new_bot)
    array.push(birth_arr, bar_index)
    if array.size(box_arr) > maxN
        old_box = array.shift(box_arr)
        array.shift(top_arr)
        array.shift(bot_arr)
        array.shift(birth_arr)
        if not na(old_box)
            box.delete(old_box)

// Mitigation = premier retour dans la zone selon la sonde Mèche/Corps/Clôture (mit_probe_bull/bear),
// jamais testée sur la barre de naissance. À mitigation : suppression complète de la boîte (le
// gris de diagnostic a confirmé que la détection se déclenche correctement — plus besoin de le
// garder affiché). Seules les zones non mitigées restent visibles à l'écran.
f_mitigate_bull_zones(box_arr, top_arr, bot_arr, birth_arr, probe) =>
    i = array.size(box_arr) - 1
    while i >= 0
        if bar_index > array.get(birth_arr, i) and probe <= array.get(top_arr, i)
            bx = array.get(box_arr, i)
            if not na(bx)
                box.delete(bx)
            array.remove(box_arr, i)
            array.remove(top_arr, i)
            array.remove(bot_arr, i)
            array.remove(birth_arr, i)
        i -= 1

f_mitigate_bear_zones(box_arr, top_arr, bot_arr, birth_arr, probe) =>
    i = array.size(box_arr) - 1
    while i >= 0
        if bar_index > array.get(birth_arr, i) and probe >= array.get(bot_arr, i)
            bx = array.get(box_arr, i)
            if not na(bx)
                box.delete(bx)
            array.remove(box_arr, i)
            array.remove(top_arr, i)
            array.remove(bot_arr, i)
            array.remove(birth_arr, i)
        i -= 1

// ==========================================
// 2. EXTRACTION HTF H1 : FVG, BIAIS & BOS
// ==========================================
// Regroupement propre des requêtes de sécurité H1
f_get_h1_data() =>
    h1_atr      = ta.atr(14)
    h1_ema      = ta.ema(close, 50)
    h1_ph       = ta.pivothigh(high, 3, 3)
    h1_pl       = ta.pivotlow(low, 3, 3)
    [high[1], low[1], high[3], low[3], close[1], h1_ema[1], h1_ema[2], h1_atr[1], h1_ph[1], h1_pl[1]]

[h1_high, h1_low, h1_high2, h1_low2, h1_close, h1_ema, h1_ema_prev, h1_atr, h1_ph, h1_pl] = request.security(syminfo.tickerid, "60", f_get_h1_data(), barmerge.gaps_off, barmerge.lookahead_off)

// --- Filtre Anti-Range / Anti-Chop (EMA 50 H1) ---
h1_ema_flat  = math.abs(h1_ema - h1_ema_prev) < (h1_atr * ema_flat_thr)
h1_bias_bull = (h1_close > h1_ema) and not h1_ema_flat
h1_bias_bear = (h1_close < h1_ema) and not h1_ema_flat

// --- Détection BOS H1 ---
var float h1_last_ph = na
var float h1_last_pl = na

if ta.change(time("60"))
    if not na(h1_ph)
        h1_last_ph := h1_ph
    if not na(h1_pl)
        h1_last_pl := h1_pl

h1_bos_bull = ta.change(time("60")) and not na(h1_last_ph) and h1_close > h1_last_ph
h1_bos_bear = ta.change(time("60")) and not na(h1_last_pl) and h1_close < h1_last_pl

if h1_bos_bull
    h1_last_ph := na
if h1_bos_bear
    h1_last_pl := na

// --- Détection FVG H1 (Filtre anti micro-FVG > 0.5 ATR) ---
h1_fvg_bull = (h1_low > h1_high2) and ((h1_low - h1_high2) > (0.5 * h1_atr))
h1_fvg_bear = (h1_high < h1_low2) and ((h1_low2 - h1_high) > (0.5 * h1_atr))

// --- Machine à états HTF (Consommation de zone) — MOTEUR, ne pas toucher : alimente
// tested_h1_bull/bear donc le grade des entrées (RETEST vs SWEEP). Le dessin de la FVG H1
// est géré séparément plus bas (PATCH 4, purement visuel, sans effet sur ces variables).
var float h1_bull_zone_top = na
var float h1_bull_zone_bot = na
var bool  h1_bull_consumed = false

var float h1_bear_zone_top = na
var float h1_bear_zone_bot = na
var bool  h1_bear_consumed = false

color_ote = color.new(#A78BFA, 60) // Violet — opacité renforcée (88 était quasi invisible sur fond clair), distinct du jaune FVG

if ta.change(time("60"))
    // Bull Zone (suivi moteur — inchangé)
    if h1_fvg_bull
        is_new_fvg = na(h1_bull_zone_bot) or (h1_low != h1_bull_zone_top) or (h1_high2 != h1_bull_zone_bot)
        if is_new_fvg
            h1_bull_zone_top := h1_low
            h1_bull_zone_bot := h1_high2
            h1_bull_consumed := false
        // Dessin (multi-zones, indépendant du suivi moteur ci-dessus)
        if show_fvg
            new_h1_box = box.new(bar_index, h1_low, bar_index + 1, h1_high2, border_color=color_fvg_bull_h1_bd, bgcolor=color_fvg_bull_h1_bg, extend=extend.right)
            f_zone_push(zn_h1fvg_bull_box, zn_h1fvg_bull_top, zn_h1fvg_bull_bot, zn_h1fvg_bull_birth, new_h1_box, h1_low, h1_high2, max_zones_in)

    // Bear Zone (suivi moteur — inchangé)
    if h1_fvg_bear
        is_new_fvg = na(h1_bear_zone_top) or (h1_low2 != h1_bear_zone_top) or (h1_high != h1_bear_zone_bot)
        if is_new_fvg
            h1_bear_zone_top := h1_low2
            h1_bear_zone_bot := h1_high
            h1_bear_consumed := false
        // Dessin (multi-zones, indépendant du suivi moteur ci-dessus)
        if show_fvg
            new_h1_box = box.new(bar_index, h1_low2, bar_index + 1, h1_high, border_color=color_fvg_bear_h1_bd, bgcolor=color_fvg_bear_h1_bg, extend=extend.right)
            f_zone_push(zn_h1fvg_bear_box, zn_h1fvg_bear_top, zn_h1fvg_bear_bot, zn_h1fvg_bear_birth, new_h1_box, h1_low2, h1_high, max_zones_in)

in_h1_bull_zone = not h1_bull_consumed and not na(h1_bull_zone_top) and (high >= h1_bull_zone_bot and low <= h1_bull_zone_top)
in_h1_bear_zone = not h1_bear_consumed and not na(h1_bear_zone_top) and (high >= h1_bear_zone_bot and low <= h1_bear_zone_top)

// Invalidation dès que le prix retourne dans la zone (mitigation), cohérent avec la logique OB/FVG M5
if in_h1_bull_zone
    h1_bull_consumed := true
if in_h1_bear_zone
    h1_bear_consumed := true

// ==========================================
// 2.5 NIVEAUX MAJEURS (PDH, PDL, NY OPEN) — PATCH 1 : couche graphique persistante
// ==========================================
// Bug corrigé : time("D", "America/New_York") passait "America/New_York" dans le paramètre
// `session` (2e position), pas `timezone` (3e position) — la frontière de journée ne suivait
// donc pas réellement minuit New York. Fix : session vide ("") en 2e position pour libérer
// la 3e position, qui reçoit alors vraiment le fuseau horaire.
// Rendu corrigé : les lignes/labels étaient recréés une fois par jour avec une longueur fixe
// (bar_index + 288) au lieu d'être des objets persistants qui suivent le bord droit — le label
// restait visuellement figé près du début de journée. Remplacé par des objets `var` réutilisés
// (extend.right pour la ligne, repositionnement du label à chaque barre), ce qui élimine aussi
// l'accumulation d'un nouveau couple ligne/label par jour (risque de saturation max_lines_count).
var float pdh = na
var float pdl = na
var float current_dh = na
var float current_dl = na
var float ny_open_val = na

color_level_visible = color.new(#AEB9C7, 0) // gris clair pleinement opaque, lisible (remplace l'ancien quasi invisible)

is_new_ny_day = ta.change(time("D", "", "America/New_York"))

if is_new_ny_day
    pdh := current_dh
    pdl := current_dl
    current_dh := high
    current_dl := low
    ny_open_val := open
else
    if na(current_dh) or high > current_dh
        current_dh := high
    if na(current_dl) or low < current_dl
        current_dl := low

// --- Discount / Premium (sur un range glissant) — sert uniquement au filtre OB (ob_filter_dp) ---
range_high = ta.highest(high, range_lookback)
range_low  = ta.lowest(low, range_lookback)
eq_level = (range_high + range_low) / 2

// Rendu PDH / PDL / NY Open : objets persistants, ligne en extend.right, label repositionné
// chaque barre pour suivre le bord droit (comme un indicateur LuxAlgo).
var line  vis_pdh_line     = na
var label vis_pdh_label    = na
var line  vis_pdl_line     = na
var label vis_pdl_label    = na
var line  vis_nyopen_line  = na
var label vis_nyopen_label = na

if show_levels and not na(pdh)
    if na(vis_pdh_line)
        vis_pdh_line  := line.new(bar_index, pdh, bar_index, pdh, color=color_level_visible, width=1, style=line.style_dotted, extend=extend.right)
        vis_pdh_label := label.new(bar_index, pdh, "PDH", color=color.new(color.white, 100), textcolor=color_level_visible, style=label.style_label_left, size=size.small)
    else if is_new_ny_day
        line.set_xy1(vis_pdh_line, bar_index, pdh)
        line.set_xy2(vis_pdh_line, bar_index, pdh)
    label.set_xy(vis_pdh_label, bar_index + 3, pdh)

if show_levels and not na(pdl)
    if na(vis_pdl_line)
        vis_pdl_line  := line.new(bar_index, pdl, bar_index, pdl, color=color_level_visible, width=1, style=line.style_dotted, extend=extend.right)
        vis_pdl_label := label.new(bar_index, pdl, "PDL", color=color.new(color.white, 100), textcolor=color_level_visible, style=label.style_label_left, size=size.small)
    else if is_new_ny_day
        line.set_xy1(vis_pdl_line, bar_index, pdl)
        line.set_xy2(vis_pdl_line, bar_index, pdl)
    label.set_xy(vis_pdl_label, bar_index + 3, pdl)

if show_levels and not na(ny_open_val)
    if na(vis_nyopen_line)
        vis_nyopen_line  := line.new(bar_index, ny_open_val, bar_index, ny_open_val, color=color.new(color_lux_gold, 20), width=1, style=line.style_dashed, extend=extend.right)
        vis_nyopen_label := label.new(bar_index, ny_open_val, "NY Open", color=color.new(color.white, 100), textcolor=color_lux_gold, style=label.style_label_left, size=size.small)
    else if is_new_ny_day
        line.set_xy1(vis_nyopen_line, bar_index, ny_open_val)
        line.set_xy2(vis_nyopen_line, bar_index, ny_open_val)
    label.set_xy(vis_nyopen_label, bar_index + 3, ny_open_val)

// ==========================================
// 3. STRUCTURE M5 & CONFIRMATION DE REJET
// ==========================================
atr_val       = ta.atr(14)
bar_confirmed = barstate.isconfirmed

// --- Sonde de mitigation (Mèche/Corps/Clôture) — porté du moteur V48 (Projet_ECC_Test) ---
mit_probe_bull = fvg_mitigation_mode == "Mèche" ? low : fvg_mitigation_mode == "Corps" ? math.min(open, close) : close
mit_probe_bear = fvg_mitigation_mode == "Mèche" ? high : fvg_mitigation_mode == "Corps" ? math.max(open, close) : close

// Pivots M5
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

var float last_ph     = na
var int   last_ph_bar = na
var float prev_ph     = na
var int   prev_ph_bar = na
var float lowest_since_ph = na
var float ob_bull_top = na
var float ob_bull_bot = na
var int   ob_bull_bar = na

if not na(ph)
    prev_ph := last_ph
    prev_ph_bar := last_ph_bar
    last_ph := ph
    last_ph_bar := bar_index - 5
    ob_bull_bot := low
    ob_bull_top := high
    ob_bull_bar := bar_index
    lowest_since_ph := low
    
    // Détection EQH
    if show_eqh_eql and not na(prev_ph) and math.abs(last_ph - prev_ph) <= (syminfo.mintick * 15)
        line.new(prev_ph_bar, prev_ph, bar_index, prev_ph, color=color_lux_liq, width=1)
        label.new(math.round((prev_ph_bar + bar_index)/2), prev_ph, "EQH 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bull_bot)
    if low <= ob_bull_bot
        ob_bull_bot := low
        ob_bull_top := high
        ob_bull_bar := bar_index
        lowest_since_ph := low

var float last_pl     = na
var int   last_pl_bar = na
var float prev_pl     = na
var int   prev_pl_bar = na
var float highest_since_pl = na
var float ob_bear_top = na
var float ob_bear_bot = na
var int   ob_bear_bar = na
var int   last_struct_dir = 0 // 1 = Bull, -1 = Bear

if not na(pl)
    prev_pl := last_pl
    prev_pl_bar := last_pl_bar
    last_pl := pl
    last_pl_bar := bar_index - 5
    ob_bear_top := high
    ob_bear_bot := low
    ob_bear_bar := bar_index
    highest_since_pl := high
    
    // Détection EQL
    if show_eqh_eql and not na(prev_pl) and math.abs(last_pl - prev_pl) <= (syminfo.mintick * 15)
        line.new(prev_pl_bar, prev_pl, bar_index, prev_pl, color=color_lux_liq, width=1)
        label.new(math.round((prev_pl_bar + bar_index)/2), prev_pl, "EQL 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bear_top)
    if high >= ob_bear_top
        ob_bear_top := high
        ob_bear_bot := low
        ob_bear_bar := bar_index
        highest_since_pl := high

c_range = high - low
c_body  = math.abs(close - open)
is_disp = c_range > 0 and ((c_body / c_range) >= 0.50)

// --- Pivots persistants indépendants — JAMAIS réinitialisés par les événements MSS du moteur
// (contrairement à last_ph/last_pl, consommés/remis à na dès que la détection d'affichage
// mss_bull/mss_bear les utilise, laquelle a un seuil bien plus permissif — is_disp 50% —
// que le moteur causal — is_disp_quant 65% + 1,25x ATR). Sans cette copie séparée, le moteur
// causal capturait souvent un buy_mss_level/sell_mss_level déjà à na au moment du sweep,
// bloquant silencieusement la détection de displacement. BUG CORRIGÉ : le sweep et le niveau
// de cassure du moteur causal utilisent maintenant CES pivots, pas last_ph/last_pl.
var float vis_last_ph = na
var float vis_prev_ph = na
var float vis_last_pl = na
var float vis_prev_pl = na

if not na(ph)
    vis_prev_ph := vis_last_ph
    vis_last_ph := ph
if not na(pl)
    vis_prev_pl := vis_last_pl
    vis_last_pl := pl

// Balayage de liquidité (Sweeps de mèches M5)
wick_top = high - math.max(open, close)
wick_bot = math.min(open, close) - low
rej_buy  = c_range > 0 and (wick_bot / c_range) >= 0.35 and close > open
rej_sell = c_range > 0 and (wick_top / c_range) >= 0.35 and close < open

sweep_l = not na(vis_last_pl) and low < vis_last_pl and close > vis_last_pl and rej_buy
sweep_h = not na(vis_last_ph) and high > vis_last_ph and close < vis_last_ph and rej_sell

// --- Structure HH/HL/LH/LL (basée sur les mêmes pivots persistants ci-dessus) pour la zone OTE.
is_hh = not na(vis_last_ph) and not na(vis_prev_ph) and vis_last_ph > vis_prev_ph
is_lh = not na(vis_last_ph) and not na(vis_prev_ph) and vis_last_ph < vis_prev_ph
is_hl = not na(vis_last_pl) and not na(vis_prev_pl) and vis_last_pl > vis_prev_pl
is_ll = not na(vis_last_pl) and not na(vis_prev_pl) and vis_last_pl < vis_prev_pl

// --- Zone OTE (61.8%-79%) de la DERNIÈRE impulsion structurelle, pas d'une plage glissante.
// Impulsion haussière = jambe partant d'un Higher Low (HL) jusqu'au plus haut atteint depuis
// (qui deviendra un Higher High). Impulsion baissière = jambe partant d'un Lower High (LH)
// jusqu'au plus bas atteint depuis (qui deviendra un Lower Low).
var float vis_ote_low_bull  = na  // le HL d'origine
var float vis_ote_high_bull = na  // plus haut atteint depuis ce HL
var float vis_ote_high_bear = na  // le LH d'origine
var float vis_ote_low_bear  = na  // plus bas atteint depuis ce LH
var string vis_ote_dir      = "NONE"

if is_hl
    vis_ote_low_bull  := vis_last_pl
    vis_ote_high_bull := high
    vis_ote_dir       := "BULL"
else if vis_ote_dir == "BULL" and not na(vis_ote_high_bull) and high > vis_ote_high_bull
    vis_ote_high_bull := high

if is_lh
    vis_ote_high_bear := vis_last_ph
    vis_ote_low_bear  := low
    vis_ote_dir       := "BEAR"
else if vis_ote_dir == "BEAR" and not na(vis_ote_low_bear) and low < vis_ote_low_bear
    vis_ote_low_bear := low

ote_top = vis_ote_dir == "BULL" ? vis_ote_high_bull - (vis_ote_high_bull - vis_ote_low_bull) * 0.618 : vis_ote_dir == "BEAR" ? vis_ote_low_bear + (vis_ote_high_bear - vis_ote_low_bear) * 0.79 : na
ote_bot = vis_ote_dir == "BULL" ? vis_ote_high_bull - (vis_ote_high_bull - vis_ote_low_bull) * 0.79 : vis_ote_dir == "BEAR" ? vis_ote_low_bear + (vis_ote_high_bear - vis_ote_low_bear) * 0.618 : na

var box ote_box = na
new_impulse = is_hl or is_lh
if show_ote and not na(ote_top) and not na(ote_bot)
    if na(ote_box)
        ote_box := box.new(bar_index, ote_top, bar_index + 1, ote_bot, border_color=na, bgcolor=color_ote, extend=extend.right)
    else
        box.set_top(ote_box, ote_top)
        box.set_bottom(ote_box, ote_bot)
        // Bord gauche réinitialisé UNIQUEMENT sur une nouvelle impulsion (nouveau HL/LH) —
        // sinon la boîte s'étirerait depuis le tout premier pivot du graphique.
        if new_impulse
            box.set_left(ote_box, bar_index)

// Mémoire de zone H1 touchée récemment (15 barres M5)
bars_in_h1_bull = ta.barssince(in_h1_bull_zone)
bars_in_h1_bear = ta.barssince(in_h1_bear_zone)
tested_h1_bull  = not na(bars_in_h1_bull) and bars_in_h1_bull <= zone_window_in
tested_h1_bear  = not na(bars_in_h1_bear) and bars_in_h1_bear <= zone_window_in

// Contexte d'affichage filtré (Évite le bruit graphique)
valid_ctx_bull = tested_h1_bull or (h1_bias_bull and not na(ta.barssince(sweep_l)) and ta.barssince(sweep_l) <= zone_window_in)
valid_ctx_bear = tested_h1_bear or (h1_bias_bear and not na(ta.barssince(sweep_h)) and ta.barssince(sweep_h) <= zone_window_in)

// MSS / CHoCH en M5 — condition et resets last_ph/last_pl/last_struct_dir INCHANGÉS (lus par
// sweep_l/sweep_h, donc par la machine à états causale). Seul le dessin de l'OB change (PATCH 4).
mss_bull = not na(last_ph) and bar_confirmed and ta.crossover(close, last_ph) and is_disp
if mss_bull
    // On ne trace QUE s'il sort d'une zone H1 testée
    if tested_h1_bull
        if show_mss
            is_choch = (last_struct_dir != 1)
            lbl_text = is_choch ? "⇄ CHoCH" : "➤ BOS"
            line.new(last_ph_bar, last_ph, bar_index, last_ph, color=color_lux_bull, width=3, style=line.style_dashed)
            label.new(math.round((last_ph_bar + bar_index)/2), last_ph, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bull, style=label.style_none, size=size.normal)
    // Order Block acheteur : un seul gestionnaire, plusieurs zones peuvent coexister
    // (avant : le slot "officiel" nécessitait tested_h1_bull et écrasait le précédent)
    if not na(ob_bull_bot)
        ob_bull_relevant = not ob_filter_dp or na(eq_level) or (ob_bull_top <= eq_level)
        if show_ob and ob_bull_relevant
            new_ob_box = box.new(ob_bull_bar, ob_bull_top, bar_index, ob_bull_bot, border_color=color_ob_bull_bd, bgcolor=color_ob_bull_bg, extend=extend.right)
            f_zone_push(zn_ob_bull_box, zn_ob_bull_top, zn_ob_bull_bot, zn_ob_bull_birth, new_ob_box, ob_bull_top, ob_bull_bot, max_zones_in)
    last_ph := na
    last_struct_dir := 1

mss_bear = not na(last_pl) and bar_confirmed and ta.crossunder(close, last_pl) and is_disp
if mss_bear
    // On ne trace QUE s'il sort d'une zone H1 testée
    if tested_h1_bear
        if show_mss
            is_choch = (last_struct_dir != -1)
            lbl_text = is_choch ? "⇄ CHoCH" : "➤ BOS"
            line.new(last_pl_bar, last_pl, bar_index, last_pl, color=color_lux_bear, width=3, style=line.style_dashed)
            label.new(math.round((last_pl_bar + bar_index)/2), last_pl, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bear, style=label.style_none, size=size.normal)
    // Order Block vendeur : un seul gestionnaire, plusieurs zones peuvent coexister
    if not na(ob_bear_top)
        ob_bear_relevant = not ob_filter_dp or na(eq_level) or (ob_bear_bot >= eq_level)
        if show_ob and ob_bear_relevant
            new_ob_box = box.new(ob_bear_bar, ob_bear_top, bar_index, ob_bear_bot, border_color=color_ob_bear_bd, bgcolor=color_ob_bear_bg, extend=extend.right)
            f_zone_push(zn_ob_bear_box, zn_ob_bear_top, zn_ob_bear_bot, zn_ob_bear_birth, new_ob_box, ob_bear_top, ob_bear_bot, max_zones_in)
    last_pl := na
    last_struct_dir := -1

// FVG en M5 — zones multiples, plus de distinction "officiel/extra". valid_ctx_* retiré du
// filtre par défaut (n'empêche plus l'affichage) ; show_fvg_m5 reste le seul interrupteur.
fvg_bull_m5 = (low > high[2]) and (low - high[2] >= atr_val * 0.15)
if fvg_bull_m5 and show_fvg_m5
    new_fvg_box = box.new(bar_index - 2, low, bar_index, high[2], border_color=color_fvg_bull_m5_bd, bgcolor=color_fvg_bull_m5_bg, extend=extend.right)
    f_zone_push(zn_m5fvg_bull_box, zn_m5fvg_bull_top, zn_m5fvg_bull_bot, zn_m5fvg_bull_birth, new_fvg_box, low, high[2], max_zones_in)

fvg_bear_m5 = (high < low[2]) and (low[2] - high >= atr_val * 0.15)
if fvg_bear_m5 and show_fvg_m5
    new_fvg_box = box.new(bar_index - 2, low[2], bar_index, high, border_color=color_fvg_bear_m5_bd, bgcolor=color_fvg_bear_m5_bg, extend=extend.right)
    f_zone_push(zn_m5fvg_bear_box, zn_m5fvg_bear_top, zn_m5fvg_bear_bot, zn_m5fvg_bear_birth, new_fvg_box, low[2], high, max_zones_in)

// Mitigation de toutes les zones (premier retour dans la zone) — suppression complète, OB et
// FVG traités à l'identique : seules les zones non mitigées restent affichées.
f_mitigate_bull_zones(zn_ob_bull_box, zn_ob_bull_top, zn_ob_bull_bot, zn_ob_bull_birth, mit_probe_bull)
f_mitigate_bear_zones(zn_ob_bear_box, zn_ob_bear_top, zn_ob_bear_bot, zn_ob_bear_birth, mit_probe_bear)
f_mitigate_bull_zones(zn_m5fvg_bull_box, zn_m5fvg_bull_top, zn_m5fvg_bull_bot, zn_m5fvg_bull_birth, mit_probe_bull)
f_mitigate_bear_zones(zn_m5fvg_bear_box, zn_m5fvg_bear_top, zn_m5fvg_bear_bot, zn_m5fvg_bear_birth, mit_probe_bear)
f_mitigate_bull_zones(zn_h1fvg_bull_box, zn_h1fvg_bull_top, zn_h1fvg_bull_bot, zn_h1fvg_bull_birth, mit_probe_bull)
f_mitigate_bear_zones(zn_h1fvg_bear_box, zn_h1fvg_bear_top, zn_h1fvg_bear_bot, zn_h1fvg_bear_birth, mit_probe_bear)

// ==========================================
// 3.9 CIBLES DE LIQUIDITÉ (TP STRUCTURELS) — R6 / B7
// ==========================================
// Les TP ne sont plus des multiples fixes du risque : on vise la liquidité suivante dans le sens
// du trade (buy-side au-dessus pour un achat, sell-side en dessous pour une vente) : pivots M5,
// equal highs / equal lows, swing H1, plus haut / bas des sessions Asie et Londres, PDH / PDL,
// FVG opposées non comblées (M5 et H1). Un trade n'est pris que s'il existe au moins une cible à
// min_rr_in R ou plus. Bloc IDENTIQUE dans le Radar et le Backtest, indépendant des options
// d'affichage (les FVG / EQH dessinées ne sont pas lues ici).
grp_tp        = "Cibles de profit (liquidité)"
tp_mode_in    = input.string("Liquidité", title="Mode des TP", options=["Liquidité", "Fixe (R:R)"], group=grp_tp)
min_rr_in     = input.float(1.5, title="R:R minimum exigé pour prendre le trade", minval=0.5, step=0.1, group=grp_tp)
min_tp_r_in   = input.float(1.0, title="Distance minimale d'un TP (en R)", minval=0.3, step=0.1, group=grp_tp)
max_tp_in     = input.int(4, title="Nombre maximum de TP", minval=1, maxval=6, group=grp_tp)
LIQ_MAX       = 40   // niveaux de liquidité mémorisés par côté
FVG_MAX       = 30   // FVG M5 mémorisées par côté

var float[]  liq_up_px    = array.new_float()   // buy-side : niveaux au-dessus du prix
var string[] liq_up_ty    = array.new_string()
var float[]  liq_dn_px    = array.new_float()   // sell-side : niveaux en dessous du prix
var string[] liq_dn_ty    = array.new_string()
var float[]  fvg_bear_bot = array.new_float()   // FVG baissières M5 (cible d'un achat = bord bas)
var float[]  fvg_bull_top = array.new_float()   // FVG haussières M5 (cible d'une vente = bord haut)

// Ajoute un niveau ; un niveau déjà présent à moins de `tol` est la même liquidité : on fusionne
// (deux pivots M5 proches = equal highs / equal lows ; un type plus fort remplace « Pivot M5 »).
f_liq_add(px_arr, ty_arr, price, typ, tol, is_up) =>
    merged = false
    n = array.size(px_arr)
    if n > 0
        for i = 0 to n - 1
            p = array.get(px_arr, i)
            if not merged and math.abs(p - price) <= tol
                merged := true
                old_ty = array.get(ty_arr, i)
                if typ == "Pivot M5"
                    if old_ty == "Pivot M5"
                        array.set(ty_arr, i, is_up ? "Equal highs" : "Equal lows")
                else if old_ty == "Pivot M5" or old_ty == "Equal highs" or old_ty == "Equal lows"
                    array.set(ty_arr, i, typ)
                array.set(px_arr, i, is_up ? math.max(p, price) : math.min(p, price))
    if not merged
        array.push(px_arr, price)
        array.push(ty_arr, typ)
        if array.size(px_arr) > LIQ_MAX
            array.shift(px_arr)
            array.shift(ty_arr)

// Un niveau traversé par le prix est consommé (la liquidité a été prise) : il ne sert plus de cible.
f_liq_sweep(px_arr, ty_arr, is_up) =>
    n = array.size(px_arr)
    if n > 0
        for i = n - 1 to 0
            p = array.get(px_arr, i)
            if (is_up and high > p) or (not is_up and low < p)
                array.remove(px_arr, i)
                array.remove(ty_arr, i)

f_fvg_mitigate(arr, is_bear_zone) =>
    n = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            p = array.get(arr, i)
            if (is_bear_zone and high >= p) or (not is_bear_zone and low <= p)
                array.remove(arr, i)

liq_tol = atr_val * 0.10

// 1) Consommation des niveaux déjà pris par la bougie courante
f_liq_sweep(liq_up_px, liq_up_ty, true)
f_liq_sweep(liq_dn_px, liq_dn_ty, false)
f_fvg_mitigate(fvg_bear_bot, true)
f_fvg_mitigate(fvg_bull_top, false)

// 2) Nouveaux niveaux : pivots M5 (confirmés 5 bougies plus tard, donc sous le prix actuel)
if not na(ph)
    f_liq_add(liq_up_px, liq_up_ty, ph, "Pivot M5", liq_tol, true)
if not na(pl)
    f_liq_add(liq_dn_px, liq_dn_ty, pl, "Pivot M5", liq_tol, false)

// Swing H1 (une seule fois par heure)
if ta.change(time("60"))
    if not na(h1_ph)
        f_liq_add(liq_up_px, liq_up_ty, h1_ph, "Swing H1", liq_tol, true)
    if not na(h1_pl)
        f_liq_add(liq_dn_px, liq_dn_ty, h1_pl, "Swing H1", liq_tol, false)

// PDH / PDL (au changement de journée New York)
if is_new_ny_day
    if not na(pdh)
        f_liq_add(liq_up_px, liq_up_ty, pdh, "PDH", liq_tol, true)
    if not na(pdl)
        f_liq_add(liq_dn_px, liq_dn_ty, pdl, "PDL", liq_tol, false)

// Plus haut / plus bas des sessions Asie (19h-minuit NY) et Londres, ajoutés à la fin de la session
in_asia_sess = not na(time(timeframe.period, "1900-2359:1234567", "America/New_York"))
var float asia_run_hi = na
var float asia_run_lo = na
if in_asia_sess
    asia_run_hi := not in_asia_sess[1] or na(asia_run_hi) ? high : math.max(asia_run_hi, high)
    asia_run_lo := not in_asia_sess[1] or na(asia_run_lo) ? low : math.min(asia_run_lo, low)
else if in_asia_sess[1] and not na(asia_run_hi)
    f_liq_add(liq_up_px, liq_up_ty, asia_run_hi, "Haut Asie", liq_tol, true)
    f_liq_add(liq_dn_px, liq_dn_ty, asia_run_lo, "Bas Asie", liq_tol, false)

var float lon_run_hi = na
var float lon_run_lo = na
if in_london
    lon_run_hi := not in_london[1] or na(lon_run_hi) ? high : math.max(lon_run_hi, high)
    lon_run_lo := not in_london[1] or na(lon_run_lo) ? low : math.min(lon_run_lo, low)
else if in_london[1] and not na(lon_run_hi)
    f_liq_add(liq_up_px, liq_up_ty, lon_run_hi, "Haut Londres", liq_tol, true)
    f_liq_add(liq_dn_px, liq_dn_ty, lon_run_lo, "Bas Londres", liq_tol, false)

// FVG M5 (même seuil de taille que la FVG causale : 0,15 x ATR)
if high < low[2] and (low[2] - high) >= atr_val * 0.15
    array.push(fvg_bear_bot, high)
    if array.size(fvg_bear_bot) > FVG_MAX
        array.shift(fvg_bear_bot)
if low > high[2] and (low - high[2]) >= atr_val * 0.15
    array.push(fvg_bull_top, low)
    if array.size(fvg_bull_top) > FVG_MAX
        array.shift(fvg_bull_top)

// Sélection des TP pour une entrée : cibles dans le sens du trade, triées par distance,
// à min_tp_r_in R minimum, fusionnées si trop proches (< 0,15 R). ok = au moins une cible
// à min_rr_in R ou plus ; elle est toujours conservée, même au-delà de max_tp_in.
f_select_targets(is_buy, entry, risk) =>
    c_px = array.new_float()
    c_ty = array.new_string()
    if is_buy
        if array.size(liq_up_px) > 0
            for i = 0 to array.size(liq_up_px) - 1
                if array.get(liq_up_px, i) > entry
                    array.push(c_px, array.get(liq_up_px, i))
                    array.push(c_ty, array.get(liq_up_ty, i))
        if array.size(fvg_bear_bot) > 0
            for i = 0 to array.size(fvg_bear_bot) - 1
                if array.get(fvg_bear_bot, i) > entry
                    array.push(c_px, array.get(fvg_bear_bot, i))
                    array.push(c_ty, "FVG M5")
        if not h1_bear_consumed and not na(h1_bear_zone_bot) and h1_bear_zone_bot > entry
            array.push(c_px, h1_bear_zone_bot)
            array.push(c_ty, "FVG H1")
    else
        if array.size(liq_dn_px) > 0
            for i = 0 to array.size(liq_dn_px) - 1
                if array.get(liq_dn_px, i) < entry
                    array.push(c_px, array.get(liq_dn_px, i))
                    array.push(c_ty, array.get(liq_dn_ty, i))
        if array.size(fvg_bull_top) > 0
            for i = 0 to array.size(fvg_bull_top) - 1
                if array.get(fvg_bull_top, i) < entry
                    array.push(c_px, array.get(fvg_bull_top, i))
                    array.push(c_ty, "FVG M5")
        if not h1_bull_consumed and not na(h1_bull_zone_top) and h1_bull_zone_top < entry
            array.push(c_px, h1_bull_zone_top)
            array.push(c_ty, "FVG H1")

    c_r = array.new_float()
    if array.size(c_px) > 0
        for i = 0 to array.size(c_px) - 1
            array.push(c_r, risk > 0 ? math.abs(array.get(c_px, i) - entry) / risk : 0.0)

    m_px = array.new_float()
    m_ty = array.new_string()
    m_r  = array.new_float()
    if array.size(c_r) > 0
        idx = array.sort_indices(c_r, order.ascending)
        for k = 0 to array.size(idx) - 1
            i = array.get(idx, k)
            r = array.get(c_r, i)
            if r >= min_tp_r_in
                last = array.size(m_r) - 1
                // Pine évalue les DEUX côtés d'un « and » : lecture de m_r seulement si elle contient une cible.
                too_close = false
                if last >= 0
                    too_close := r - array.get(m_r, last) < 0.15
                if too_close
                    old = array.get(m_ty, last)
                    if not str.contains(old, array.get(c_ty, i))
                        array.set(m_ty, last, old + " + " + array.get(c_ty, i))
                else
                    array.push(m_px, array.get(c_px, i))
                    array.push(m_ty, array.get(c_ty, i))
                    array.push(m_r, r)

    first_ok = -1
    if array.size(m_r) > 0
        for k = 0 to array.size(m_r) - 1
            if first_ok < 0 and array.get(m_r, k) >= min_rr_in
                first_ok := k

    o_px = array.new_float()
    o_ty = array.new_string()
    o_r  = array.new_float()
    if first_ok >= 0
        keep = math.min(array.size(m_r), max_tp_in)
        for k = 0 to keep - 1
            // Si la 1re cible valable (>= min_rr_in) est au-delà de max_tp_in, elle prend la dernière place.
            src = (k == keep - 1 and first_ok > keep - 1) ? first_ok : k
            array.push(o_px, array.get(m_px, src))
            array.push(o_ty, array.get(m_ty, src))
            array.push(o_r, array.get(m_r, src))
    [o_px, o_ty, o_r, first_ok >= 0]

// TP retenus pour le trade : cibles de liquidité, ou un TP unique à rr_ratio en mode « Fixe (R:R) »
// (comportement du R5). ok = false -> pas de cible de liquidité à min_rr_in R : trade abandonné.
f_trade_targets(is_buy, entry, risk) =>
    [t_px, t_ty, t_r, t_ok] = f_select_targets(is_buy, entry, risk)
    fixed = tp_mode_in != "Liquidité"
    if fixed
        array.clear(t_px)
        array.clear(t_ty)
        array.clear(t_r)
        array.push(t_px, entry + (is_buy ? 1 : -1) * risk * rr_ratio)
        array.push(t_ty, "R:R fixe")
        array.push(t_r, rr_ratio)
    [t_px, t_ty, t_r, fixed or t_ok]

// ==========================================
// 4. LOGIQUE CAUSALE ICT 2022 (MACHINE D'ETATS) & ENTREE
// ==========================================
// États de la séquence ICT 2022 :
// IDLE -> SWEEP_ARMED -> MSS_CONFIRMED -> CAUSAL_FVG_CONFIRMED -> WAIT_RETEST -> READY -> RESET
int STATE_IDLE                = 0
int STATE_SWEEP_ARMED         = 1
int STATE_MSS_CONFIRMED       = 2
int STATE_CAUSAL_FVG_CONFIRMED = 3
int STATE_WAIT_RETEST         = 4
int STATE_READY               = 5

// --- Machine d'état BUY (Long) ---
var int   buy_state            = STATE_IDLE
var int   buy_sweep_bar        = na
var float buy_sweep_low        = na
var float buy_mss_level        = na
var int   buy_displacement_bar = na
var float buy_pre_disp_high    = na  // haut de la bougie AVANT le displacement — ancre fixe de la FVG causale
var float buy_fvg_top          = na
var float buy_fvg_bottom       = na
var int   buy_fvg_bar          = na

// --- Machine d'état SELL (Short) ---
var int   sell_state            = STATE_IDLE
var int   sell_sweep_bar        = na
var float sell_sweep_high       = na
var float sell_mss_level        = na
var int   sell_displacement_bar = na
var float sell_pre_disp_low     = na  // bas de la bougie AVANT le displacement — ancre fixe de la FVG causale
var float sell_fvg_top          = na
var float sell_fvg_bottom       = na
var int   sell_fvg_bar          = na

// Définition quantitative du Displacement (M5) — seuils réglables (diagnostic du 18/09 : ce
// filtre éliminait plus de 90% des sweeps à lui seul, goulot d'étranglement principal du moteur).
// Référence ATR : atr_val[1]
disp_body_ratio = c_range > 0 ? (c_body / c_range) : 0.0
is_disp_quant   = (disp_body_ratio >= disp_body_ratio_min_in) and (c_body >= disp_atr_mult_min_in * atr_val[1])

// Timeouts maximaux (en barres M5) — réglables
MAX_BARS_SWEEP_TO_MSS = sweep_to_mss_window_in
MAX_BARS_FVG_TO_RETEST = fvg_to_retest_window_in

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : BUY
// -------------------------------------------------------------
// 1. Resets / Invalidations BUY
if buy_state != STATE_IDLE
    // Invalidation par nouveau plus bas sous le low du sweep
    if not na(buy_sweep_low) and low < buy_sweep_low
        buy_state := STATE_IDLE
    // Invalidation si sweep opposé (BSL) plus récent
    else if sweep_h
        buy_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if buy_state == STATE_SWEEP_ARMED and (bar_index - buy_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        buy_state := STATE_IDLE
    // Violation FVG causale (clôture sous le bas de la FVG causale avant exécution)
    else if (buy_state == STATE_CAUSAL_FVG_CONFIRMED or buy_state == STATE_WAIT_RETEST) and close < buy_fvg_bottom
        buy_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if buy_state == STATE_WAIT_RETEST and (bar_index - buy_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        buy_state := STATE_IDLE

// 2. Transitions BUY
if buy_state == STATE_IDLE
    // Condition de départ : Sweep de Sell-Side Liquidity (SSL)
    if sweep_l
        buy_state            := STATE_SWEEP_ARMED
        buy_sweep_bar        := bar_index
        buy_sweep_low        := low
        buy_mss_level        := vis_last_ph
        buy_displacement_bar := na
        buy_fvg_top          := na
        buy_fvg_bottom       := na
        buy_fvg_bar          := na
else if buy_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_l
        buy_sweep_bar := bar_index
        buy_sweep_low := low
        buy_mss_level := vis_last_ph
    // Recherche du Displacement + MSS haussier cassant buy_mss_level
    else if bar_confirmed and not na(buy_mss_level) and close > buy_mss_level and close > open and is_disp_quant
        buy_state            := STATE_MSS_CONFIRMED
        buy_displacement_bar := bar_index
        buy_pre_disp_high    := high[1] // ancre fixe : haut de la bougie juste avant le displacement
else if buy_state == STATE_MSS_CONFIRMED
    // La FVG causale doit se former dans une fenêtre de `causal_fvg_window_in` bougies après le
    // displacement (pas uniquement sur la bougie n+1 — trop fragile au timing exact). L'ancre
    // basse reste la bougie juste avant le displacement (buy_pre_disp_high), fixe quelle que soit
    // la bougie où le gap se referme.
    if bar_confirmed and bar_index >= buy_displacement_bar + 1 and bar_index <= buy_displacement_bar + causal_fvg_window_in
        has_causal_fvg = (low > buy_pre_disp_high) and ((low - buy_pre_disp_high) >= atr_val[1] * 0.15)
        if has_causal_fvg
            buy_fvg_top    := low
            buy_fvg_bottom := buy_pre_disp_high
            buy_fvg_bar    := bar_index
            buy_state      := STATE_CAUSAL_FVG_CONFIRMED
        else if bar_index == buy_displacement_bar + causal_fvg_window_in
            buy_state := STATE_IDLE // Fenêtre épuisée sans FVG causale valide -> Reset
    else if bar_index > buy_displacement_bar + causal_fvg_window_in
        buy_state := STATE_IDLE
else if buy_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    buy_state := STATE_WAIT_RETEST
else if buy_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer en dessous
    if mit_probe_bull <= buy_fvg_top and close >= buy_fvg_bottom
        buy_state := STATE_READY

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : SELL
// -------------------------------------------------------------
// 1. Resets / Invalidations SELL
if sell_state != STATE_IDLE
    // Invalidation par nouveau plus haut au-dessus du high du sweep
    if not na(sell_sweep_high) and high > sell_sweep_high
        sell_state := STATE_IDLE
    // Invalidation si sweep opposé (SSL) plus récent
    else if sweep_l
        sell_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if sell_state == STATE_SWEEP_ARMED and (bar_index - sell_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        sell_state := STATE_IDLE
    // Violation FVG causale (clôture au-dessus du haut de la FVG causale avant exécution)
    else if (sell_state == STATE_CAUSAL_FVG_CONFIRMED or sell_state == STATE_WAIT_RETEST) and close > sell_fvg_top
        sell_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if sell_state == STATE_WAIT_RETEST and (bar_index - sell_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        sell_state := STATE_IDLE

// 2. Transitions SELL
if sell_state == STATE_IDLE
    // Condition de départ : Sweep de Buy-Side Liquidity (BSL)
    if sweep_h
        sell_state            := STATE_SWEEP_ARMED
        sell_sweep_bar        := bar_index
        sell_sweep_high       := high
        sell_mss_level        := vis_last_pl
        sell_displacement_bar := na
        sell_fvg_top          := na
        sell_fvg_bottom       := na
        sell_fvg_bar          := na
else if sell_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_h
        sell_sweep_bar := bar_index
        sell_sweep_high := high
        sell_mss_level := vis_last_pl
    // Recherche du Displacement + MSS baissier cassant sell_mss_level
    else if bar_confirmed and not na(sell_mss_level) and close < sell_mss_level and close < open and is_disp_quant
        sell_state            := STATE_MSS_CONFIRMED
        sell_displacement_bar := bar_index
        sell_pre_disp_low     := low[1] // ancre fixe : bas de la bougie juste avant le displacement
else if sell_state == STATE_MSS_CONFIRMED
    // La FVG causale doit se former dans une fenêtre de `causal_fvg_window_in` bougies après le
    // displacement (pas uniquement sur la bougie n+1). Ancre haute fixe : sell_pre_disp_low.
    if bar_confirmed and bar_index >= sell_displacement_bar + 1 and bar_index <= sell_displacement_bar + causal_fvg_window_in
        has_causal_fvg = (high < sell_pre_disp_low) and ((sell_pre_disp_low - high) >= atr_val[1] * 0.15)
        if has_causal_fvg
            sell_fvg_top    := sell_pre_disp_low
            sell_fvg_bottom := high
            sell_fvg_bar    := bar_index
            sell_state      := STATE_CAUSAL_FVG_CONFIRMED
        else if bar_index == sell_displacement_bar + causal_fvg_window_in
            sell_state := STATE_IDLE // Fenêtre épuisée sans FVG causale valide -> Reset
    else if bar_index > sell_displacement_bar + causal_fvg_window_in
        sell_state := STATE_IDLE
else if sell_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    sell_state := STATE_WAIT_RETEST
else if sell_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer au-dessus
    if mit_probe_bear >= sell_fvg_bottom and close <= sell_fvg_top
        sell_state := STATE_READY

// Variables de position
var bool   in_pos       = false
var float  pos_entry    = 0.0
var float  pos_sl       = 0.0
var float  pos_tp       = 0.0   // TP final suivi pour la sortie : la cible de liquidité la plus lointaine retenue
var string pos_dir      = "NONE"
var string pos_quality  = "--"
var string pos_grade    = "--"
var string pos_rr_txt   = "0.0" // R du TP final, envoyé au serveur (résultat d'un TP_HIT)
var string pos_trade_id = ""    // identifiant unique du trade (actif + heure de la bougie d'entrée)
var int    last_sig_bar = 0
var box    tp_zone_box  = na
var box    sl_zone_box  = na
var line[]  tp_lines    = array.new_line()
var label[] tp_labels   = array.new_label()

// Timeout de 15 barres M5 entre deux signaux dans la même zone
cooldown_ok = na(last_sig_bar) or (bar_index - last_sig_bar > cooldown_bars_in)

// Déclencheurs de signal alimentés STRICTEMENT par la séquence causale ICT 2022
// BUY/SELL mutuellement exclusifs à l'exécution
cand_buy  = trade_window and not in_pos and cooldown_ok and bar_confirmed and (buy_state == STATE_READY)
cand_sell = trade_window and not in_pos and cooldown_ok and bar_confirmed and (sell_state == STATE_READY)

raw_buy  = cand_buy and not cand_sell
raw_sell = cand_sell and not cand_buy

// Qualification du setup
calc_score(is_mtf) =>
    score = is_mtf ? 3 : 2
    grade_str = score == 3 ? "A+" : "A"
    stars_str = score == 3 ? "★★★★★" : "★★★★☆"
    [score, grade_str, stars_str]

// Cibles envoyées au dashboard : [{"p":"prix","r":"R","t":"type de liquidité"}, ...]
f_targets_json(px, ty, rr) =>
    s = ""
    if array.size(px) > 0
        for i = 0 to array.size(px) - 1
            s += (i > 0 ? "," : "") + '{"p":"' + str.tostring(array.get(px, i), format.mintick) + '","r":"' + str.tostring(array.get(rr, i), "#.##") + '","t":"' + array.get(ty, i) + '"}'
    "[" + s + "]"

// Lignes pointillées TP1…TPn nommées (effacées au trade suivant, raccourcies à la sortie)
f_draw_targets(px, ty, rr) =>
    while array.size(tp_lines) > 0
        line.delete(array.pop(tp_lines))
    while array.size(tp_labels) > 0
        label.delete(array.pop(tp_labels))
    if show_risk_zone and array.size(px) > 0
        for i = 0 to array.size(px) - 1
            p = array.get(px, i)
            array.push(tp_lines, line.new(bar_index, p, bar_index + 30, p, color=color.new(color_lux_bull, 15), style=line.style_dashed, width=1))
            array.push(tp_labels, label.new(bar_index + 30, p, "TP" + str.tostring(i + 1) + " · " + array.get(ty, i) + " · +" + str.tostring(array.get(rr, i), "#.#") + "R", color=color.new(color.white, 100), textcolor=color_lux_bull, style=label.style_label_left, size=size.small))


if raw_buy
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bull)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        b_entry  = close
        // SL Structurel ancré sur le bas du sweep d'origine, plafonné/planché par ATR M5
        b_raw_sl = not na(buy_sweep_low) ? (buy_sweep_low - syminfo.mintick * 10) : (ta.lowest(low, 15) - syminfo.mintick * 10)
        b_risk   = math.max(math.min(b_entry - b_raw_sl, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        [t_px, t_ty, t_r, t_ok] = f_trade_targets(true, b_entry, b_risk)

        if not t_ok
            // Setup valide mais aucune cible de liquidité à min_rr_in R : trade abandonné (pas d'alerte)
            buy_state := STATE_IDLE
            label.new(bar_index, low - (atr_val * 0.8), "✖ BUY sans cible ≥ " + str.tostring(min_rr_in, "#.#") + "R", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        else
            setup_name   = tested_h1_bull ? "RETEST" : "SSL SWEEP"
            pos_entry    := b_entry
            pos_sl       := b_entry - b_risk
            pos_tp       := array.get(t_px, array.size(t_px) - 1)
            pos_rr_txt   := str.tostring(array.get(t_r, array.size(t_r) - 1), "#.##")
            pos_trade_id := asset_name + "-" + str.tostring(time)
            pos_dir      := "BUY"
            pos_quality  := grade_txt
            pos_grade    := stars_txt
            in_pos       := true
            last_sig_bar := bar_index

            // Reset de la machine d'état après entrée exécutée
            buy_state := STATE_IDLE

            // MARQUAGE CONSUMED : Bloque toute réutilisation de cette zone H1
            h1_bull_consumed := true

            // Label d'entrée en 2 niveaux, bien décalé du prix pour rester lisible au milieu des FVG/OB/CHoCH
            label.new(bar_index, low - (atr_val * 0.8), "🟢 " + grade_txt + " " + setup_name, color=color.new(color_lux_bull, 15), textcolor=color.black, style=label.style_label_up, size=size.small)

            // Zone visuelle Risque/Récompense : vert jusqu'au TP final, rouge jusqu'au SL, + lignes TP1…TPn
            if show_risk_zone
                if not na(tp_zone_box)
                    box.delete(tp_zone_box)
                if not na(sl_zone_box)
                    box.delete(sl_zone_box)
                tp_zone_box := box.new(bar_index, pos_tp, bar_index + 30, pos_entry, border_color=na, bgcolor=color.new(color_lux_bull, 88))
                sl_zone_box := box.new(bar_index, pos_entry, bar_index + 30, pos_sl, border_color=na, bgcolor=color.new(color_lux_bear, 88))
            f_draw_targets(t_px, t_ty, t_r)

            payload_entry = '{"symbol":"' + asset_name + '","status":"' + setup_name + '","direction":"BUY","quality":"' + grade_txt + '","grade":"' + stars_txt + '","entry_price":"' + str.tostring(pos_entry, format.mintick) + '","sl_price":"' + str.tostring(pos_sl, format.mintick) + '","tp_price":"' + str.tostring(pos_tp, format.mintick) + '","current_price":"' + str.tostring(close, format.mintick) + '","rr":"' + pos_rr_txt + '","version":"' + SCRIPT_VERSION + '","trade_id":"' + pos_trade_id + '","targets":' + f_targets_json(t_px, t_ty, t_r) + '}'
            alert(payload_entry, alert.freq_once_per_bar_close)

if raw_sell
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bear)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        s_entry  = close
        // SL Structurel ancré sur le haut du sweep d'origine, plafonné/planché par ATR M5
        s_raw_sl = not na(sell_sweep_high) ? (sell_sweep_high + syminfo.mintick * 10) : (ta.highest(high, 15) + syminfo.mintick * 10)
        s_risk   = math.max(math.min(s_raw_sl - s_entry, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        [t_px, t_ty, t_r, t_ok] = f_trade_targets(false, s_entry, s_risk)

        if not t_ok
            // Setup valide mais aucune cible de liquidité à min_rr_in R : trade abandonné (pas d'alerte)
            sell_state := STATE_IDLE
            label.new(bar_index, high + (atr_val * 0.8), "✖ SELL sans cible ≥ " + str.tostring(min_rr_in, "#.#") + "R", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_down, size=size.tiny)
        else
            setup_name   = tested_h1_bear ? "RETEST" : "BSL SWEEP"
            pos_entry    := s_entry
            pos_sl       := s_entry + s_risk
            pos_tp       := array.get(t_px, array.size(t_px) - 1)
            pos_rr_txt   := str.tostring(array.get(t_r, array.size(t_r) - 1), "#.##")
            pos_trade_id := asset_name + "-" + str.tostring(time)
            pos_dir      := "SELL"
            pos_quality  := grade_txt
            pos_grade    := stars_txt
            in_pos       := true
            last_sig_bar := bar_index

            // Reset de la machine d'état après entrée exécutée
            sell_state := STATE_IDLE

            // MARQUAGE CONSUMED : Bloque toute réutilisation de cette zone H1
            h1_bear_consumed := true

            // Label d'entrée en 2 niveaux, bien décalé du prix pour rester lisible au milieu des FVG/OB/CHoCH
            label.new(bar_index, high + (atr_val * 0.8), "🔴 " + grade_txt + " " + setup_name, color=color.new(color_lux_bear, 15), textcolor=color.white, style=label.style_label_down, size=size.small)

            // Zone visuelle Risque/Récompense : vert jusqu'au TP final, rouge jusqu'au SL, + lignes TP1…TPn
            if show_risk_zone
                if not na(tp_zone_box)
                    box.delete(tp_zone_box)
                if not na(sl_zone_box)
                    box.delete(sl_zone_box)
                tp_zone_box := box.new(bar_index, pos_entry, bar_index + 30, pos_tp, border_color=na, bgcolor=color.new(color_lux_bull, 88))
                sl_zone_box := box.new(bar_index, pos_sl, bar_index + 30, pos_entry, border_color=na, bgcolor=color.new(color_lux_bear, 88))
            f_draw_targets(t_px, t_ty, t_r)

            payload_entry = '{"symbol":"' + asset_name + '","status":"' + setup_name + '","direction":"SELL","quality":"' + grade_txt + '","grade":"' + stars_txt + '","entry_price":"' + str.tostring(pos_entry, format.mintick) + '","sl_price":"' + str.tostring(pos_sl, format.mintick) + '","tp_price":"' + str.tostring(pos_tp, format.mintick) + '","current_price":"' + str.tostring(close, format.mintick) + '","rr":"' + pos_rr_txt + '","version":"' + SCRIPT_VERSION + '","trade_id":"' + pos_trade_id + '","targets":' + f_targets_json(t_px, t_ty, t_r) + '}'
            alert(payload_entry, alert.freq_once_per_bar_close)

// ==========================================
// 5. SORTIES TP / SL & GESTION DES DESSINS
// ==========================================
if in_pos
    // BUG CORRIGÉ (revue ChatGPT du 18/09) : hit_tp/hit_sl utilisaient le high/low de LA
    // BOUGIE D'ENTRÉE elle-même, y compris la partie du mouvement antérieure à la clôture
    // qui a déclenché l'entrée — un TP/SL "fantôme" pouvait se déclencher instantanément sur
    // du prix touché avant l'entrée réelle. On ne teste plus la sortie sur la bougie d'entrée.
    hit_tp = bar_index > last_sig_bar and ((pos_dir == "BUY" and high >= pos_tp) or (pos_dir == "SELL" and low <= pos_tp))
    hit_sl = bar_index > last_sig_bar and ((pos_dir == "BUY" and low <= pos_sl)  or (pos_dir == "SELL" and high >= pos_sl))
    // Timeout automatique après 30 bougies M5 (2h30) pour débloquer le scanner
    pos_expired = (bar_index - last_sig_bar) >= 30

    if hit_sl or hit_tp or pos_expired
        exit_status = hit_sl ? "SL_HIT" : (hit_tp ? "TP_HIT" : "EXPIRED")
        payload_exit = '{"symbol":"' + asset_name + '","status":"' + exit_status + '","direction":"NONE","quality":"--","grade":"--","entry_price":"0.0","sl_price":"0.0","tp_price":"0.0","current_price":"' + str.tostring(close, format.mintick) + '","rr":"0.0","version":"' + SCRIPT_VERSION + '","trade_id":"' + pos_trade_id + '"}'
        alert(payload_exit, alert.freq_once_per_bar_close)
        in_pos      := false
        pos_dir     := "NONE"
        pos_quality := "--"
        pos_grade   := "--"

        if not na(tp_zone_box)
            box.set_right(tp_zone_box, bar_index)
        if not na(sl_zone_box)
            box.set_right(sl_zone_box, bar_index)
        for ln in tp_lines
            line.set_x2(ln, bar_index)
        for lb in tp_labels
            label.set_x(lb, bar_index)
    else if bar_index > last_sig_bar
        // Mise à jour de progression à chaque clôture de bougie M5 pendant position active
        payload_update = '{"symbol":"' + asset_name + '","status":"PRICE_UPDATE","direction":"' + pos_dir + '","quality":"' + pos_quality + '","grade":"' + pos_grade + '","entry_price":"' + str.tostring(pos_entry, format.mintick) + '","sl_price":"' + str.tostring(pos_sl, format.mintick) + '","tp_price":"' + str.tostring(pos_tp, format.mintick) + '","current_price":"' + str.tostring(close, format.mintick) + '","rr":"' + pos_rr_txt + '","version":"' + SCRIPT_VERSION + '","trade_id":"' + pos_trade_id + '"}'
        alert(payload_update, alert.freq_once_per_bar_close)

// ==========================================
// 6. TABLEAU DE BORD (overlay, style LuxAlgo)
// ==========================================
var table dash = table.new(position.top_right, 2, 7, border_color=color_panel_bd, border_width=2, frame_color=color_panel_bd, frame_width=2)

if show_dashboard and barstate.islast
    bias_txt = h1_bias_bull ? "🟢 HAUSSIER" : h1_bias_bear ? "🔴 BAISSIER" : "⚪ NEUTRE"
    bias_col = h1_bias_bull ? color_lux_bull : h1_bias_bear ? color_lux_bear : color_lux_level
    sess_txt = in_london ? "🟠 LONDRES" : in_ny ? "🟠 NEW YORK" : "HORS SESSION"
    sess_col = (in_london or in_ny) ? color_lux_gold : color_lux_level
    pos_txt  = in_pos ? ("🔥 " + pos_dir + " EN COURS") : "— AUCUNE"
    pos_col  = in_pos ? (pos_dir == "BUY" ? color_lux_bull : color_lux_bear) : color_lux_level

    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "  ◆ " + asset_name + "  ", text_color=color.white, text_size=size.large, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 0, 1, "  Timeframe  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 1, "  M5 · H1  ", text_color=color.white, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 2, "  Biais H1  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 2, "  " + bias_txt + "  ", text_color=bias_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 3, "  Session  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 3, "  " + sess_txt + "  ", text_color=sess_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 4, "  Position  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 4, "  " + pos_txt + "  ", text_color=pos_col, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 5, "  Grade min.  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 5, "  " + min_grade_in + "  ", text_color=color_lux_gold, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)
    table.cell(dash, 0, 6, "  Version  ", text_color=color_lux_level, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_left)
    table.cell(dash, 1, 6, "  " + SCRIPT_VERSION + "  ", text_color=color.white, text_size=size.normal, bgcolor=color_panel_bg, text_halign=text.align_right)