//@version=5
// NB Pine v5 : commission_value / slippage doivent être des constantes fixes
// (impossible d'utiliser input.float ici). Modifie les 2 chiffres ci-dessous
// directement si tu veux tester d'autres hypothèses de coûts.
// VERSION DU SCRIPT — à comparer avec ce que Claude annonce à chaque envoi de fichier.
// Visible en permanence dans le titre sur le graphique. Change ce numéro à CHAQUE
// modification envoyée par Claude. Numérotée séparément du Radar (fichiers indépendants).
SCRIPT_VERSION = "B7.1-DEBUG"

// Version EN TÊTE du nom : la liste « Mes scripts » de TradingView coupe les noms trop longs.
strategy("Backtest ICT B7.1 — MTF H1-M5 (debug)", shorttitle="Backtest ICT B7.1", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=2,
     process_orders_on_close=true,
     max_boxes_count=200, max_lines_count=200, max_labels_count=200, max_bars_back=1000)

// ==========================================
// VERSION BACKTEST — même logique de détection que scanner_mtf.pine,
// mais les alert() sont remplacés par de vrais ordres strategy.entry/exit
// pour pouvoir utiliser l'onglet "Strategy Tester" de TradingView.
// Le fichier scanner_mtf.pine (production / webhooks) n'est pas modifié.
// ==========================================

// ==========================================
// 1. CONFIGURATION GÉNÉRALE & PARAMÈTRES
// ==========================================
grp_radar     = "Configuration Terminal Radar"
rr_ratio      = input.float(2.0, title="Ratio Risque / Récompense (TP)", minval=1.0, step=0.5, group=grp_radar)
is_crypto_247 = input.bool(true, title="Mode Métaux / Continu (Ignore Killzones)", group=grp_radar)
min_grade_in  = input.string("A", title="Grade Minimum pour Alerte", options=["B", "A", "A+"], group=grp_radar)
ema_flat_thr  = input.float(0.08, title="Seuil Pente EMA H1 (x ATR)", step=0.01, group=grp_radar)
atr_cap_mult  = input.float(2.5, title="Plafond Stop-Loss (x ATR M5)", minval=0.5, step=0.1, group=grp_radar)
atr_floor_mult = input.float(0.5, title="Plancher Stop-Loss (x ATR M5)", minval=0.1, step=0.1, group=grp_radar)
risk_pct_in   = input.float(1.0, title="Risque par trade (% équité)", minval=0.1, step=0.1, group=grp_radar)
zone_window_in   = input.int(20, title="Fenêtre de validité contexte H1 (barres M5)", minval=5, maxval=50, group=grp_radar)
cooldown_bars_in = input.int(10, title="Cooldown entre signaux (barres M5)", minval=1, maxval=50, group=grp_radar)
causal_fvg_window_in = input.int(3, title="Fenêtre de formation FVG causale après displacement (barres M5)", minval=1, maxval=10, group=grp_radar)
disp_body_ratio_min_in = input.float(0.60, title="Displacement : ratio corps/range minimum", minval=0.3, maxval=0.9, step=0.05, group=grp_radar)
disp_atr_mult_min_in   = input.float(1.0, title="Displacement : corps minimum (x ATR M5)", minval=0.3, maxval=2.0, step=0.05, group=grp_radar)
sweep_to_mss_window_in  = input.int(18, title="Fenêtre sweep -> displacement (barres M5)", minval=6, maxval=40, group=grp_radar)
fvg_to_retest_window_in = input.int(20, title="Fenêtre FVG causale -> retest (barres M5)", minval=5, maxval=50, group=grp_radar)
fvg_mitigation_mode = input.string("Mèche", title="Mode de mitigation FVG/OB", options=["Mèche", "Corps", "Clôture"], group=grp_radar)

grp_ui        = "Affichage Graphique ICT"
show_fvg      = input.bool(true, title="Afficher FVG H1", group=grp_ui)
show_fvg_m5   = input.bool(false, title="Afficher FVG M5", group=grp_ui)
show_mss      = input.bool(true, title="Afficher CHoCH / BOS", group=grp_ui)
show_ob       = input.bool(true, title="Afficher Order Blocks (M5)", group=grp_ui)
show_eqh_eql  = input.bool(true, title="Afficher EQH / EQL (Liquidité)", group=grp_ui)
show_levels   = input.bool(true, title="Afficher PDH / PDL / NY Midnight", group=grp_ui)

grp_sessions  = "Sessions ICT (Heure New York UTC-4)"
sess_london   = input.session("0200-0500:23456", title="London Open", group=grp_sessions)
sess_ny       = input.session("0800-1130:23456", title="NY AM", group=grp_sessions)

in_london    = not na(time(timeframe.period, sess_london, "America/New_York"))
in_ny        = not na(time(timeframe.period, sess_ny, "America/New_York"))
trade_window = is_crypto_247 or in_london or in_ny

bgcolor(in_london ? color.new(#00bcd4, 96) : na, title="Bg Londres")
bgcolor(in_ny ? color.new(#ff9800, 96) : na, title="Bg New York")

// ==========================================
// THÈME VISUEL
// ==========================================
color_lux_bull  = color.new(#00E676, 0)
color_lux_bear  = color.new(#FF1744, 0)
color_lux_liq   = color.new(#00E5FF, 0)
color_lux_level = color.new(#B0BEC5, 30)

// ==========================================
// 2. EXTRACTION HTF H1 : FVG, BIAIS & BOS
// ==========================================
f_get_h1_data() =>
    h1_atr      = ta.atr(14)
    h1_ema      = ta.ema(close, 50)
    h1_ph       = ta.pivothigh(high, 3, 3)
    h1_pl       = ta.pivotlow(low, 3, 3)
    [high[1], low[1], high[3], low[3], close[1], h1_ema[1], h1_ema[2], h1_atr[1], h1_ph[1], h1_pl[1]]

[h1_high, h1_low, h1_high2, h1_low2, h1_close, h1_ema, h1_ema_prev, h1_atr, h1_ph, h1_pl] = request.security(syminfo.tickerid, "60", f_get_h1_data(), barmerge.gaps_off, barmerge.lookahead_off)

h1_ema_flat  = math.abs(h1_ema - h1_ema_prev) < (h1_atr * ema_flat_thr)
h1_bias_bull = (h1_close > h1_ema) and not h1_ema_flat
h1_bias_bear = (h1_close < h1_ema) and not h1_ema_flat

var float h1_last_ph = na
var float h1_last_pl = na

if ta.change(time("60"))
    if not na(h1_ph)
        h1_last_ph := h1_ph
    if not na(h1_pl)
        h1_last_pl := h1_pl

h1_bos_bull = ta.change(time("60")) and not na(h1_last_ph) and h1_close > h1_last_ph
h1_bos_bear = ta.change(time("60")) and not na(h1_last_pl) and h1_close < h1_last_pl

if h1_bos_bull
    h1_last_ph := na
if h1_bos_bear
    h1_last_pl := na

h1_fvg_bull = (h1_low > h1_high2) and ((h1_low - h1_high2) > (0.5 * h1_atr))
h1_fvg_bear = (h1_high < h1_low2) and ((h1_low2 - h1_high) > (0.5 * h1_atr))

var float h1_bull_zone_top = na
var float h1_bull_zone_bot = na
var bool  h1_bull_consumed = false
var box   h1_bull_box      = na

var float h1_bear_zone_top = na
var float h1_bear_zone_bot = na
var bool  h1_bear_consumed = false
var box   h1_bear_box      = na

color_fvg_hl = color.new(#FFFF00, 80)
color_fvg_bd = color.new(#FFFF00, 30)

if ta.change(time("60"))
    if h1_fvg_bull
        is_new_fvg = na(h1_bull_zone_bot) or (h1_low != h1_bull_zone_top) or (h1_high2 != h1_bull_zone_bot)
        if is_new_fvg
            if not na(h1_bull_box)
                box.set_extend(h1_bull_box, extend.none)
                box.set_right(h1_bull_box, bar_index)

            h1_bull_zone_top := h1_low
            h1_bull_zone_bot := h1_high2
            h1_bull_consumed := false
            if show_fvg
                h1_bull_box := box.new(bar_index, h1_bull_zone_top, bar_index + 1, h1_bull_zone_bot, border_color=color_fvg_bd, bgcolor=color_fvg_hl, extend=extend.right)

    if h1_fvg_bear
        is_new_fvg = na(h1_bear_zone_top) or (h1_low2 != h1_bear_zone_top) or (h1_high != h1_bear_zone_bot)
        if is_new_fvg
            if not na(h1_bear_box)
                box.set_extend(h1_bear_box, extend.none)
                box.set_right(h1_bear_box, bar_index)

            h1_bear_zone_top := h1_low2
            h1_bear_zone_bot := h1_high
            h1_bear_consumed := false
            if show_fvg
                h1_bear_box := box.new(bar_index, h1_bear_zone_top, bar_index + 1, h1_bear_zone_bot, border_color=color_fvg_bd, bgcolor=color_fvg_hl, extend=extend.right)

in_h1_bull_zone = not h1_bull_consumed and not na(h1_bull_zone_top) and (high >= h1_bull_zone_bot and low <= h1_bull_zone_top)
in_h1_bear_zone = not h1_bear_consumed and not na(h1_bear_zone_top) and (high >= h1_bear_zone_bot and low <= h1_bear_zone_top)

// Invalidation dès que le prix retourne dans la zone (mitigation), cohérent avec la logique OB/FVG M5
if in_h1_bull_zone
    h1_bull_consumed := true
if in_h1_bear_zone
    h1_bear_consumed := true

// ==========================================
// 2.5 NIVEAUX MAJEURS (PDH, PDL, NY MIDNIGHT)
// ==========================================
var float pdh = na
var float pdl = na
var int   pdh_bar = na
var int   pdl_bar = na
var float current_dh = na
var float current_dl = na
var int   current_dh_bar = na
var int   current_dl_bar = na

// Alignement sur le Radar (PATCH 1) : "America/New_York" était passé en paramètre `session`,
// pas `timezone` -> la journée ne commençait pas à minuit New York. Même PDH / PDL que le Radar.
is_new_ny_day = ta.change(time("D", "", "America/New_York"))

if is_new_ny_day
    pdh := current_dh
    pdl := current_dl
    pdh_bar := current_dh_bar
    pdl_bar := current_dl_bar
    current_dh := high
    current_dl := low
    current_dh_bar := bar_index
    current_dl_bar := bar_index
else
    if high > current_dh
        current_dh := high
        current_dh_bar := bar_index
    if low < current_dl
        current_dl := low
        current_dl_bar := bar_index

var float midnight_open = na
if is_new_ny_day
    midnight_open := open

if is_new_ny_day and show_levels
    if not na(pdh)
        line.new(pdh_bar, pdh, bar_index + 288, pdh, color=color_lux_level, width=1, style=line.style_dotted)
        label.new(bar_index + 5, pdh, "PDH", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.small)
    if not na(pdl)
        line.new(pdl_bar, pdl, bar_index + 288, pdl, color=color_lux_level, width=1, style=line.style_dotted)
        label.new(bar_index + 5, pdl, "PDL", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.small)

if is_new_ny_day and show_levels
    line.new(bar_index, open, bar_index + 288, open, color=color.new(#FFD600, 20), width=1, style=line.style_dashed)
    label.new(bar_index + 5, open, "NY Open", color=color.new(color.white, 100), textcolor=color.new(#FFD600, 0), style=label.style_none, size=size.small)

// ==========================================
// 3. STRUCTURE M5 & CONFIRMATION DE REJET
// ==========================================
atr_val       = ta.atr(14)
bar_confirmed = barstate.isconfirmed

// --- Sonde de mitigation (Mèche/Corps/Clôture) — doit rester identique à scanner_mtf.pine pour que les deux scripts restent synchronisés ---
mit_probe_bull = fvg_mitigation_mode == "Mèche" ? low : fvg_mitigation_mode == "Corps" ? math.min(open, close) : close
mit_probe_bear = fvg_mitigation_mode == "Mèche" ? high : fvg_mitigation_mode == "Corps" ? math.max(open, close) : close

ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

var float last_ph     = na
var int   last_ph_bar = na
var float prev_ph     = na
var int   prev_ph_bar = na
var float lowest_since_ph = na
var float ob_bull_top = na
var float ob_bull_bot = na
var int   ob_bull_bar = na

if not na(ph)
    prev_ph := last_ph
    prev_ph_bar := last_ph_bar
    last_ph := ph
    last_ph_bar := bar_index - 5
    ob_bull_bot := low
    ob_bull_top := high
    ob_bull_bar := bar_index
    lowest_since_ph := low

    if show_eqh_eql and not na(prev_ph) and math.abs(last_ph - prev_ph) <= (syminfo.mintick * 15)
        line.new(prev_ph_bar, prev_ph, bar_index, prev_ph, color=color_lux_liq, width=1)
        label.new(math.round((prev_ph_bar + bar_index)/2), prev_ph, "EQH 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bull_bot)
    if low <= ob_bull_bot
        ob_bull_bot := low
        ob_bull_top := high
        ob_bull_bar := bar_index
        lowest_since_ph := low

var float last_pl     = na
var int   last_pl_bar = na
var float prev_pl     = na
var int   prev_pl_bar = na
var float highest_since_pl = na
var float ob_bear_top = na
var float ob_bear_bot = na
var int   ob_bear_bar = na
var int   last_struct_dir = 0

if not na(pl)
    prev_pl := last_pl
    prev_pl_bar := last_pl_bar
    last_pl := pl
    last_pl_bar := bar_index - 5
    ob_bear_top := high
    ob_bear_bot := low
    ob_bear_bar := bar_index
    highest_since_pl := high

    if show_eqh_eql and not na(prev_pl) and math.abs(last_pl - prev_pl) <= (syminfo.mintick * 15)
        line.new(prev_pl_bar, prev_pl, bar_index, prev_pl, color=color_lux_liq, width=1)
        label.new(math.round((prev_pl_bar + bar_index)/2), prev_pl, "EQL 💧", color=color.new(color.white, 100), textcolor=color_lux_liq, style=label.style_none, size=size.small)
else if not na(ob_bear_top)
    if high >= ob_bear_top
        ob_bear_top := high
        ob_bear_bot := low
        ob_bear_bar := bar_index
        highest_since_pl := high

c_range = high - low
c_body  = math.abs(close - open)
is_disp = c_range > 0 and ((c_body / c_range) >= 0.50)

// --- Pivots persistants indépendants — JAMAIS réinitialisés par les événements MSS du moteur
// (contrairement à last_ph/last_pl, consommés/remis à na dès que la détection d'affichage
// mss_bull/mss_bear les utilise, laquelle a un seuil bien plus permissif — is_disp 50% —
// que le moteur causal — is_disp_quant 65% + 1,25x ATR). Sans cette copie séparée, le moteur
// causal capturait souvent un buy_mss_level/sell_mss_level déjà à na au moment du sweep,
// bloquant silencieusement la détection de displacement. BUG CORRIGÉ : le sweep et le niveau
// de cassure du moteur causal utilisent maintenant CES pivots, pas last_ph/last_pl.
var float vis_last_ph = na
var float vis_prev_ph = na
var float vis_last_pl = na
var float vis_prev_pl = na

if not na(ph)
    vis_prev_ph := vis_last_ph
    vis_last_ph := ph
if not na(pl)
    vis_prev_pl := vis_last_pl
    vis_last_pl := pl

wick_top = high - math.max(open, close)
wick_bot = math.min(open, close) - low
rej_buy  = c_range > 0 and (wick_bot / c_range) >= 0.35 and close > open
rej_sell = c_range > 0 and (wick_top / c_range) >= 0.35 and close < open

sweep_l = not na(vis_last_pl) and low < vis_last_pl and close > vis_last_pl and rej_buy
sweep_h = not na(vis_last_ph) and high > vis_last_ph and close < vis_last_ph and rej_sell

bars_in_h1_bull = ta.barssince(in_h1_bull_zone)
bars_in_h1_bear = ta.barssince(in_h1_bear_zone)
tested_h1_bull  = not na(bars_in_h1_bull) and bars_in_h1_bull <= zone_window_in
tested_h1_bear  = not na(bars_in_h1_bear) and bars_in_h1_bear <= zone_window_in

valid_ctx_bull = tested_h1_bull or (h1_bias_bull and not na(ta.barssince(sweep_l)) and ta.barssince(sweep_l) <= zone_window_in)
valid_ctx_bear = tested_h1_bear or (h1_bias_bear and not na(ta.barssince(sweep_h)) and ta.barssince(sweep_h) <= zone_window_in)

var bool  is_ob_bull_active = false
var float current_ob_bull_top = na
var int   current_ob_bull_start = na
var box   current_ob_bull = na

var bool  is_ob_bear_active = false
var float current_ob_bear_bot = na
var int   current_ob_bear_start = na
var box   current_ob_bear = na

var bool  is_fvg_bull_active = false
var float current_fvg_bull_m5_top = na
var int   current_fvg_bull_m5_start = na
var box   current_fvg_bull_m5 = na

var bool  is_fvg_bear_active = false
var float current_fvg_bear_m5_bot = na
var int   current_fvg_bear_m5_start = na
var box   current_fvg_bear_m5 = na

mss_bull = not na(last_ph) and bar_confirmed and ta.crossover(close, last_ph) and is_disp
if mss_bull
    if tested_h1_bull
        if show_mss
            is_choch = (last_struct_dir != 1)
            lbl_text = is_choch ? "CHoCH" : "BOS"
            line.new(last_ph_bar, last_ph, bar_index, last_ph, color=color_lux_bull, width=1, style=line.style_dashed)
            label.new(math.round((last_ph_bar + bar_index)/2), last_ph, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bull, style=label.style_none, size=size.small)

        if not na(ob_bull_bot)
            is_ob_bull_active := true
            current_ob_bull_top := ob_bull_top
            current_ob_bull_start := bar_index
            if show_ob
                if not na(current_ob_bull)
                    box.set_extend(current_ob_bull, extend.none)
                    box.set_right(current_ob_bull, bar_index)
                current_ob_bull := box.new(ob_bull_bar, ob_bull_top, bar_index, ob_bull_bot, border_color=color_lux_bull, bgcolor=color.new(color_lux_bull, 85), extend=extend.right)
    last_ph := na
    last_struct_dir := 1

mss_bear = not na(last_pl) and bar_confirmed and ta.crossunder(close, last_pl) and is_disp
if mss_bear
    if tested_h1_bear
        if show_mss
            is_choch = (last_struct_dir != -1)
            lbl_text = is_choch ? "CHoCH" : "BOS"
            line.new(last_pl_bar, last_pl, bar_index, last_pl, color=color_lux_bear, width=1, style=line.style_dashed)
            label.new(math.round((last_pl_bar + bar_index)/2), last_pl, lbl_text, color=color.new(color.white, 100), textcolor=color_lux_bear, style=label.style_none, size=size.small)

        if not na(ob_bear_top)
            is_ob_bear_active := true
            current_ob_bear_bot := ob_bear_bot
            current_ob_bear_start := bar_index
            if show_ob
                if not na(current_ob_bear)
                    box.set_extend(current_ob_bear, extend.none)
                    box.set_right(current_ob_bear, bar_index)
                current_ob_bear := box.new(ob_bear_bar, ob_bear_top, bar_index, ob_bear_bot, border_color=color_lux_bear, bgcolor=color.new(color_lux_bear, 85), extend=extend.right)
    last_pl := na
    last_struct_dir := -1

fvg_bull_m5 = (low > high[2]) and (low - high[2] >= atr_val * 0.15)
if fvg_bull_m5 and valid_ctx_bull
    is_fvg_bull_active := true
    current_fvg_bull_m5_top := high[2]
    current_fvg_bull_m5_start := bar_index
    if show_fvg_m5
        if not na(current_fvg_bull_m5)
            box.set_extend(current_fvg_bull_m5, extend.none)
            box.set_right(current_fvg_bull_m5, bar_index)
        current_fvg_bull_m5 := box.new(bar_index - 2, low, bar_index, high[2], border_color=na, bgcolor=color.new(color_lux_bull, 85), extend=extend.right)

fvg_bear_m5 = (high < low[2]) and (low[2] - high >= atr_val * 0.15)
if fvg_bear_m5 and valid_ctx_bear
    is_fvg_bear_active := true
    current_fvg_bear_m5_bot := low[2]
    current_fvg_bear_m5_start := bar_index
    if show_fvg_m5
        if not na(current_fvg_bear_m5)
            box.set_extend(current_fvg_bear_m5, extend.none)
            box.set_right(current_fvg_bear_m5, bar_index)
        current_fvg_bear_m5 := box.new(bar_index - 2, low[2], bar_index, high, border_color=na, bgcolor=color.new(color_lux_bear, 85), extend=extend.right)

mitigated_ob_bull = false
mitigated_ob_bear = false
mitigated_fvg_bull = false
mitigated_fvg_bear = false

if is_ob_bull_active and bar_index > current_ob_bull_start and mit_probe_bull <= current_ob_bull_top
    is_ob_bull_active := false
    mitigated_ob_bull := true
    if not na(current_ob_bull)
        box.set_extend(current_ob_bull, extend.none)
        box.set_right(current_ob_bull, bar_index)
        current_ob_bull := na

if is_ob_bear_active and bar_index > current_ob_bear_start and mit_probe_bear >= current_ob_bear_bot
    is_ob_bear_active := false
    mitigated_ob_bear := true
    if not na(current_ob_bear)
        box.set_extend(current_ob_bear, extend.none)
        box.set_right(current_ob_bear, bar_index)
        current_ob_bear := na

if is_fvg_bull_active and bar_index > current_fvg_bull_m5_start and mit_probe_bull <= current_fvg_bull_m5_top
    is_fvg_bull_active := false
    mitigated_fvg_bull := true
    if not na(current_fvg_bull_m5)
        box.set_extend(current_fvg_bull_m5, extend.none)
        box.set_right(current_fvg_bull_m5, bar_index)
        current_fvg_bull_m5 := na

if is_fvg_bear_active and bar_index > current_fvg_bear_m5_start and mit_probe_bear >= current_fvg_bear_m5_bot
    is_fvg_bear_active := false
    mitigated_fvg_bear := true
    if not na(current_fvg_bear_m5)
        box.set_extend(current_fvg_bear_m5, extend.none)
        box.set_right(current_fvg_bear_m5, bar_index)
        current_fvg_bear_m5 := na

// ==========================================
// 3.9 CIBLES DE LIQUIDITÉ (TP STRUCTURELS) — R6 / B7
// ==========================================
// Les TP ne sont plus des multiples fixes du risque : on vise la liquidité suivante dans le sens
// du trade (buy-side au-dessus pour un achat, sell-side en dessous pour une vente) : pivots M5,
// equal highs / equal lows, swing H1, plus haut / bas des sessions Asie et Londres, PDH / PDL,
// FVG opposées non comblées (M5 et H1). Un trade n'est pris que s'il existe au moins une cible à
// min_rr_in R ou plus. Bloc IDENTIQUE dans le Radar et le Backtest, indépendant des options
// d'affichage (les FVG / EQH dessinées ne sont pas lues ici).
grp_tp        = "Cibles de profit (liquidité)"
tp_mode_in    = input.string("Liquidité", title="Mode des TP", options=["Liquidité", "Fixe (R:R)"], group=grp_tp)
min_rr_in     = input.float(1.5, title="R:R minimum exigé pour prendre le trade", minval=0.5, step=0.1, group=grp_tp)
min_tp_r_in   = input.float(1.0, title="Distance minimale d'un TP (en R)", minval=0.3, step=0.1, group=grp_tp)
max_tp_in     = input.int(4, title="Nombre maximum de TP", minval=1, maxval=6, group=grp_tp)
LIQ_MAX       = 40   // niveaux de liquidité mémorisés par côté
FVG_MAX       = 30   // FVG M5 mémorisées par côté

var float[]  liq_up_px    = array.new_float()   // buy-side : niveaux au-dessus du prix
var string[] liq_up_ty    = array.new_string()
var float[]  liq_dn_px    = array.new_float()   // sell-side : niveaux en dessous du prix
var string[] liq_dn_ty    = array.new_string()
var float[]  fvg_bear_bot = array.new_float()   // FVG baissières M5 (cible d'un achat = bord bas)
var float[]  fvg_bull_top = array.new_float()   // FVG haussières M5 (cible d'une vente = bord haut)

// Ajoute un niveau ; un niveau déjà présent à moins de `tol` est la même liquidité : on fusionne
// (deux pivots M5 proches = equal highs / equal lows ; un type plus fort remplace « Pivot M5 »).
f_liq_add(px_arr, ty_arr, price, typ, tol, is_up) =>
    merged = false
    n = array.size(px_arr)
    if n > 0
        for i = 0 to n - 1
            p = array.get(px_arr, i)
            if not merged and math.abs(p - price) <= tol
                merged := true
                old_ty = array.get(ty_arr, i)
                if typ == "Pivot M5"
                    if old_ty == "Pivot M5"
                        array.set(ty_arr, i, is_up ? "Equal highs" : "Equal lows")
                else if old_ty == "Pivot M5" or old_ty == "Equal highs" or old_ty == "Equal lows"
                    array.set(ty_arr, i, typ)
                array.set(px_arr, i, is_up ? math.max(p, price) : math.min(p, price))
    if not merged
        array.push(px_arr, price)
        array.push(ty_arr, typ)
        if array.size(px_arr) > LIQ_MAX
            array.shift(px_arr)
            array.shift(ty_arr)

// Un niveau traversé par le prix est consommé (la liquidité a été prise) : il ne sert plus de cible.
f_liq_sweep(px_arr, ty_arr, is_up) =>
    n = array.size(px_arr)
    if n > 0
        for i = n - 1 to 0
            p = array.get(px_arr, i)
            if (is_up and high > p) or (not is_up and low < p)
                array.remove(px_arr, i)
                array.remove(ty_arr, i)

f_fvg_mitigate(arr, is_bear_zone) =>
    n = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            p = array.get(arr, i)
            if (is_bear_zone and high >= p) or (not is_bear_zone and low <= p)
                array.remove(arr, i)

liq_tol = atr_val * 0.10

// 1) Consommation des niveaux déjà pris par la bougie courante
f_liq_sweep(liq_up_px, liq_up_ty, true)
f_liq_sweep(liq_dn_px, liq_dn_ty, false)
f_fvg_mitigate(fvg_bear_bot, true)
f_fvg_mitigate(fvg_bull_top, false)

// 2) Nouveaux niveaux : pivots M5 (confirmés 5 bougies plus tard, donc sous le prix actuel)
if not na(ph)
    f_liq_add(liq_up_px, liq_up_ty, ph, "Pivot M5", liq_tol, true)
if not na(pl)
    f_liq_add(liq_dn_px, liq_dn_ty, pl, "Pivot M5", liq_tol, false)

// Swing H1 (une seule fois par heure)
if ta.change(time("60"))
    if not na(h1_ph)
        f_liq_add(liq_up_px, liq_up_ty, h1_ph, "Swing H1", liq_tol, true)
    if not na(h1_pl)
        f_liq_add(liq_dn_px, liq_dn_ty, h1_pl, "Swing H1", liq_tol, false)

// PDH / PDL (au changement de journée New York)
if is_new_ny_day
    if not na(pdh)
        f_liq_add(liq_up_px, liq_up_ty, pdh, "PDH", liq_tol, true)
    if not na(pdl)
        f_liq_add(liq_dn_px, liq_dn_ty, pdl, "PDL", liq_tol, false)

// Plus haut / plus bas des sessions Asie (19h-minuit NY) et Londres, ajoutés à la fin de la session
in_asia_sess = not na(time(timeframe.period, "1900-2359:1234567", "America/New_York"))
var float asia_run_hi = na
var float asia_run_lo = na
if in_asia_sess
    asia_run_hi := not in_asia_sess[1] or na(asia_run_hi) ? high : math.max(asia_run_hi, high)
    asia_run_lo := not in_asia_sess[1] or na(asia_run_lo) ? low : math.min(asia_run_lo, low)
else if in_asia_sess[1] and not na(asia_run_hi)
    f_liq_add(liq_up_px, liq_up_ty, asia_run_hi, "Haut Asie", liq_tol, true)
    f_liq_add(liq_dn_px, liq_dn_ty, asia_run_lo, "Bas Asie", liq_tol, false)

var float lon_run_hi = na
var float lon_run_lo = na
if in_london
    lon_run_hi := not in_london[1] or na(lon_run_hi) ? high : math.max(lon_run_hi, high)
    lon_run_lo := not in_london[1] or na(lon_run_lo) ? low : math.min(lon_run_lo, low)
else if in_london[1] and not na(lon_run_hi)
    f_liq_add(liq_up_px, liq_up_ty, lon_run_hi, "Haut Londres", liq_tol, true)
    f_liq_add(liq_dn_px, liq_dn_ty, lon_run_lo, "Bas Londres", liq_tol, false)

// FVG M5 (même seuil de taille que la FVG causale : 0,15 x ATR)
if high < low[2] and (low[2] - high) >= atr_val * 0.15
    array.push(fvg_bear_bot, high)
    if array.size(fvg_bear_bot) > FVG_MAX
        array.shift(fvg_bear_bot)
if low > high[2] and (low - high[2]) >= atr_val * 0.15
    array.push(fvg_bull_top, low)
    if array.size(fvg_bull_top) > FVG_MAX
        array.shift(fvg_bull_top)

// Sélection des TP pour une entrée : cibles dans le sens du trade, triées par distance,
// à min_tp_r_in R minimum, fusionnées si trop proches (< 0,15 R). ok = au moins une cible
// à min_rr_in R ou plus ; elle est toujours conservée, même au-delà de max_tp_in.
f_select_targets(is_buy, entry, risk) =>
    c_px = array.new_float()
    c_ty = array.new_string()
    if is_buy
        if array.size(liq_up_px) > 0
            for i = 0 to array.size(liq_up_px) - 1
                if array.get(liq_up_px, i) > entry
                    array.push(c_px, array.get(liq_up_px, i))
                    array.push(c_ty, array.get(liq_up_ty, i))
        if array.size(fvg_bear_bot) > 0
            for i = 0 to array.size(fvg_bear_bot) - 1
                if array.get(fvg_bear_bot, i) > entry
                    array.push(c_px, array.get(fvg_bear_bot, i))
                    array.push(c_ty, "FVG M5")
        if not h1_bear_consumed and not na(h1_bear_zone_bot) and h1_bear_zone_bot > entry
            array.push(c_px, h1_bear_zone_bot)
            array.push(c_ty, "FVG H1")
    else
        if array.size(liq_dn_px) > 0
            for i = 0 to array.size(liq_dn_px) - 1
                if array.get(liq_dn_px, i) < entry
                    array.push(c_px, array.get(liq_dn_px, i))
                    array.push(c_ty, array.get(liq_dn_ty, i))
        if array.size(fvg_bull_top) > 0
            for i = 0 to array.size(fvg_bull_top) - 1
                if array.get(fvg_bull_top, i) < entry
                    array.push(c_px, array.get(fvg_bull_top, i))
                    array.push(c_ty, "FVG M5")
        if not h1_bull_consumed and not na(h1_bull_zone_top) and h1_bull_zone_top < entry
            array.push(c_px, h1_bull_zone_top)
            array.push(c_ty, "FVG H1")

    c_r = array.new_float()
    if array.size(c_px) > 0
        for i = 0 to array.size(c_px) - 1
            array.push(c_r, risk > 0 ? math.abs(array.get(c_px, i) - entry) / risk : 0.0)

    m_px = array.new_float()
    m_ty = array.new_string()
    m_r  = array.new_float()
    if array.size(c_r) > 0
        idx = array.sort_indices(c_r, order.ascending)
        for k = 0 to array.size(idx) - 1
            i = array.get(idx, k)
            r = array.get(c_r, i)
            if r >= min_tp_r_in
                last = array.size(m_r) - 1
                // Pine évalue les DEUX côtés d'un « and » : lecture de m_r seulement si elle contient une cible.
                too_close = false
                if last >= 0
                    too_close := r - array.get(m_r, last) < 0.15
                if too_close
                    old = array.get(m_ty, last)
                    if not str.contains(old, array.get(c_ty, i))
                        array.set(m_ty, last, old + " + " + array.get(c_ty, i))
                else
                    array.push(m_px, array.get(c_px, i))
                    array.push(m_ty, array.get(c_ty, i))
                    array.push(m_r, r)

    first_ok = -1
    if array.size(m_r) > 0
        for k = 0 to array.size(m_r) - 1
            if first_ok < 0 and array.get(m_r, k) >= min_rr_in
                first_ok := k

    o_px = array.new_float()
    o_ty = array.new_string()
    o_r  = array.new_float()
    if first_ok >= 0
        keep = math.min(array.size(m_r), max_tp_in)
        for k = 0 to keep - 1
            // Si la 1re cible valable (>= min_rr_in) est au-delà de max_tp_in, elle prend la dernière place.
            src = (k == keep - 1 and first_ok > keep - 1) ? first_ok : k
            array.push(o_px, array.get(m_px, src))
            array.push(o_ty, array.get(m_ty, src))
            array.push(o_r, array.get(m_r, src))
    [o_px, o_ty, o_r, first_ok >= 0]

// TP retenus pour le trade : cibles de liquidité, ou un TP unique à rr_ratio en mode « Fixe (R:R) »
// (comportement du R5). ok = false -> pas de cible de liquidité à min_rr_in R : trade abandonné.
f_trade_targets(is_buy, entry, risk) =>
    [t_px, t_ty, t_r, t_ok] = f_select_targets(is_buy, entry, risk)
    fixed = tp_mode_in != "Liquidité"
    if fixed
        array.clear(t_px)
        array.clear(t_ty)
        array.clear(t_r)
        array.push(t_px, entry + (is_buy ? 1 : -1) * risk * rr_ratio)
        array.push(t_ty, "R:R fixe")
        array.push(t_r, rr_ratio)
    [t_px, t_ty, t_r, fixed or t_ok]

// ==========================================
// 4. LOGIQUE CAUSALE ICT 2022 (MACHINE D'ETATS) & ENTREE
// ==========================================
// États de la séquence ICT 2022 :
// IDLE -> SWEEP_ARMED -> MSS_CONFIRMED -> CAUSAL_FVG_CONFIRMED -> WAIT_RETEST -> READY -> RESET
int STATE_IDLE                = 0
int STATE_SWEEP_ARMED         = 1
int STATE_MSS_CONFIRMED       = 2
int STATE_CAUSAL_FVG_CONFIRMED = 3
int STATE_WAIT_RETEST         = 4
int STATE_READY               = 5

// --- Machine d'état BUY (Long) ---
var int   buy_state            = STATE_IDLE
var int   buy_sweep_bar        = na
var float buy_sweep_low        = na
var float buy_mss_level        = na
var int   buy_displacement_bar = na
var float buy_pre_disp_high    = na  // haut de la bougie AVANT le displacement — ancre fixe de la FVG causale
var float buy_fvg_top          = na
var float buy_fvg_bottom       = na
var int   buy_fvg_bar          = na

// --- Machine d'état SELL (Short) ---
var int   sell_state            = STATE_IDLE
var int   sell_sweep_bar        = na
var float sell_sweep_high       = na
var float sell_mss_level        = na
var int   sell_displacement_bar = na
var float sell_pre_disp_low     = na  // bas de la bougie AVANT le displacement — ancre fixe de la FVG causale
var float sell_fvg_top          = na
var float sell_fvg_bottom       = na
var int   sell_fvg_bar          = na

// --- Compteurs de diagnostic (DEBUG) — pour localiser précisément où la séquence perd ses
// candidats. Purement additif, aucun effet sur la logique de trading. À retirer une fois le
// diagnostic terminé.
var int cnt_sweep_l    = 0
var int cnt_sweep_h    = 0
var int cnt_buy_mss    = 0
var int cnt_sell_mss   = 0
var int cnt_buy_fvg    = 0
var int cnt_sell_fvg   = 0
var int cnt_buy_ready  = 0
var int cnt_sell_ready = 0
var int cnt_buy_no_target  = 0 // setups READY abandonnés : aucune cible de liquidité >= min_rr_in
var int cnt_sell_no_target = 0

// Définition quantitative du Displacement (M5) — seuils réglables (diagnostic du 18/09 : ce
// filtre éliminait plus de 90% des sweeps à lui seul, goulot d'étranglement principal du moteur).
// Référence ATR : atr_val[1]
disp_body_ratio = c_range > 0 ? (c_body / c_range) : 0.0
is_disp_quant   = (disp_body_ratio >= disp_body_ratio_min_in) and (c_body >= disp_atr_mult_min_in * atr_val[1])

// Timeouts maximaux (en barres M5) — réglables
MAX_BARS_SWEEP_TO_MSS = sweep_to_mss_window_in
MAX_BARS_FVG_TO_RETEST = fvg_to_retest_window_in

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : BUY
// -------------------------------------------------------------
// 1. Resets / Invalidations BUY
if buy_state != STATE_IDLE
    // Invalidation par nouveau plus bas sous le low du sweep
    if not na(buy_sweep_low) and low < buy_sweep_low
        buy_state := STATE_IDLE
    // Invalidation si sweep opposé (BSL) plus récent
    else if sweep_h
        buy_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if buy_state == STATE_SWEEP_ARMED and (bar_index - buy_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        buy_state := STATE_IDLE
    // Violation FVG causale (clôture sous le bas de la FVG causale avant exécution)
    else if (buy_state == STATE_CAUSAL_FVG_CONFIRMED or buy_state == STATE_WAIT_RETEST) and close < buy_fvg_bottom
        buy_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if buy_state == STATE_WAIT_RETEST and (bar_index - buy_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        buy_state := STATE_IDLE

// 2. Transitions BUY
if buy_state == STATE_IDLE
    // Condition de départ : Sweep de Sell-Side Liquidity (SSL)
    if sweep_l
        buy_state            := STATE_SWEEP_ARMED
        buy_sweep_bar        := bar_index
        buy_sweep_low        := low
        buy_mss_level        := vis_last_ph
        buy_displacement_bar := na
        buy_fvg_top          := na
        buy_fvg_bottom       := na
        buy_fvg_bar          := na
        cnt_sweep_l += 1
else if buy_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_l
        buy_sweep_bar := bar_index
        buy_sweep_low := low
        buy_mss_level := vis_last_ph
    // Recherche du Displacement + MSS haussier cassant buy_mss_level
    else if bar_confirmed and not na(buy_mss_level) and close > buy_mss_level and close > open and is_disp_quant
        buy_state            := STATE_MSS_CONFIRMED
        buy_displacement_bar := bar_index
        buy_pre_disp_high    := high[1] // ancre fixe : haut de la bougie juste avant le displacement
        cnt_buy_mss += 1
else if buy_state == STATE_MSS_CONFIRMED
    // La FVG causale doit se former dans une fenêtre de `causal_fvg_window_in` bougies après le
    // displacement (pas uniquement sur la bougie n+1 — trop fragile au timing exact). L'ancre
    // basse reste la bougie juste avant le displacement (buy_pre_disp_high), fixe quelle que soit
    // la bougie où le gap se referme.
    if bar_confirmed and bar_index >= buy_displacement_bar + 1 and bar_index <= buy_displacement_bar + causal_fvg_window_in
        has_causal_fvg = (low > buy_pre_disp_high) and ((low - buy_pre_disp_high) >= atr_val[1] * 0.15)
        if has_causal_fvg
            buy_fvg_top    := low
            buy_fvg_bottom := buy_pre_disp_high
            buy_fvg_bar    := bar_index
            buy_state      := STATE_CAUSAL_FVG_CONFIRMED
            cnt_buy_fvg += 1
        else if bar_index == buy_displacement_bar + causal_fvg_window_in
            buy_state := STATE_IDLE // Fenêtre épuisée sans FVG causale valide -> Reset
    else if bar_index > buy_displacement_bar + causal_fvg_window_in
        buy_state := STATE_IDLE
else if buy_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    buy_state := STATE_WAIT_RETEST
else if buy_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer en dessous
    if mit_probe_bull <= buy_fvg_top and close >= buy_fvg_bottom
        buy_state := STATE_READY
        cnt_buy_ready += 1

// -------------------------------------------------------------
// ÉVOLUTION MACHINE D'ÉTATS : SELL
// -------------------------------------------------------------
// 1. Resets / Invalidations SELL
if sell_state != STATE_IDLE
    // Invalidation par nouveau plus haut au-dessus du high du sweep
    if not na(sell_sweep_high) and high > sell_sweep_high
        sell_state := STATE_IDLE
    // Invalidation si sweep opposé (SSL) plus récent
    else if sweep_l
        sell_state := STATE_IDLE
    // Timeout Sweep -> MSS (max 12 barres)
    else if sell_state == STATE_SWEEP_ARMED and (bar_index - sell_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
        sell_state := STATE_IDLE
    // Violation FVG causale (clôture au-dessus du haut de la FVG causale avant exécution)
    else if (sell_state == STATE_CAUSAL_FVG_CONFIRMED or sell_state == STATE_WAIT_RETEST) and close > sell_fvg_top
        sell_state := STATE_IDLE
    // Timeout FVG -> Retest (max 20 barres)
    else if sell_state == STATE_WAIT_RETEST and (bar_index - sell_fvg_bar > MAX_BARS_FVG_TO_RETEST)
        sell_state := STATE_IDLE

// 2. Transitions SELL
if sell_state == STATE_IDLE
    // Condition de départ : Sweep de Buy-Side Liquidity (BSL)
    if sweep_h
        sell_state            := STATE_SWEEP_ARMED
        sell_sweep_bar        := bar_index
        sell_sweep_high       := high
        sell_mss_level        := vis_last_pl
        sell_displacement_bar := na
        sell_fvg_top          := na
        sell_fvg_bottom       := na
        sell_fvg_bar          := na
        cnt_sweep_h += 1
else if sell_state == STATE_SWEEP_ARMED
    // Si un nouveau sweep de même direction survient avant MSS : réarmer avec le sweep le plus récent
    if sweep_h
        sell_sweep_bar := bar_index
        sell_sweep_high := high
        sell_mss_level := vis_last_pl
    // Recherche du Displacement + MSS baissier cassant sell_mss_level
    else if bar_confirmed and not na(sell_mss_level) and close < sell_mss_level and close < open and is_disp_quant
        sell_state            := STATE_MSS_CONFIRMED
        sell_displacement_bar := bar_index
        sell_pre_disp_low     := low[1] // ancre fixe : bas de la bougie juste avant le displacement
        cnt_sell_mss += 1
else if sell_state == STATE_MSS_CONFIRMED
    // La FVG causale doit se former dans une fenêtre de `causal_fvg_window_in` bougies après le
    // displacement (pas uniquement sur la bougie n+1). Ancre haute fixe : sell_pre_disp_low.
    if bar_confirmed and bar_index >= sell_displacement_bar + 1 and bar_index <= sell_displacement_bar + causal_fvg_window_in
        has_causal_fvg = (high < sell_pre_disp_low) and ((sell_pre_disp_low - high) >= atr_val[1] * 0.15)
        if has_causal_fvg
            sell_fvg_top    := sell_pre_disp_low
            sell_fvg_bottom := high
            sell_fvg_bar    := bar_index
            sell_state      := STATE_CAUSAL_FVG_CONFIRMED
            cnt_sell_fvg += 1
        else if bar_index == sell_displacement_bar + causal_fvg_window_in
            sell_state := STATE_IDLE // Fenêtre épuisée sans FVG causale valide -> Reset
    else if bar_index > sell_displacement_bar + causal_fvg_window_in
        sell_state := STATE_IDLE
else if sell_state == STATE_CAUSAL_FVG_CONFIRMED
    // Passage formel dans l'attente du retest
    sell_state := STATE_WAIT_RETEST
else if sell_state == STATE_WAIT_RETEST
    // Retest causal : le prix pénètre la FVG causale sans clôturer au-dessus
    if mit_probe_bear >= sell_fvg_bottom and close <= sell_fvg_top
        sell_state := STATE_READY
        cnt_sell_ready += 1

var bool   in_pos       = false
var float  pos_entry    = 0.0
var float  pos_sl       = 0.0
var float  pos_tp       = 0.0
var string pos_dir      = "NONE"
var int    last_sig_bar = 0

cooldown_ok = na(last_sig_bar) or (bar_index - last_sig_bar > cooldown_bars_in)

// Déclencheurs de signal alimentés STRICTEMENT par la séquence causale ICT 2022
// BUY/SELL mutuellement exclusifs à l'exécution
cand_buy  = trade_window and not in_pos and cooldown_ok and bar_confirmed and (buy_state == STATE_READY)
cand_sell = trade_window and not in_pos and cooldown_ok and bar_confirmed and (sell_state == STATE_READY)

raw_buy  = cand_buy and not cand_sell
raw_sell = cand_sell and not cand_buy

calc_score(is_mtf) =>
    score = is_mtf ? 3 : 2
    grade_str = score == 3 ? "A+" : "A"
    stars_str = score == 3 ? "★★★★★" : "★★★★☆"
    [score, grade_str, stars_str]

// ---- ENTREE LONG (remplace l'alert() par un vrai ordre pour le backtest) ----
if raw_buy
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bull)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        b_entry  = close
        // SL Structurel ancré sur le bas du sweep d'origine, plafonné/planché par ATR M5
        b_raw_sl = not na(buy_sweep_low) ? (buy_sweep_low - syminfo.mintick * 10) : (ta.lowest(low, 15) - syminfo.mintick * 10)
        b_risk   = math.max(math.min(b_entry - b_raw_sl, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        [t_px, t_ty, t_r, t_ok] = f_trade_targets(true, b_entry, b_risk)

        if not t_ok
            // Setup valide mais aucune cible de liquidité à min_rr_in R : trade abandonné (identique au Radar R6)
            buy_state := STATE_IDLE
            cnt_buy_no_target += 1
            label.new(bar_index, low - (syminfo.mintick * 5), "✖ sans cible", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        else
            setup_name   = tested_h1_bull ? "MTF FVG BUY" : "ICT 2022 BUY"
            pos_entry    := b_entry
            pos_sl       := b_entry - b_risk
            pos_tp       := array.get(t_px, array.size(t_px) - 1)
            pos_dir      := "BUY"
            in_pos       := true
            last_sig_bar := bar_index

            // Reset de la machine d'état après entrée exécutée
            buy_state := STATE_IDLE

            h1_bull_consumed := true

            lbl_text = stars_txt + " " + setup_name + " · TP " + str.tostring(array.get(t_r, array.size(t_r) - 1), "#.#") + "R"
            label.new(bar_index, low - (syminfo.mintick * 5), lbl_text, color=color.new(color_lux_bull, 80), textcolor=color.black, style=label.style_label_up, size=size.tiny)

            // Sizing par risque fixe : qty calculée pour risquer risk_pct_in% de l'équité
            qty = (strategy.equity * (risk_pct_in / 100)) / b_risk
            strategy.entry("Long", strategy.long, qty=qty, comment=setup_name)
            strategy.exit("Exit Long", "Long", stop=pos_sl, limit=pos_tp)

// ---- ENTREE SHORT (remplace l'alert() par un vrai ordre pour le backtest) ----
if raw_sell
    [score, grade_txt, stars_txt] = calc_score(tested_h1_bear)
    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)

    if grade_ok
        s_entry  = close
        // SL Structurel ancré sur le haut du sweep d'origine, plafonné/planché par ATR M5
        s_raw_sl = not na(sell_sweep_high) ? (sell_sweep_high + syminfo.mintick * 10) : (ta.highest(high, 15) + syminfo.mintick * 10)
        s_risk   = math.max(math.min(s_raw_sl - s_entry, atr_val * atr_cap_mult), atr_val * atr_floor_mult)
        [t_px, t_ty, t_r, t_ok] = f_trade_targets(false, s_entry, s_risk)

        if not t_ok
            // Setup valide mais aucune cible de liquidité à min_rr_in R : trade abandonné (identique au Radar R6)
            sell_state := STATE_IDLE
            cnt_sell_no_target += 1
            label.new(bar_index, high + (syminfo.mintick * 5), "✖ sans cible", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_down, size=size.tiny)
        else
            setup_name   = tested_h1_bear ? "MTF FVG SELL" : "ICT 2022 SELL"
            pos_entry    := s_entry
            pos_sl       := s_entry + s_risk
            pos_tp       := array.get(t_px, array.size(t_px) - 1)
            pos_dir      := "SELL"
            in_pos       := true
            last_sig_bar := bar_index

            // Reset de la machine d'état après entrée exécutée
            sell_state := STATE_IDLE

            h1_bear_consumed := true

            lbl_text = stars_txt + " " + setup_name + " · TP " + str.tostring(array.get(t_r, array.size(t_r) - 1), "#.#") + "R"
            label.new(bar_index, high + (syminfo.mintick * 5), lbl_text, color=color.new(color_lux_bear, 80), textcolor=color.black, style=label.style_label_down, size=size.tiny)

            // Sizing par risque fixe : qty calculée pour risquer risk_pct_in% de l'équité
            qty = (strategy.equity * (risk_pct_in / 100)) / s_risk
            strategy.entry("Short", strategy.short, qty=qty, comment=setup_name)
            strategy.exit("Exit Short", "Short", stop=pos_sl, limit=pos_tp)

// ==========================================
// 5. SORTIES : timeout 30 barres + resynchro de in_pos avec le broker
// ==========================================
if in_pos
    pos_expired = (bar_index - last_sig_bar) >= 30
    if pos_expired
        strategy.close(pos_dir == "BUY" ? "Long" : "Short", comment="EXPIRED")

// Resynchronise notre état interne (in_pos) avec le vrai état du broker emulator
// (que la sortie vienne du TP, du SL ou du timeout ci-dessus).
// BUG CORRIGÉ (revue ChatGPT du 18/09) : strategy.opentrades ne reflète le fill d'un ordre
// qu'à partir de la bougie SUIVANTE (comportement documenté de Pine), pas immédiatement dans
// la même exécution que strategy.entry(). Sans le garde-fou bar_index > last_sig_bar, ce bloc
// repassait in_pos à false dès la bougie d'entrée elle-même — cassant la garde "not in_pos" et
// laissant la machine à états se réarmer ou déclencher un retournement sur une position réelle.
if in_pos and strategy.opentrades == 0 and bar_index > last_sig_bar
    in_pos  := false
    pos_dir := "NONE"

// ==========================================
// 6. TABLEAU DE DIAGNOSTIC (DEBUG) — funnel de la séquence causale sur toute la période testée.
// Purement informatif, à retirer une fois le diagnostic terminé.
// ==========================================
var table dbg = table.new(position.bottom_right, 2, 11, border_color=color.gray, border_width=1, bgcolor=color.new(color.black, 15))
if barstate.islast
    table.cell(dbg, 0, 0, "DIAGNOSTIC SÉQUENCE", text_color=color.yellow, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 0, "", bgcolor=color.new(color.black,15))
    table.cell(dbg, 0, 1, "Sweep SSL (BUY armé)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 1, str.tostring(cnt_sweep_l), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 2, "→ MSS confirmé (BUY)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 2, str.tostring(cnt_buy_mss), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 3, "→ FVG causale (BUY)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 3, str.tostring(cnt_buy_fvg), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 4, "→ READY / entrée (BUY)", text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 4, str.tostring(cnt_buy_ready), text_color=color.lime, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 5, "Sweep BSL (SELL armé)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 5, str.tostring(cnt_sweep_h), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 6, "→ MSS confirmé (SELL)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 6, str.tostring(cnt_sell_mss), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 7, "→ FVG causale (SELL)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 7, str.tostring(cnt_sell_fvg), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 8, "→ READY / entrée (SELL)", text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 8, str.tostring(cnt_sell_ready), text_color=color.lime, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 9, "✖ Abandonné : pas de cible ≥ " + str.tostring(min_rr_in, "#.#") + "R (BUY)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 9, str.tostring(cnt_buy_no_target), text_color=color.gray, text_size=size.small, text_halign=text.align_right)
    table.cell(dbg, 0, 10, "✖ Abandonné : pas de cible ≥ " + str.tostring(min_rr_in, "#.#") + "R (SELL)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dbg, 1, 10, str.tostring(cnt_sell_no_target), text_color=color.gray, text_size=size.small, text_halign=text.align_right)

if h1_bull_consumed and not na(h1_bull_box)
    box.set_extend(h1_bull_box, extend.none)
    box.set_right(h1_bull_box, bar_index)
    h1_bull_box := na

if h1_bear_consumed and not na(h1_bear_box)
    box.set_extend(h1_bear_box, extend.none)
    box.set_right(h1_bear_box, bar_index)
    h1_bear_box := na
