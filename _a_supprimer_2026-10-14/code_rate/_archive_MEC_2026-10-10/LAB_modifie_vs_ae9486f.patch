+            dbg_death_reason := "SL Structurel (high > sweep)"
+        if sell_state == STATE_PENDING_LIMIT
+            strategy.cancel("Short")
+            cnt_sell_limit_cancel += 1
+        sell_state := STATE_IDLE
+    else if sweep_l
+        if sell_state == STATE_SWEEP_ARMED and dbg_death_reason == "PENDING"
+            dbg_death_reason := "Sweep opposé (sweep_l)"
+        if sell_state == STATE_PENDING_LIMIT
+            strategy.cancel("Short")
+            cnt_sell_limit_cancel += 1
+        sell_state := STATE_IDLE
+    else if sell_state == STATE_SWEEP_ARMED and (bar_index - sell_sweep_bar > MAX_BARS_SWEEP_TO_MSS)
+        if dbg_death_reason == "PENDING"
+            dbg_death_reason := "Expiration 18 barres"
+        sell_state := STATE_IDLE
+    else if (sell_state == STATE_CAUSAL_FVG_CONFIRMED) and not na(sell_ob_top) and close > sell_ob_top
+        sell_state := STATE_IDLE
+    else if h1_bear_consumed
+        if sell_state == STATE_SWEEP_ARMED and dbg_death_reason == "PENDING"
+            dbg_death_reason := "H1 POI consommé"
+        if sell_state == STATE_PENDING_LIMIT
+            strategy.cancel("Short")
+            cnt_sell_limit_cancel += 1
+        sell_state := STATE_IDLE
+
+// 2. Transitions SELL
+if sell_state == STATE_IDLE
+    if in_h1_bear_zone
+        sell_state := STATE_IN_POI
+        sell_poi_bar := bar_index
+        cnt_sell_in_poi += 1
+
+if sell_state == STATE_IN_POI
+    if sweep_h
+        sell_state            := STATE_SWEEP_ARMED
+        sell_sweep_bar        := bar_index
+        sell_sweep_high       := high
+        sell_mss_level        := vis_last_pl
+        sell_displacement_bar := na
+        sell_fvg_top          := na
+        sell_fvg_bottom       := na
+        sell_fvg_bar          := na
+        sell_ob_top           := na
+        sell_ob_bot           := na
+        sell_limit_bar        := na
+        cnt_sweep_h += 1
+        
+        dbg_sweep_time := time
+        dbg_sweep_dir := "SELL"
+        dbg_sweep_px := high
+        dbg_sweep_liq := vis_last_ph
+        dbg_mss_55 := vis_last_pl
+        dbg_mss_33 := vis_last_pl_33
+        dbg_mss_22 := vis_last_pl_22
+        dbg_sweep_atr := atr_val[1]
+        dbg_death_reason := "PENDING"
+        dbg_max_reach := low
+        dbg_crossed_55_close := false
+        dbg_crossed_55_nodisp := false
+
+    else if bar_index - sell_poi_bar >= 20 or h1_bear_consumed
+        sell_state := STATE_IDLE
+else if sell_state == STATE_SWEEP_ARMED
+    if dbg_death_reason == "PENDING"
+        dbg_max_reach := math.min(dbg_max_reach, low)
+        if bar_confirmed and not na(sell_mss_level) and close < sell_mss_level
+            dbg_crossed_55_close := true
+            if not (close < open and is_disp_quant)
+                dbg_crossed_55_nodisp := true
+
+    if sweep_h
+        sell_sweep_bar := bar_index
+        sell_sweep_high := high
+        sell_mss_level := vis_last_pl
+        
+        dbg_sweep_time := time
+        dbg_sweep_dir := "SELL"
+        dbg_sweep_px := high
+        dbg_sweep_liq := vis_last_ph
+        dbg_mss_55 := vis_last_pl
+        dbg_mss_33 := vis_last_pl_33
+        dbg_mss_22 := vis_last_pl_22
+        dbg_sweep_atr := atr_val[1]
+        dbg_death_reason := "PENDING"
+        dbg_max_reach := low
+        dbg_crossed_55_close := false
+        dbg_crossed_55_nodisp := false
+
+    else if bar_confirmed and not na(sell_mss_level) and close < sell_mss_level and close < open and is_disp_quant
+        if dbg_death_reason == "PENDING"
+            dbg_death_reason := "SUCCESS (MSS_CONFIRMED)"
+        sell_state            := STATE_MSS_CONFIRMED
+        sell_displacement_bar := bar_index
+        sell_pre_disp_low     := low[1]
+        sell_ob_top           := m5_last_bull_top
+        sell_ob_bot           := m5_last_bull_bot
+        cnt_sell_mss += 1
+else if sell_state == STATE_MSS_CONFIRMED
+    if bar_confirmed and bar_index >= sell_displacement_bar + 1 and bar_index <= sell_displacement_bar + causal_fvg_window_in
+        has_causal_fvg = (high < sell_pre_disp_low) and ((sell_pre_disp_low - high) >= atr_val[1] * 0.15)
+        if has_causal_fvg
+            sell_fvg_top    := sell_pre_disp_low
+            sell_fvg_bottom := high
+            sell_fvg_bar    := bar_index
+            sell_state      := STATE_CAUSAL_FVG_CONFIRMED
+            cnt_sell_fvg += 1
+        else if bar_index == sell_displacement_bar + causal_fvg_window_in
+            sell_state := STATE_IDLE
+    else if bar_index > sell_displacement_bar + causal_fvg_window_in
+        sell_state := STATE_IDLE
+else if sell_state == STATE_CAUSAL_FVG_CONFIRMED
+    sell_ob_mid = sell_ob_bot + (sell_ob_top - sell_ob_bot) * 0.5
+    if not na(h1_bear_zone_bot) and sell_ob_mid <= h1_bear_zone_top and sell_ob_mid >= h1_bear_zone_bot
+        sell_state := STATE_READY
+        cnt_sell_ready += 1
+    else
+        sell_state := STATE_IDLE
+        cnt_sell_ob_rej += 1
+else if sell_state == STATE_PENDING_LIMIT
+    if strategy.opentrades > 0 and strategy.position_size < 0
+        sell_state := STATE_IDLE
+        in_pos := true
+        cnt_sell_limit_filled += 1
+        last_sig_bar := bar_index
+        h1_bear_consumed := true
+    else if bar_index - sell_limit_bar >= 12
+        strategy.cancel("Short")
+        sell_state := STATE_IDLE
+        cnt_sell_expired_limit += 1
+
+if sell_state == STATE_IDLE
+    sell_sweep_high := na
+
+// ---- LAB B7.2 : instrumentation LECTURE SEULE + étiquettes d'ordres ----
+// ra (âge réel) = barres écoulées depuis le PREMIER passage à READY de l'épisode en cours ; fa (âge FVG) = barres
+// écoulées depuis la FVG causale. Détectés après les transitions, lus uniquement par f_lab_tag : aucune condition
+// du moteur ne les utilise.
+var int lab_buy_ready_bar  = na
+var int lab_sell_ready_bar = na
+if buy_state == STATE_READY and buy_state[1] != STATE_READY
+    lab_buy_ready_bar := bar_index
+if sell_state == STATE_READY and sell_state[1] != STATE_READY
+    lab_sell_ready_bar := bar_index
+
+// Abrège le type de la cible finale (PDH / PDL inchangés)
+f_lab_ty(s) =>
+    s == "Pivot M5" ? "PVM5" : s == "Swing H1" ? "SWH1" : s == "Equal highs" ? "EQH" : s == "Equal lows" ? "EQL" : s == "Haut Asie" ? "HAS" : s == "Bas Asie" ? "BAS" : s == "Haut Londres" ? "HLO" : s == "Bas Londres" ? "BLO" : s == "FVG M5" ? "FVM5" : s == "FVG H1" ? "FVH1" : s == "R:R fixe" ? "RRFX" : s
+
+f_lab_age(b0) =>
+    na(b0) ? "-" : str.tostring(bar_index - b0)
+
+// Étiquette d'entrée (sans virgule ni guillemet), champs séparés par | :
+// B72|phase|symbole|route|grade|session|HHmm New York (ouverture de la barre)|s<SL>|t<TP final>|R<R planifié>|type de la cible finale|n<nb de cibles>|k<risque en ATR>|f<âge FVG>|r<âge READY>|bras
+// phase = OPEN, WARMUP ou W1 ; route = MTF (contexte H1 testé) ou ICT ; session = LDN, NY ou OFF ; bras = CONT ou KZ.
+f_lab_tag(is_mtf, grade, sl_px, tp_px, tpr, tpt, ntp, rk, fa_bar, ra_bar) =>
+    ses  = in_london ? "LDN" : (in_ny ? "NY" : "OFF")
+    head = "B72|" + lab_phase + "|" + syminfo.ticker + "|" + (is_mtf ? "MTF" : "ICT") + "|" + grade + "|" + ses + "|" + str.format_time(time, "HHmm", "America/New_York")
+    lvls = "|s" + str.tostring(sl_px, format.mintick) + "|t" + str.tostring(tp_px, format.mintick) + "|R" + str.tostring(tpr, "#.#") + "|" + f_lab_ty(tpt)
+    tail = "|n" + str.tostring(ntp) + "|k" + str.tostring(rk, "#.#") + "|f" + f_lab_age(fa_bar) + "|r" + f_lab_age(ra_bar) + "|" + (is_crypto_247 ? "CONT" : "KZ")
+    head + lvls + tail
+
+
+cooldown_ok = na(last_sig_bar) or (bar_index - last_sig_bar > cooldown_bars_in)
+
+// Déclencheurs de signal alimentés STRICTEMENT par la séquence causale ICT 2022
+// BUY/SELL mutuellement exclusifs à l'exécution
+cand_buy  = trade_window and in_lab_window and not in_pos and cooldown_ok and bar_confirmed and (buy_state == STATE_READY)
+cand_sell = trade_window and in_lab_window and not in_pos and cooldown_ok and bar_confirmed and (sell_state == STATE_READY)
+
+raw_buy  = cand_buy and not cand_sell
+raw_sell = cand_sell and not cand_buy
+
+calc_score(is_mtf) =>
+    score = is_mtf ? 3 : 2
+    grade_str = score == 3 ? "A+" : "A"
+    stars_str = score == 3 ? "★★★★★" : "★★★★☆"
+    [score, grade_str, stars_str]
+
+// ---- ENTREE LONG (remplace l'alert() par un vrai ordre pour le backtest) ----
+if raw_buy
+    [score, grade_txt, stars_txt] = calc_score(tested_h1_bull)
+    grade_ok = (min_grade_in == "B") or (min_grade_in == "A" and score >= 2) or (min_grade_in == "A+" and score == 3)
+
+    if grade_ok
+        b_entry  = buy_ob_bot + (buy_ob_top - buy_ob_bot) * 0.5
+        b_raw_sl = not na(buy_sweep_low) ? (buy_sweep_low - syminfo.mintick * 10) : (ta.lowest(low, 15) - syminfo.mintick * 10)
+        b_risk   = b_entry - b_raw_sl
+        
+        if b_risk > atr_val * atr_cap_mult or b_risk < atr_val * atr_floor_mult
+            buy_state := STATE_IDLE
+            buy_sweep_low := na
+            cnt_buy_sl_invalid += 1
+            label.new(bar_index, low - (syminfo.mintick * 5), "✖ SL ATR (" + str.tostring(b_risk / atr_val, "#.#") + "a)", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_up, size=size.tiny)
+        else
+            [t_px, t_ty, t_r, t_ok] = f_trade_targets(true, b_entry, b_risk)
+            if not t_ok
+                buy_state := STATE_IDLE
+                buy_sweep_low := na
+                cnt_buy_no_target += 1
+                label.new(bar_index, low - (syminfo.mintick * 5), "✖ sans cible", color=color.new(color.gray, 55), textcolor=color.white, style=label.style_label_up, size=size.tiny)
+            else
+                setup_name   = tested_h1_bull ? "MTF FVG BUY" : "ICT 2022 BUY"
