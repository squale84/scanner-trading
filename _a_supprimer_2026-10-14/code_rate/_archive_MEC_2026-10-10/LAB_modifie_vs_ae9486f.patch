+// ==========================================
+grp_radar     = "Configuration Terminal Radar"
+rr_ratio      = input.float(2.0, title="Ratio Risque / Récompense (TP)", minval=1.0, step=0.5, group=grp_radar)
+is_crypto_247 = input.bool(true, title="Mode Métaux / Continu (Ignore Killzones)", group=grp_radar)
+min_grade_in  = input.string("A", title="Grade Minimum pour Alerte", options=["B", "A", "A+"], group=grp_radar)
+ema_flat_thr  = input.float(0.08, title="Seuil Pente EMA H1 (x ATR)", step=0.01, group=grp_radar)
+atr_cap_mult  = input.float(2.5, title="Plafond Stop-Loss (x ATR M5)", minval=0.5, step=0.1, group=grp_radar)
+atr_floor_mult = input.float(0.5, title="Plancher Stop-Loss (x ATR M5)", minval=0.1, step=0.1, group=grp_radar)
+risk_pct_in   = input.float(1.0, title="Risque par trade (% équité)", minval=0.1, step=0.1, group=grp_radar)
+zone_window_in   = input.int(20, title="Fenêtre de validité contexte H1 (barres M5)", minval=5, maxval=50, group=grp_radar)
+cooldown_bars_in = input.int(10, title="Cooldown entre signaux (barres M5)", minval=1, maxval=50, group=grp_radar)
+causal_fvg_window_in = input.int(3, title="Fenêtre de formation FVG causale après displacement (barres M5)", minval=1, maxval=10, group=grp_radar)
+disp_body_ratio_min_in = input.float(0.60, title="Displacement : ratio corps/range minimum", minval=0.3, maxval=0.9, step=0.05, group=grp_radar)
+disp_atr_mult_min_in   = input.float(1.0, title="Displacement : corps minimum (x ATR M5)", minval=0.3, maxval=2.0, step=0.05, group=grp_radar)
+sweep_to_mss_window_in  = input.int(18, title="Fenêtre sweep -> displacement (barres M5)", minval=6, maxval=40, group=grp_radar)
+fvg_to_retest_window_in = input.int(20, title="Fenêtre FVG causale -> retest (barres M5)", minval=5, maxval=50, group=grp_radar)
+fvg_mitigation_mode = input.string("Mèche", title="Mode de mitigation FVG/OB", options=["Mèche", "Corps", "Clôture"], group=grp_radar)
+
+grp_ui        = "Affichage Graphique ICT"
+show_fvg      = input.bool(true, title="Afficher FVG H1", group=grp_ui)
+show_fvg_m5   = input.bool(false, title="Afficher FVG M5", group=grp_ui)
+show_mss      = input.bool(true, title="Afficher CHoCH / BOS", group=grp_ui)
+show_ob       = input.bool(true, title="Afficher Order Blocks (M5)", group=grp_ui)
+show_eqh_eql  = input.bool(true, title="Afficher EQH / EQL (Liquidité)", group=grp_ui)
+show_levels   = input.bool(true, title="Afficher PDH / PDL / NY Midnight", group=grp_ui)
+
+grp_sessions  = "Sessions ICT (Heure New York UTC-4)"
+sess_london   = input.session("0200-0500:23456", title="London Open", group=grp_sessions)
+sess_ny       = input.session("0800-1130:23456", title="NY AM", group=grp_sessions)
+
+in_london    = not na(time(timeframe.period, sess_london, "America/New_York"))
+in_ny        = not na(time(timeframe.period, sess_ny, "America/New_York"))
+trade_window = is_crypto_247 or in_london or in_ny
+
+// ---- LAB B7.2 : fenêtre de dates + échauffement actif (bornes en heure de New York, UTC-4 sur W1) ----
+grp_lab       = "LAB B7.2 (fenêtre, échauffement, étiquettes)"
+lab_win_mode  = input.string("Ouverte (parité B7.1)", title="Fenêtre LAB", options=["Ouverte (parité B7.1)", "W1 (Test 1)"], group=grp_lab)
+lab_start     = input.time(1786939200000, title="Début W1 (heure New York)", group=grp_lab)   // 2026-08-17 00:00 New York (UTC-4) = 2026-08-17 04:00 UTC
+lab_end       = input.time(1789790400000, title="Fin W1, exclue (heure New York)", group=grp_lab)   // 2026-09-19 00:00 New York (UTC-4) = 2026-09-19 04:00 UTC
+lab_warm_days = input.int(7, title="Échauffement actif avant W1 (jours) : trades tagués WARMUP", minval=0, maxval=30, group=grp_lab)
+
+lab_open      = lab_win_mode == "Ouverte (parité B7.1)"
+in_lab_window = lab_open or (time >= lab_start - lab_warm_days * 86400000 and time < lab_end)
+lab_phase     = lab_open ? "OPEN" : (time < lab_start ? "WARMUP" : "W1")
+lab_win_txt   = lab_open ? "OUVERTE" : ("W1 " + str.format_time(lab_start, "MM-dd", "America/New_York") + ">" + str.format_time(lab_end, "MM-dd", "America/New_York") + " WU" + str.tostring(lab_warm_days) + "j")
+
+bgcolor(in_london ? color.new(#00bcd4, 96) : na, title="Bg Londres")
+bgcolor(in_ny ? color.new(#ff9800, 96) : na, title="Bg New York")
+
+// ==========================================
+// THÈME VISUEL
+// ==========================================
+color_lux_bull  = color.new(#00E676, 0)
+color_lux_bear  = color.new(#FF1744, 0)
+color_lux_liq   = color.new(#00E5FF, 0)
+color_lux_level = color.new(#B0BEC5, 30)
+
+// ==========================================
+// 2. EXTRACTION HTF H1 : FVG, BIAIS & BOS
+// ==========================================
+
+type H1Data
+    float bull_top
+    float bull_bot
+    float bear_top
+    float bear_bot
+    float atr
+    float ph
+    float pl
+    int b_sweep
+    int b_mss
+    int b_fvg
+    int b_fvg_exp
+    int b_poi
+    int b_poi_rej
+    int s_sweep
+    int s_mss
+    int s_fvg
+    int s_fvg_exp
+    int s_poi
+    int s_poi_rej
+
+f_get_h1_data() =>
+    h1_atr = ta.atr(14)
+    h1_ph = ta.pivothigh(high, 3, 3)
+    h1_pl = ta.pivotlow(low, 3, 3)
+    
+    var float h1_prev_ph = na
+    var float h1_last_ph = na
+    var float h1_prev_pl = na
+    var float h1_last_pl = na
+    
+    if not na(h1_ph)
+        h1_prev_ph := h1_last_ph
+        h1_last_ph := h1_ph
+    if not na(h1_pl)
+        h1_prev_pl := h1_last_pl
+        h1_last_pl := h1_pl
+        
+    h1_bias_bull = not na(h1_prev_ph) and not na(h1_prev_pl) and (h1_last_ph > h1_prev_ph) and (h1_last_pl > h1_prev_pl)
+    h1_bias_bear = not na(h1_prev_ph) and not na(h1_prev_pl) and (h1_last_ph < h1_prev_ph) and (h1_last_pl < h1_prev_pl)
+
+    h1_c_range = high - low
+    h1_c_body = math.abs(close - open)
+    wick_bot = math.min(open, close) - low
+    wick_top = high - math.max(open, close)
+    rej_buy = h1_c_range > 0 and (wick_bot / h1_c_range) >= 0.35 and close > open
+    rej_sell = h1_c_range > 0 and (wick_top / h1_c_range) >= 0.35 and close < open
+    
+    sweep_l = not na(h1_last_pl) and low < h1_last_pl and close > h1_last_pl and rej_buy
+    sweep_h = not na(h1_last_ph) and high > h1_last_ph and close < h1_last_ph and rej_sell
+    
+    is_disp = h1_c_range > 0 and (h1_c_body / h1_c_range >= 0.5)
+    
+    var int buy_state = 0
+    var float buy_sweep_low = na
+    var float buy_mss_level = na
+    var float buy_ob_top = na
+    var float buy_ob_bot = na
+    var float buy_range_high = na
+    var float buy_poi_top = na
+    var float buy_poi_bot = na
+    
+    var float last_bear_top = na
+    var float last_bear_bot = na
+    
+    
+    var int h1_cnt_buy_sweep = 0
+    var int h1_cnt_buy_mss = 0
+    var int h1_cnt_buy_fvg = 0
+    var int h1_cnt_buy_fvg_exp = 0
+    var int h1_cnt_buy_poi = 0
+    var int h1_cnt_buy_poi_rej = 0
+    
+    var int h1_cnt_sell_sweep = 0
+    var int h1_cnt_sell_mss = 0
+    var int h1_cnt_sell_fvg = 0
+    var int h1_cnt_sell_fvg_exp = 0
+    var int h1_cnt_sell_poi = 0
+    var int h1_cnt_sell_poi_rej = 0
+
+    var int buy_mss_bar = na
+    var int sell_mss_bar = na
+    
+    if close < open
+        last_bear_top := high
+        last_bear_bot := low
+        
+    if buy_state != 0
+        if not na(buy_sweep_low) and low < buy_sweep_low
+            buy_state := 0
+            
+    if buy_state == 0
+        if sweep_l and h1_bias_bull
+            buy_state := 1
+            buy_sweep_low := low
+            h1_cnt_buy_sweep += 1
+            buy_mss_level := h1_last_ph
+            buy_range_high := high
+    else if buy_state == 1
+        buy_range_high := math.max(buy_range_high, high)
+        if close > buy_mss_level and close > open and is_disp
+            buy_state := 2
+            buy_ob_top := last_bear_top
+            buy_ob_bot := last_bear_bot
+            buy_mss_bar := bar_index
+            h1_cnt_buy_mss += 1
+    else if buy_state == 2
+        buy_range_high := math.max(buy_range_high, high)
+        if low > high[2] and (low - high[2]) >= h1_atr * 0.15
+            buy_state := 3
+            h1_cnt_buy_fvg += 1
+        else if not na(buy_mss_bar) and (bar_index - buy_mss_bar) > 3
+            buy_state := 0
+            h1_cnt_buy_fvg_exp += 1 // Expiration FVG causale H1 (3 bougies)
+    else if buy_state == 3
+        buy_range_high := math.max(buy_range_high, high)
+        eq = buy_sweep_low + (buy_range_high - buy_sweep_low) * 0.5
+        
+        poi_top = math.min(buy_ob_top, eq)
+        poi_bot = buy_ob_bot
+        
+        if buy_ob_bot < eq
+            if poi_top >= poi_bot
+                buy_poi_top := poi_top
+                buy_poi_bot := poi_bot
+                buy_state := 4
+                h1_cnt_buy_poi += 1
+            else
+                buy_state := 0
+                h1_cnt_buy_poi_rej += 1
+        else
+            buy_state := 0
+            h1_cnt_buy_poi_rej += 1
+    else if buy_state == 4
+        if close < buy_ob_bot
+            buy_state := 0
+            
+    var int sell_state = 0
+    var float sell_sweep_high = na
+    var float sell_mss_level = na
+    var float sell_ob_top = na
+    var float sell_ob_bot = na
+    var float sell_range_low = na
+    var float sell_poi_top = na
+    var float sell_poi_bot = na
+    
+    var float last_bull_top = na
+    var float last_bull_bot = na
+    
+    if close > open
+        last_bull_top := high
+        last_bull_bot := low
+        
+    if sell_state != 0
+        if not na(sell_sweep_high) and high > sell_sweep_high
+            sell_state := 0
+            
+    if sell_state == 0
+        if sweep_h and h1_bias_bear
+            sell_state := 1
+            sell_sweep_high := high
+            h1_cnt_sell_sweep += 1
+            sell_mss_level := h1_last_pl
+            sell_range_low := low
+    else if sell_state == 1
+        sell_range_low := math.min(sell_range_low, low)
+        if close < sell_mss_level and close < open and is_disp
+            sell_state := 2
+            sell_ob_top := last_bull_top
+            sell_ob_bot := last_bull_bot
+            sell_mss_bar := bar_index
+            h1_cnt_sell_mss += 1
+    else if sell_state == 2
+        sell_range_low := math.min(sell_range_low, low)
+        if high < low[2] and (low[2] - high) >= h1_atr * 0.15
+            sell_state := 3
+            h1_cnt_sell_fvg += 1
+        else if not na(sell_mss_bar) and (bar_index - sell_mss_bar) > 3
+            sell_state := 0
+            h1_cnt_sell_fvg_exp += 1 // Expiration FVG causale H1 (3 bougies)
+    else if sell_state == 3
+        sell_range_low := math.min(sell_range_low, low)
+        eq = sell_sweep_high - (sell_sweep_high - sell_range_low) * 0.5
+        
+        poi_bot = math.max(sell_ob_bot, eq)
+        poi_top = sell_ob_top
+        
+        if sell_ob_top > eq
+            if poi_top >= poi_bot
+                sell_poi_top := poi_top
+                sell_poi_bot := poi_bot
+                sell_state := 4
+                h1_cnt_sell_poi += 1
+            else
+                sell_state := 0
+                h1_cnt_sell_poi_rej += 1
+        else
+            sell_state := 0
+            h1_cnt_sell_poi_rej += 1
+    else if sell_state == 4
+        if close > sell_ob_top
+            sell_state := 0
+
+    h1_poi_bull_top = buy_state == 4 ? buy_poi_top : na
+    h1_poi_bull_bot = buy_state == 4 ? buy_poi_bot : na
+    h1_poi_bear_top = sell_state == 4 ? sell_poi_top : na
+    h1_poi_bear_bot = sell_state == 4 ? sell_poi_bot : na
+
+    H1Data.new(h1_poi_bull_top, h1_poi_bull_bot, h1_poi_bear_top, h1_poi_bear_bot, h1_atr[1], h1_ph[1], h1_pl[1], h1_cnt_buy_sweep, h1_cnt_buy_mss, h1_cnt_buy_fvg, h1_cnt_buy_fvg_exp, h1_cnt_buy_poi, h1_cnt_buy_poi_rej, h1_cnt_sell_sweep, h1_cnt_sell_mss, h1_cnt_sell_fvg, h1_cnt_sell_fvg_exp, h1_cnt_sell_poi, h1_cnt_sell_poi_rej)
+
+h1_data_obj = request.security(syminfo.tickerid, "60", f_get_h1_data(), barmerge.gaps_off, barmerge.lookahead_off)
+h1_poi_bull_top = na(h1_data_obj) ? na : h1_data_obj.bull_top
+h1_poi_bull_bot = na(h1_data_obj) ? na : h1_data_obj.bull_bot
+h1_poi_bear_top = na(h1_data_obj) ? na : h1_data_obj.bear_top
+h1_poi_bear_bot = na(h1_data_obj) ? na : h1_data_obj.bear_bot
+h1_atr = na(h1_data_obj) ? na : h1_data_obj.atr
+h1_ph = na(h1_data_obj) ? na : h1_data_obj.ph
+h1_pl = na(h1_data_obj) ? na : h1_data_obj.pl
+h1_cnt_buy_sweep = na(h1_data_obj) ? 0 : h1_data_obj.b_sweep
+h1_cnt_buy_mss = na(h1_data_obj) ? 0 : h1_data_obj.b_mss
+h1_cnt_buy_fvg = na(h1_data_obj) ? 0 : h1_data_obj.b_fvg
+h1_cnt_buy_fvg_exp = na(h1_data_obj) ? 0 : h1_data_obj.b_fvg_exp
+h1_cnt_buy_poi = na(h1_data_obj) ? 0 : h1_data_obj.b_poi
+h1_cnt_buy_poi_rej = na(h1_data_obj) ? 0 : h1_data_obj.b_poi_rej
+h1_cnt_sell_sweep = na(h1_data_obj) ? 0 : h1_data_obj.s_sweep
+h1_cnt_sell_mss = na(h1_data_obj) ? 0 : h1_data_obj.s_mss
+h1_cnt_sell_fvg = na(h1_data_obj) ? 0 : h1_data_obj.s_fvg
+h1_cnt_sell_fvg_exp = na(h1_data_obj) ? 0 : h1_data_obj.s_fvg_exp
+h1_cnt_sell_poi = na(h1_data_obj) ? 0 : h1_data_obj.s_poi
+h1_cnt_sell_poi_rej = na(h1_data_obj) ? 0 : h1_data_obj.s_poi_rej
+
+
+
+var float h1_bull_zone_top = na
+var float h1_bull_zone_bot = na
+var bool  h1_bull_consumed = false
+var box   h1_bull_box      = na
+
+var float h1_bear_zone_top = na
+var float h1_bear_zone_bot = na
+var bool  h1_bear_consumed = false
+var box   h1_bear_box      = na
+
+color_fvg_hl = color.new(#FFFF00, 80)
+color_fvg_bd = color.new(#FFFF00, 30)
+
+if ta.change(time("60"))
+    if not na(h1_poi_bull_top)
+        is_new_poi = na(h1_bull_zone_top) or (h1_poi_bull_top != h1_bull_zone_top)
+        if is_new_poi
+            if not na(h1_bull_box)
+                box.set_extend(h1_bull_box, extend.none)
+                box.set_right(h1_bull_box, bar_index)
+            h1_bull_zone_top := h1_poi_bull_top
+            h1_bull_zone_bot := h1_poi_bull_bot
+            h1_bull_consumed := false
+            if show_fvg
+                h1_bull_box := box.new(bar_index, h1_bull_zone_top, bar_index + 1, h1_bull_zone_bot, border_color=color_fvg_bd, bgcolor=color_fvg_hl, extend=extend.right)
+
+    if not na(h1_poi_bear_top)
+        is_new_poi = na(h1_bear_zone_top) or (h1_poi_bear_top != h1_bear_zone_top)
+        if is_new_poi
+            if not na(h1_bear_box)
+                box.set_extend(h1_bear_box, extend.none)
+                box.set_right(h1_bear_box, bar_index)
+            h1_bear_zone_top := h1_poi_bear_top
+            h1_bear_zone_bot := h1_poi_bear_bot
+            h1_bear_consumed := false
+            if show_fvg
+                h1_bear_box := box.new(bar_index, h1_bear_zone_top, bar_index + 1, h1_bear_zone_bot, border_color=color_fvg_bd, bgcolor=color_fvg_hl, extend=extend.right)
+
+in_h1_bull_zone = not h1_bull_consumed and not na(h1_bull_zone_top) and (high >= h1_bull_zone_bot and low <= h1_bull_zone_top)
+in_h1_bear_zone = not h1_bear_consumed and not na(h1_bear_zone_top) and (high >= h1_bear_zone_bot and low <= h1_bear_zone_top)
+
+if in_h1_bull_zone and close < h1_bull_zone_bot
+    h1_bull_consumed := true
+if in_h1_bear_zone and close > h1_bear_zone_top
+    h1_bear_consumed := true
+
+// ==========================================
+// 2.5 NIVEAUX MAJEURS (PDH, PDL, NY MIDNIGHT)
+// ==========================================
+var float pdh = na
+var float pdl = na
+var int   pdh_bar = na
+var int   pdl_bar = na
+var float current_dh = na
+var float current_dl = na
+var int   current_dh_bar = na
+var int   current_dl_bar = na
+
+// Alignement sur le Radar (PATCH 1) : "America/New_York" était passé en paramètre `session`,
+// pas `timezone` -> la journée ne commençait pas à minuit New York. Même PDH / PDL que le Radar.
+is_new_ny_day = ta.change(time("D", "", "America/New_York"))
+
+if is_new_ny_day
+    pdh := current_dh
+    pdl := current_dl
+    pdh_bar := current_dh_bar
+    pdl_bar := current_dl_bar
+    current_dh := high
+    current_dl := low
+    current_dh_bar := bar_index
+    current_dl_bar := bar_index
+else
+    if high > current_dh
+        current_dh := high
+        current_dh_bar := bar_index
+    if low < current_dl
+        current_dl := low
+        current_dl_bar := bar_index
+
+var float midnight_open = na
+if is_new_ny_day
+    midnight_open := open
+
+if is_new_ny_day and show_levels
+    if not na(pdh)
+        line.new(pdh_bar, pdh, bar_index + 288, pdh, color=color_lux_level, width=1, style=line.style_dotted)
+        label.new(bar_index + 5, pdh, "PDH", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.small)
+    if not na(pdl)
+        line.new(pdl_bar, pdl, bar_index + 288, pdl, color=color_lux_level, width=1, style=line.style_dotted)
+        label.new(bar_index + 5, pdl, "PDL", color=color.new(color.white, 100), textcolor=color_lux_level, style=label.style_none, size=size.small)
+
+if is_new_ny_day and show_levels
+    line.new(bar_index, open, bar_index + 288, open, color=color.new(#FFD600, 20), width=1, style=line.style_dashed)
+    label.new(bar_index + 5, open, "NY Open", color=color.new(color.white, 100), textcolor=color.new(#FFD600, 0), style=label.style_none, size=size.small)
+
+// ==========================================
+// 3. STRUCTURE M5 & CONFIRMATION DE REJET
+// ==========================================
+
+var float m5_last_bear_top = na
+var float m5_last_bear_bot = na
+var float m5_last_bull_top = na
+var float m5_last_bull_bot = na
+
+if close < open
+    m5_last_bear_top := high
+    m5_last_bear_bot := low
+if close > open
+    m5_last_bull_top := high
+    m5_last_bull_bot := low
+
+atr_val       = ta.atr(14)
+bar_confirmed = barstate.isconfirmed
+
+// --- Sonde de mitigation (Mèche/Corps/Clôture) — doit rester identique à scanner_mtf.pine pour que les deux scripts restent synchronisés ---
+mit_probe_bull = fvg_mitigation_mode == "Mèche" ? low : fvg_mitigation_mode == "Corps" ? math.min(open, close) : close
+mit_probe_bear = fvg_mitigation_mode == "Mèche" ? high : fvg_mitigation_mode == "Corps" ? math.max(open, close) : close
+
+ph = ta.pivothigh(high, 5, 5)
+pl = ta.pivotlow(low, 5, 5)
+
+var float last_ph     = na
+var int   last_ph_bar = na
+var float prev_ph     = na
+var int   prev_ph_bar = na
+var float lowest_since_ph = na
+var float ob_bull_top = na
+var float ob_bull_bot = na
+var int   ob_bull_bar = na
+
+if not na(ph)
+    prev_ph := last_ph
+    prev_ph_bar := last_ph_bar
+    last_ph := ph
+    last_ph_bar := bar_index - 5
+    ob_bull_bot := low
+    ob_bull_top := high
+    ob_bull_bar := bar_index
+    lowest_since_ph := low
+
